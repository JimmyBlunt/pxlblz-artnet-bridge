index 00000000..44cab100
--- /dev/null
+++ b/src/store/fastledCatalogStore.ts
@@ -0,0 +1,72 @@
+// The FastLED example catalogue as application state: loaded once, lazily
+// (the Patterns rail asks for it when it mounts; opening an example or a deep
+// link waits for it). Registers each example's recommended preview settings so
+// an example opens at its own LED count, like a stock demo's recommendation.
+import { create } from 'zustand'
+import {
+  fastLedExampleIdFromKey,
+  fastLedExampleKey,
+  fastLedExampleRecommendedSettings,
+  isFastLedExampleKey,
+  type FastLedCatalog,
+  type FastLedCatalogExample,
+} from '@/engine/fastled/fastledCatalog'
+import { registerRecommendedSettings } from '@/pixelblaze/stock/patterns'
+
+export type FastLedCatalogStatus = 'idle' | 'loading' | 'ready' | 'error'
+
+interface FastLedCatalogState {
+  status: FastLedCatalogStatus
+  catalog: FastLedCatalog | null
+  error: string | null
+  load: () => Promise<FastLedCatalog | null>
+}
+
+let pending: Promise<FastLedCatalog | null> | null = null
+// Test seam: replaced in tests to avoid the real (large) catalogue chunk.
+let loader: () => Promise<FastLedCatalog> = async () => (await import('@/engine/fastled/fastledCatalogLoader')).loadFastLedCatalog()
+
+export function __setFastLedCatalogLoaderForTests(next: (() => Promise<FastLedCatalog>) | null): void {
+  loader = next ?? (async () => (await import('@/engine/fastled/fastledCatalogLoader')).loadFastLedCatalog())
+  pending = null
+  useFastLedCatalogStore.setState({ status: 'idle', catalog: null, error: null })
+}
+
+export const useFastLedCatalogStore = create<FastLedCatalogState>()((set, get) => ({
+  status: 'idle',
+  catalog: null,
+  error: null,
+  load: () => {
+    const { catalog } = get()
+    if (catalog) return Promise.resolve(catalog)
+    if (pending) return pending
+    set({ status: 'loading', error: null })
+    pending = loader().then(
+      (loaded) => {
+        for (const example of loaded.examples) {
+          registerRecommendedSettings(fastLedExampleKey(example.id), fastLedExampleRecommendedSettings(example))
+        }
+        set({ status: 'ready', catalog: loaded })
+        return loaded
+      },
+      (err: unknown) => {
+        pending = null
+        set({ status: 'error', error: err instanceof Error ? err.message : String(err) })
+        return null
+      },
+    )
+    return pending
+  },
+}))
+
+/** The catalogue entry behind a `fastled:<id>` built-in key, if loaded. */
+export function fastLedExampleForKey(name: string | null | undefined): FastLedCatalogExample | undefined {
+  if (!isFastLedExampleKey(name)) return undefined
+  const id = fastLedExampleIdFromKey(name)
+  return useFastLedCatalogStore.getState().catalog?.examples.find((e) => e.id === id)
+}
+
+/** Display name for a built-in key: the example title for `fastled:<id>`, else the key. */
+export function builtInPatternTitle(name: string): string {
+  return fastLedExampleForKey(name)?.title ?? (isFastLedExampleKey(name) ? fastLedExampleIdFromKey(name) : name)
+}

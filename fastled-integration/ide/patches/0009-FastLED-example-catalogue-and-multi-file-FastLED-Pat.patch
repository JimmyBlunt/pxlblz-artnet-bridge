+// Re-imports the FastLED example catalogue into PXLBLZ-IDE (regenerated output,
+// never hand-edited):
+//
+//   node scripts/sync-fastled-catalog.mjs [<catalog dir>]
+//
+// <catalog dir> is the engine's catalog/ folder (fastled-examples.json +
+// examples/<id>/...), default ../fastled-work/catalog next to this checkout, or
+// FASTLED_CATALOG. Copies, into src/engine/fastled/catalog/:
+//   fastled-examples.json         the catalogue as is (validated: schemaVersion 1, ids, main files)
+//   examples/<id>/<path>          every file with compile: true, byte-identical (sha256 checked)
+//   LICENSE.FastLED               FastLED's MIT license
+// and deletes vendored files that are no longer in the catalogue. The IDE loads
+// all of it lazily (fastledCatalogLoader.ts), so the main bundle does not grow.
+import crypto from 'node:crypto'
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const repo = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const from = path.resolve(process.argv[2] || process.env.FASTLED_CATALOG || path.join(repo, '..', 'fastled-work', 'catalog'))
+const to = path.join(repo, 'src', 'engine', 'fastled', 'catalog')
+
+const fail = (msg) => {
+  console.error(`sync-fastled-catalog: ${msg}`)
+  process.exit(1)
+}
+
+const indexFile = path.join(from, 'fastled-examples.json')
+if (!fs.existsSync(indexFile)) fail(`${indexFile} not found`)
+const raw = fs.readFileSync(indexFile)
+const catalog = JSON.parse(raw.toString('utf8'))
+if (catalog.schemaVersion !== 1) fail(`unsupported schemaVersion ${catalog.schemaVersion}`)
+if (!Array.isArray(catalog.examples)) fail('examples missing')
+
+// Same path rule as the IDE (fastledFiles.ts) and the compile service.
+const SEGMENT = '[A-Za-z0-9_][A-Za-z0-9_.+-]*'
+const PATH_RE = new RegExp(`^(?:${SEGMENT}/)*${SEGMENT}\\.(?:h|hh|hpp|hxx|inc|ipp|tpp|c|cc|cpp|cxx|ino|pde|json|txt|csv)$`)
+const ID_RE = /^[A-Za-z0-9_][A-Za-z0-9_.+-]*$/
+
+const wanted = new Map() // relative vendored path -> source path
+const ids = new Set()
+let bytes = 0
+for (const ex of catalog.examples) {
+  if (!ID_RE.test(ex.id ?? '')) fail(`invalid id ${JSON.stringify(ex.id)}`)
+  if (ids.has(ex.id)) fail(`duplicate id ${ex.id}`)
+  ids.add(ex.id)
+  if (!ex.files?.some((f) => f.path === ex.mainFile)) fail(`${ex.id}: main file ${ex.mainFile} not in files`)
+  for (const f of ex.files) {
+    if (!f.compile) continue
+    if (!PATH_RE.test(f.path) || f.path.split('/').some((s) => s === '..')) fail(`${ex.id}: unsupported path ${f.path}`)
+    const src = path.join(from, 'examples', ex.id, ...f.path.split('/'))
+    if (!fs.existsSync(src)) fail(`${ex.id}: ${f.path} missing in ${from}`)
+    const data = fs.readFileSync(src)
+    const sha = crypto.createHash('sha256').update(data).digest('hex')
+    if (f.sha256 && sha !== f.sha256) fail(`${ex.id}: ${f.path} sha256 mismatch (catalog ${f.sha256}, file ${sha})`)
+    bytes += data.length
+    wanted.set(['examples', ex.id, ...f.path.split('/')].join('/'), src)
+  }
+}
+
+fs.mkdirSync(to, { recursive: true })
+let written = 0
+for (const [rel, src] of wanted) {
+  const dst = path.join(to, ...rel.split('/'))
+  fs.mkdirSync(path.dirname(dst), { recursive: true })
+  const data = fs.readFileSync(src)
+  if (!fs.existsSync(dst) || !fs.readFileSync(dst).equals(data)) {
+    fs.writeFileSync(dst, data)
+    written += 1
+  }
+}
+
+// Remove vendored example files the catalogue no longer lists.
+let removed = 0
+const walk = (dir, rel) => {
+  if (!fs.existsSync(dir)) return
+  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+    const childRel = rel ? `${rel}/${entry.name}` : entry.name
+    const child = path.join(dir, entry.name)
+    if (entry.isDirectory()) {
+      walk(child, childRel)
+      if (fs.readdirSync(child).length === 0) fs.rmdirSync(child)
+    } else if (!wanted.has(childRel)) {
+      fs.rmSync(child)
+      removed += 1
+    }
+  }
+}
+walk(path.join(to, 'examples'), 'examples')
+
+fs.writeFileSync(path.join(to, 'fastled-examples.json'), raw)
+const license = path.join(from, 'LICENSE.FastLED')
+if (fs.existsSync(license)) fs.copyFileSync(license, path.join(to, 'LICENSE.FastLED'))
+
+const s = catalog.summary ?? {}
+console.log(`FastLED catalogue: ${catalog.examples.length} examples (FastLED ${catalog.fastled?.version} @ ${String(catalog.fastled?.commit).slice(0, 10)}), `
+  + `${wanted.size} files / ${(bytes / 1024).toFixed(0)} KiB vendored (${written} written, ${removed} removed); `
+  + `compile ok ${s.compileOk ?? '?'}, platform pc ${s.platform?.pc ?? '?'} / hardware ${s.platform?.hardware ?? '?'}`)

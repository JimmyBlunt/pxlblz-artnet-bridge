+        {"crossval float ops",              test_crossval_float_ops},
+        // Pipeline / Chained Operation Tests
+        {"pipeline u8 scale+add+clamp",    test_u8_pipeline_scale_add_clamp},
+        {"pipeline i32 shift+add+mask",    test_i32_pipeline_shift_add_mask},

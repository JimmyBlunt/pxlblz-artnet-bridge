diff --git a/src/components/FastLedFileTabs.tsx b/src/components/FastLedFileTabs.tsx
new file mode 100644
index 00000000..9183e986
--- /dev/null
+++ b/src/components/FastLedFileTabs.tsx
@@ -0,0 +1,184 @@
+// File switcher of a FastLED Pattern (sketch + supporting .h/.cpp/.ino files)
+// and the banner of a read-only FastLED catalogue example. Thin: the file model
+// lives in engine/fastled/fastledFiles.ts, the Editor owns the buffer.
+import { useState, type KeyboardEvent } from 'react'
+import { Plus, X } from 'lucide-react'
+import { fastLedFilePathError } from '@/engine/fastled/fastledFiles'
+import { fastLedExampleNotice, type FastLedCatalogExample } from '@/engine/fastled/fastledCatalog'
+
+export interface FastLedFileTab {
+  /** null = the sketch (main file). */
+  path: string | null
+  label: string
+  errors: number
+  warnings: number
+}
+
+function NameInput({ initial, existing, onCommit, onCancel, label }: {
+  initial: string
+  existing: string[]
+  onCommit: (name: string) => void
+  onCancel: () => void
+  label: string
+}) {
+  const [value, setValue] = useState(initial)
+  const error = value === initial && initial !== '' ? null : fastLedFilePathError(value.trim(), existing)
+  const onKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === 'Escape') {
+      event.preventDefault()
+      onCancel()
+    } else if (event.key === 'Enter') {
+      event.preventDefault()
+      if (value.trim() === initial) onCancel()
+      else if (!error) onCommit(value.trim())
+    }
+  }
+  return (
+    <span className="flex shrink-0 items-center gap-1">
+      <input
+        autoFocus
+        aria-label={label}
+        aria-invalid={error !== null}
+        value={value}
+        placeholder="Palette.h"
+        onChange={(event) => setValue(event.target.value)}
+        onKeyDown={onKeyDown}
+        onBlur={onCancel}
+        className={`h-5 w-40 border bg-zinc-950 px-1 font-mono text-[11px] text-zinc-100 outline-none ${error && value !== '' ? 'border-red-500/70' : 'border-zinc-700 focus:border-live'}`}
+      />
+      {error && value !== '' && <span role="alert" className="max-w-[18rem] truncate text-[10px] text-red-300" title={error}>{error}</span>}
+    </span>
+  )
+}
+
+export function FastLedFileTabs({
+  tabs,
+  activePath,
+  readOnly,
+  onSelect,
+  onAdd,
+  onRename,
+  onRemove,
+}: {
+  tabs: FastLedFileTab[]
+  activePath: string | null
+  readOnly: boolean
+  onSelect: (path: string | null) => void
+  onAdd: (path: string) => void
+  onRename: (from: string, to: string) => void
+  onRemove: (path: string) => void
+}) {
+  const [adding, setAdding] = useState(false)
+  const [renaming, setRenaming] = useState<string | null>(null)
+  const existing = tabs.flatMap((t) => (t.path === null ? [] : [t.path]))
+  return (
+    <div
+      role="tablist"
+      aria-label="FastLED Pattern files"
+      data-testid="fastled-file-tabs"
+      className="flex shrink-0 items-center gap-px overflow-x-auto border-b border-zinc-800 bg-zinc-950 px-1 font-mono text-[11px]"
+    >
+      {tabs.map((tab) => {
+        const active = tab.path === activePath
+        if (tab.path !== null && renaming === tab.path) {
+          return (
+            <NameInput
+              key={`rename-${tab.path}`}
+              label={`Rename ${tab.path}`}
+              initial={tab.path}
+              existing={existing.filter((p) => p !== tab.path)}
+              onCommit={(name) => {
+                setRenaming(null)
+                onRename(tab.path!, name)
+              }}
+              onCancel={() => setRenaming(null)}
+            />
+          )
+        }
+        return (
+          <span key={tab.path ?? '\u0000main'} className={`group flex shrink-0 items-center ${active ? 'bg-zinc-900 text-live' : 'text-zinc-400 hover:bg-zinc-900/60 hover:text-zinc-200'}`}>
+            <button
+              type="button"
+              role="tab"
+              aria-selected={active}
+              data-file={tab.path ?? ''}
+              title={tab.path === null ? `${tab.label} (sketch)` : readOnly ? tab.label : `${tab.label} (double-click to rename)`}
+              onClick={() => onSelect(tab.path)}
+              onDoubleClick={() => { if (!readOnly && tab.path !== null) setRenaming(tab.path) }}
+              className="flex h-6 items-center gap-1 px-2"
+            >
+              <span className="whitespace-nowrap">{tab.label}</span>
+              {tab.errors > 0 && <span aria-label={`${tab.errors} errors`} className="rounded-sm bg-red-500/20 px-1 text-[9px] text-red-300">{tab.errors}</span>}
+              {tab.errors === 0 && tab.warnings > 0 && <span aria-label={`${tab.warnings} warnings`} className="rounded-sm bg-amber-500/20 px-1 text-[9px] text-amber-300">{tab.warnings}</span>}
+            </button>
+            {!readOnly && tab.path !== null && active && (
+              <button
+                type="button"
+                aria-label={`Remove ${tab.path}`}
+                title={`Remove ${tab.path}`}
+                onClick={() => onRemove(tab.path!)}
+                className="mr-1 grid size-4 place-items-center text-zinc-500 hover:text-red-300"
+              >
+                <X size={11} aria-hidden />
+              </button>
+            )}
+          </span>
+        )
+      })}
+      {!readOnly && (adding ? (
+        <NameInput
+          label="New file name"
+          initial=""
+          existing={existing}
+          onCommit={(name) => {
+            setAdding(false)
+            onAdd(name)
+          }}
+          onCancel={() => setAdding(false)}
+        />
+      ) : (
+        <button
+          type="button"
+          aria-label="Add file"
+          title="Add a supporting file (.h, .cpp, .ino)"
+          onClick={() => setAdding(true)}
+          className="ml-1 flex h-6 shrink-0 items-center gap-1 px-1.5 text-zinc-500 hover:text-live"
+        >
+          <Plus size={12} aria-hidden />
+          <span>File</span>
+        </button>
+      ))}
+    </div>
+  )
+}
+
+export function FastLedExampleBanner({ example, canClone }: { example: FastLedCatalogExample; canClone: boolean }) {
+  const notice = fastLedExampleNotice(example)
+  const toneClass = notice.tone === 'hardware'
+    ? 'border-amber-500/40 text-amber-200'
+    : notice.tone === 'warning'
+      ? 'border-red-500/40 text-red-200'
+      : 'border-zinc-700 text-zinc-300'
+  return (
+    <div
+      role="note"
+      data-testid="fastled-example-banner"
+      data-platform={example.platform}
+      className={`flex shrink-0 flex-wrap items-center gap-x-3 gap-y-0.5 border-b border-l-2 bg-zinc-900 px-3 py-1.5 font-mono text-[11px] ${toneClass}`}
+    >
+      <span className="shrink-0 uppercase tracking-[0.12em] text-zinc-400">
+        FastLED example{example.platform === 'hardware' ? ' · Hardware' : ''} · read-only
+      </span>
+      {notice.text && <span className="min-w-0 flex-1">{notice.text}</span>}
+      <span className="shrink-0 text-zinc-500">
+        {canClone ? 'Clone to edit a copy' : 'Sign in to clone and edit'}
+        {example.upstreamUrl && (
+          <>
+            {' · '}
+            <a href={example.upstreamUrl} target="_blank" rel="noreferrer" className="hover:text-live hover:underline">upstream</a>
+          </>
+        )}
+      </span>
+    </div>
+  )
+}

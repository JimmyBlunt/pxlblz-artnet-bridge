+export async function openFastLedExample(key: string, options: { rememberLastActive?: boolean } = {}): Promise<boolean> {
+  const seq = ++fastLedOpenSeq
+  const before = usePatternStore.getState()
+  const startedFrom = [before.activePatternId, before.activeDemoName, before.activeLibraryName].join('|')
+  const catalog = await useFastLedCatalogStore.getState().load()

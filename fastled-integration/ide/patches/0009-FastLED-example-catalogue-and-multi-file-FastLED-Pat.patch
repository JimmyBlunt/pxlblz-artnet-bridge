+++ b/src/engine/fastled/catalog/examples/XYPath/src/wave.h
@@ -0,0 +1,33 @@
+
+
+#pragma once
+
+#include "fl/fx/2d/blend.h"
+#include "fl/fx/2d/wave.h"
+#include "fl/fx/fx2d.h"
+#include "fl/gfx/raster.h"
+
+
+struct WaveEffect {
+    fl::WaveFxPtr wave_fx_low;
+    fl::WaveFxPtr wave_fx_high;
+    fl::Blend2dPtr blend_stack;
+    void draw(fl::Fx::DrawContext context) { blend_stack->draw(context); }
+    void addf(size_t x, size_t y, float value) {
+        wave_fx_low->addf(x, y, value);
+        wave_fx_high->addf(x, y, value);
+    }
+};
+
+struct DrawRasterToWaveSimulator {
+    DrawRasterToWaveSimulator(WaveEffect* wave_fx) : mWaveFx(wave_fx) {}
+    void draw(const fl::vec2<int> &pt, uint32_t /*index*/, uint8_t value) {
+        float valuef = value / 255.0f;
+        int xx = pt.x;
+        int yy = pt.y;
+        mWaveFx->addf(xx, yy, valuef);
+    }
+    WaveEffect* mWaveFx;
+};
+
+WaveEffect NewWaveSimulation2D(const fl::XYMap& xymap);
diff --git a/src/engine/fastled/catalog/examples/XYPath/src/xypaths.cpp b/src/engine/fastled/catalog/examples/XYPath/src/xypaths.cpp
new file mode 100644
index 00000000..d5dfafd3
--- /dev/null
+++ b/src/engine/fastled/catalog/examples/XYPath/src/xypaths.cpp
@@ -0,0 +1,40 @@
+
+
+#include "fl/gfx/xypath.h"
+#include "fl/stl/vector.h"
+#include "fl/math/math.h"
+
+
+#include "xypaths.h"
+
+
+namespace {
+    fl::shared_ptr<fl::CatmullRomParams> make_path(int width, int height) {
+        // make a triangle.
+        fl::shared_ptr<fl::CatmullRomParams> params = fl::make_shared<fl::CatmullRomParams>();
+        fl::vector_inlined<fl::vec2f, 5> points;
+        points.push_back(fl::vec2f(0.0f, 0.0f));
+        points.push_back(fl::vec2f(width / 3, height / 2));
+        points.push_back(fl::vec2f(width - 3, height - 1));
+        points.push_back(fl::vec2f(0.0f, height - 1));
+        points.push_back(fl::vec2f(0.0f, 0.0f));
+        for (auto &p : points) {
+            p.x = fl::map_range<float, float>(p.x, 0.0f, width - 1, -1.0f, 1.0f);
+            p.y = fl::map_range<float, float>(p.y, 0.0f, height - 1, -1.0f, 1.0f);
+            params->addPoint(p);
+        }
+        return params;
+    }
+}
+
+fl::vector<fl::XYPathPtr> CreateXYPaths(int width, int height) {
+    fl::vector<fl::XYPathPtr> out;
+    out.push_back(fl::XYPath::NewCirclePath(width, height));
+    out.push_back(fl::XYPath::NewRosePath(width, height));
+    out.push_back(fl::XYPath::NewHeartPath(width, height));
+    out.push_back(fl::XYPath::NewArchimedeanSpiralPath(width, height));
+    out.push_back(fl::XYPath::NewPhyllotaxisPath(width, height));
+    out.push_back(fl::XYPath::NewGielisCurvePath(width, height));
+    out.push_back(fl::XYPath::NewCatmullRomPath(width, height, make_path(width, height)));
+    return out;
+}

+    uint8_t scale_vals[] = {0, 1, 127, 128, 254, 255};
+    for (int s = 0; s < 6; s++) {
+        uint8_t expected[16], actual[16];
+        ref_scale_u8_16(v, scale_vals[s], expected);
+        store_u8_16(actual, scale_u8_16(load_u8_16(v), scale_vals[s]));

+// Scalar reference: scale
+inline void ref_scale_u8_16(const uint8_t* v, uint8_t scale, uint8_t* out) {
+    for (int i = 0; i < 16; i++) {
+        out[i] = (uint8_t)(((uint16_t)v[i] * scale) >> 8);
+    }
+}

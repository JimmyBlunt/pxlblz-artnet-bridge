@@ -0,0 +1,263 @@
+// The FastLED example catalogue: every official FastLED example, vendored
+// read-only (src/engine/fastled/catalog/, synced by scripts/sync-fastled-catalog.mjs
+// from the engine's catalog/ folder) and shown as a "FastLED" built-in folder
+// in the Patterns rail, like the stock Pixelblaze demos.
+//
+// An example opens read-only under the built-in key `fastled:<id>` (the same
+// activeDemoName slot a stock demo uses, so Clone, routes and per-demo settings
+// work unchanged) as a FastLED Pattern source: a short header (marker, dim, main
+// file name, provenance) followed by the verbatim upstream sketch and its
+// supporting files as `// @pxlblz-file` sections (fastledFiles.ts). Cloning
+// copies exactly that source into a personal FastLED Pattern.
+//
+// Pure: parsing, validation, rail organisation, source assembly. Loading lives
+// in fastledCatalogLoader.ts (code-split), state in store/fastledCatalogStore.ts.
+import type { EntityOrganizationNode } from '@/engine/entityOrganization'
+import type { Settings } from '@/engine/settings'
+import { FASTLED_MARKER } from '@/engine/patternLanguage'
+import { fastLedFilePathError, joinFastLedSource, type FastLedFile } from './fastledFiles'
+
+export const FASTLED_EXAMPLE_KEY_PREFIX = 'fastled:'
+export const FASTLED_EXAMPLES_FOLDER_ID = 'stock-pattern-fastled'
+
+export type FastLedExamplePlatform = 'pc' | 'hardware'
+
+export interface FastLedCatalogFile {
+  path: string
+  role: string
+  bytes: number
+  sha256: string
+  /** true = part of POST /compile (main as `source`, the rest as `files`). */
+  compile: boolean
+}
+
+export interface FastLedCatalogExample {
+  id: string
+  title: string
+  category: string
+  upstreamPath: string
+  mainFile: string
+  description: string | null
+  files: FastLedCatalogFile[]
+  omittedFiles: Array<{ path: string; reason: string }>
+  fastled: { version: string; commit: string }
+  license: string
+  upstreamUrl: string
+  compileStatus: 'ok' | 'error' | 'unknown'
+  /** First compile errors recorded by the catalogue run (for the notice). */
+  compileErrors: string[]
+  runStatus: string | null
+  ledCount: number | null
+  stripCount: number
+  uiElementCount: number
+  dim: 1 | 2 | 3 | null
+  width: number | null
+  height: number | null
+  platform: FastLedExamplePlatform
+  /** Short German note for the catalogue UI. */
+  note: string
+  parity: string | null
+}
+
+export interface FastLedCatalogCategory {
+  id: string
+  title: string
+}
+
+export interface FastLedCatalog {
+  schemaVersion: number
+  fastled: { version: string; commit: string; license: string }
+  categories: FastLedCatalogCategory[]
+  examples: FastLedCatalogExample[]
+}
+
+// ------------------------------------------------------------------ keys
+export function fastLedExampleKey(id: string): string {
+  return `${FASTLED_EXAMPLE_KEY_PREFIX}${id}`
+}
+
+export function isFastLedExampleKey(name: string | null | undefined): name is string {
+  return typeof name === 'string' && name.startsWith(FASTLED_EXAMPLE_KEY_PREFIX) && name.length > FASTLED_EXAMPLE_KEY_PREFIX.length
+}
+
+export function fastLedExampleIdFromKey(name: string): string {
+  return name.slice(FASTLED_EXAMPLE_KEY_PREFIX.length)
+}
+
+// ------------------------------------------------------------------ parsing
+const isRecord = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v)
+const str = (v: unknown, fallback = ''): string => (typeof v === 'string' ? v : fallback)
+const num = (v: unknown): number | null => (typeof v === 'number' && Number.isFinite(v) ? v : null)
+const ID_RE = /^[A-Za-z0-9_][A-Za-z0-9_.+-]*$/
+
+/**
+ * Validates and narrows the engine's fastled-examples.json (schemaVersion 1,
+ * documented in its catalog/README.md). Throws on structural problems; unknown
+ * fields are ignored, optional fields default.
+ */
+export function parseFastLedCatalog(raw: unknown): FastLedCatalog {
+  if (!isRecord(raw)) throw new Error('FastLED catalogue: not an object')
+  if (raw.schemaVersion !== 1) throw new Error(`FastLED catalogue: unsupported schemaVersion ${String(raw.schemaVersion)}`)
+  if (!Array.isArray(raw.examples)) throw new Error('FastLED catalogue: examples missing')
+  const fastled = isRecord(raw.fastled) ? raw.fastled : {}
+  const categories: FastLedCatalogCategory[] = Array.isArray(raw.categories)
+    ? raw.categories.filter(isRecord).map((c) => ({ id: str(c.id), title: str(c.title, str(c.id)) })).filter((c) => c.id !== '')
+    : []
+  const seen = new Set<string>()
+  const examples = raw.examples.map((e, index): FastLedCatalogExample => {
+    if (!isRecord(e)) throw new Error(`FastLED catalogue: example ${index} is not an object`)
+    const id = str(e.id)
+    if (!ID_RE.test(id)) throw new Error(`FastLED catalogue: example ${index} has an invalid id ${JSON.stringify(e.id)}`)
+    if (seen.has(id)) throw new Error(`FastLED catalogue: duplicate id ${id}`)
+    seen.add(id)
+    const mainFile = str(e.mainFile)
+    const files = (Array.isArray(e.files) ? e.files : []).filter(isRecord).map((f) => ({
+      path: str(f.path),
+      role: str(f.role, 'source'),
+      bytes: num(f.bytes) ?? 0,
+      sha256: str(f.sha256),
+      compile: f.compile !== false,
+    }))
+    if (!mainFile || !files.some((f) => f.path === mainFile)) throw new Error(`FastLED catalogue: ${id} has no main file in its file list`)
+    for (const f of files) {
+      if (f.path === mainFile) continue
+      if (f.compile && fastLedFilePathError(f.path)) throw new Error(`FastLED catalogue: ${id} has an unsupported file path ${f.path}`)
+    }
+    const compile = isRecord(e.compile) ? e.compile : {}
+    const compileStatus = compile.status === 'ok' ? 'ok' : compile.status === 'error' ? 'error' : 'unknown'
+    const compileErrors = Array.isArray(compile.errors)
+      ? compile.errors.filter(isRecord).slice(0, 3).map((x) => {
+        const where = typeof x.file === 'string' ? `${x.file}${typeof x.line === 'number' ? `:${x.line}` : ''}: ` : ''
+        return `${where}${str(x.message)}`
+      })
+      : []
+    const run = isRecord(e.run) ? e.run : null
+    const geometry = isRecord(e.geometry) ? e.geometry : {}
+    const dim = geometry.dim === 1 || geometry.dim === 2 || geometry.dim === 3 ? geometry.dim : null
+    const parity = isRecord(e.parity) ? str(e.parity.status) || null : null
+    const fl = isRecord(e.fastled) ? e.fastled : fastled
+    return {
+      id,
+      title: str(e.title, id),
+      category: str(e.category, 'advanced'),
+      upstreamPath: str(e.upstreamPath, id),
+      mainFile,
+      description: typeof e.description === 'string' ? e.description : null,
+      files,
+      omittedFiles: (Array.isArray(e.omittedFiles) ? e.omittedFiles : []).filter(isRecord).map((o) => ({ path: str(o.path), reason: str(o.reason) })),
+      fastled: { version: str(fl.version), commit: str(fl.commit) },
+      license: str(e.license, 'MIT (FastLED)'),
+      upstreamUrl: str(e.upstreamUrl),
+      compileStatus,
+      compileErrors,
+      runStatus: run ? str(run.status) || null : null,
+      ledCount: num(e.ledCount),
+      stripCount: Array.isArray(e.strips) ? e.strips.length : 0,
+      uiElementCount: Array.isArray(e.uiElements) ? e.uiElements.length : 0,
+      dim,
+      width: num(geometry.width),
+      height: num(geometry.height),
+      platform: e.platform === 'pc' ? 'pc' : 'hardware',
+      note: str(e.note),
+      parity,
+    }
+  })
+  return {
+    schemaVersion: 1,
+    fastled: { version: str(fastled.version), commit: str(fastled.commit), license: str(fastled.license, 'MIT') },
+    categories,
+    examples,
+  }
+}
+
+// ------------------------------------------------------------------ rail
+/** Rail label: the sketch name; hardware examples carry a visible mark. */
+export function fastLedExampleRailName(example: Pick<FastLedCatalogExample, 'title'>): string {
+  return example.title
+}
+
+/** Category order from the catalogue, then any category it did not declare. */
+function orderedCategories(catalog: Pick<FastLedCatalog, 'categories'>, examples: readonly FastLedCatalogExample[]): FastLedCatalogCategory[] {
+  const declared = catalog.categories.filter((c) => examples.some((e) => e.category === c.id))
+  const extra = [...new Set(examples.map((e) => e.category))]
+    .filter((id) => !catalog.categories.some((c) => c.id === id))
+    .sort()
+    .map((id) => ({ id, title: id }))
+  return [...declared, ...extra]
+}
+
+export function fastLedCategoryFolderId(categoryId: string): string {
+  return `${FASTLED_EXAMPLES_FOLDER_ID}-${categoryId.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`
+}
+
+/**
+ * The "FastLED" built-in folder: one subfolder per category, examples sorted by
+ * title. Entity ids are `fastled:<id>`.
+ */
+export function fastLedExampleFolder(
+  catalog: Pick<FastLedCatalog, 'categories'>,
+  examples: readonly FastLedCatalogExample[],
+): EntityOrganizationNode | null {
+  if (examples.length === 0) return null
+  return {
+    kind: 'folder',
+    id: FASTLED_EXAMPLES_FOLDER_ID,
+    name: 'FastLED',
+    children: orderedCategories(catalog, examples).map((category): EntityOrganizationNode => ({
+      kind: 'folder',
+      id: fastLedCategoryFolderId(category.id),
+      name: category.title,
+      children: examples
+        .filter((e) => e.category === category.id)
+        .sort((a, b) => a.title.localeCompare(b.title, 'en', { sensitivity: 'base' }))
+        .map((e) => ({ kind: 'entity', entityId: fastLedExampleKey(e.id) })),
+    })),
+  }
+}
+
+// ------------------------------------------------------------------ source
+/** Files that belong into the Pattern (compile: true, everything but the main file). */
+export function fastLedExampleSupportFiles(example: FastLedCatalogExample): FastLedCatalogFile[] {
+  return example.files.filter((f) => f.compile && f.path !== example.mainFile)
+}
+
+const oneLine = (s: string) => s.replace(/\s+/g, ' ').trim()
+
+/**
+ * The example as a FastLED Pattern source: header + verbatim sketch + verbatim
+ * supporting files. `texts` maps file path → content (main included).
+ */
+export function buildFastLedExampleSource(example: FastLedCatalogExample, texts: Readonly<Record<string, string>>): string {
+  const main = texts[example.mainFile]
+  if (typeof main !== 'string') throw new Error(`FastLED example ${example.id}: ${example.mainFile} missing`)
+  const version = [example.fastled.version && `FastLED ${example.fastled.version}`, example.fastled.commit && `@ ${example.fastled.commit.slice(0, 10)}`]
+    .filter(Boolean)
+    .join(' ')
+  const header = [
+    FASTLED_MARKER,
+    `// @pxlblz-dim ${example.dim ?? 1}`,
+    `// @pxlblz-main ${example.mainFile.split('/').pop()}`,
+    `// FastLED example "${example.title}" (${example.upstreamPath}), ${version || 'FastLED'}, ${example.license}.`,
+    ...(example.upstreamUrl ? [`// ${example.upstreamUrl}`] : []),
+    ...(example.platform === 'hardware' && example.note ? [`// Hinweis: ${oneLine(example.note)}`] : []),
+    '',
+  ].join('\n')
+  const files: FastLedFile[] = fastLedExampleSupportFiles(example).map((f) => {
+    const text = texts[f.path]
+    if (typeof text !== 'string') throw new Error(`FastLED example ${example.id}: ${f.path} missing`)
+    return { path: f.path, text }
+  })
+  return joinFastLedSource({ main: header + main, files })
+}
+
+/** Preview settings recommended for an example (its own LED count). */
+export function fastLedExampleRecommendedSettings(example: Pick<FastLedCatalogExample, 'ledCount'>): Partial<Settings> {
+  return example.ledCount !== null && example.ledCount > 0 ? { pixelCount: example.ledCount } : {}
+}
+
+/** One-line status for the read-only example banner. */
+export function fastLedExampleNotice(example: FastLedCatalogExample): { tone: 'hardware' | 'warning' | 'info'; text: string } {
+  if (example.platform === 'hardware') return { tone: 'hardware', text: example.note || 'Hardware-Beispiel: im PC-Modus nur eingeschränkt lauffähig.' }
+  if (example.compileStatus === 'error') return { tone: 'warning', text: example.note || 'Dieses Beispiel ließ sich im Katalog-Lauf nicht kompilieren.' }
+  return { tone: 'info', text: example.note || example.description || '' }
+}
diff --git a/src/engine/fastled/fastledCatalogLoader.ts b/src/engine/fastled/fastledCatalogLoader.ts
new file mode 100644
index 00000000..d8ae9e08
--- /dev/null
+++ b/src/engine/fastled/fastledCatalogLoader.ts
@@ -0,0 +1,33 @@
+// Lazy loading of the vendored FastLED example catalogue. Nothing here enters
+// the main bundle: the index is its own chunk (dynamic import) and every example
+// file is a separate chunk fetched only when that example opens.
+import {
+  buildFastLedExampleSource,
+  fastLedExampleSupportFiles,
+  parseFastLedCatalog,
+  type FastLedCatalog,
+  type FastLedCatalogExample,
+} from './fastledCatalog'
+
+const EXAMPLE_FILES = import.meta.glob<string>('./catalog/examples/**/*', { query: '?raw', import: 'default' })
+
+export async function loadFastLedCatalog(): Promise<FastLedCatalog> {
+  const mod = await import('./catalog/fastled-examples.json?raw')
+  return parseFastLedCatalog(JSON.parse(mod.default))
+}
+
+/** path → verbatim text for the example's main file and supporting files. */
+export async function loadFastLedExampleFiles(example: FastLedCatalogExample): Promise<Record<string, string>> {
+  const paths = [example.mainFile, ...fastLedExampleSupportFiles(example).map((f) => f.path)]
+  const entries = await Promise.all(paths.map(async (path) => {
+    const load = EXAMPLE_FILES[`./catalog/examples/${example.id}/${path}`]
+    if (!load) throw new Error(`FastLED example ${example.id}: ${path} is not vendored (run scripts/sync-fastled-catalog.mjs)`)
+    return [path, await load()] as const
+  }))
+  return Object.fromEntries(entries)
+}
+
+/** The example as a read-only FastLED Pattern source (header + verbatim files). */
+export async function loadFastLedExampleSource(example: FastLedCatalogExample): Promise<string> {
+  return buildFastLedExampleSource(example, await loadFastLedExampleFiles(example))
+}

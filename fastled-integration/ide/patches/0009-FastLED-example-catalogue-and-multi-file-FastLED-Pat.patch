+++ b/src/engine/fastled/fastledFiles.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it } from 'vitest'
+import {
+  FASTLED_DEFAULT_MAIN_FILE,
+  fastLedCompileParts,
+  fastLedFilePathError,
+  fastLedFileText,
+  fastLedMainFileName,
+  joinFastLedSource,
+  splitFastLedSource,
+  validateFastLedFiles,
+  withFastLedFileAdded,
+  withFastLedFileRemoved,
+  withFastLedFileRenamed,
+  withFastLedFileText,
+} from './fastledFiles'
+import { isFastLedSource, parseFastLedDirectives } from '@/engine/patternLanguage'
+
+const MAIN = '// @pxlblz-language fastled\n// @pxlblz-dim 2\n#include <FastLED.h>\n#include "NoisePlusPalette.h"\nvoid setup() {}\nvoid loop() {}\n'
+const HEADER = '#pragma once\nCRGBPalette16 currentPalette( PartyColors_p );\n'
+const CPP = 'int helper() { return 1; }'
+
+describe('FastLED Pattern supporting files', () => {
+  it('keeps a single-file Pattern unchanged', () => {
+    expect(splitFastLedSource(MAIN)).toEqual({ main: MAIN, files: [] })
+    expect(joinFastLedSource({ main: MAIN, files: [] })).toBe(MAIN)
+  })
+
+  it('round-trips sketch and files byte for byte', () => {
+    const cases = [
+      { main: MAIN, files: [{ path: 'NoisePlusPalette.h', text: HEADER }, { path: 'src/wave.cpp', text: CPP }] },
+      // Empty files, missing trailing newlines, CRLF content, empty main.
+      { main: MAIN.trimEnd(), files: [{ path: 'a.h', text: '' }, { path: 'b.h', text: '' }] },
+      { main: 'x\r\n', files: [{ path: 'c.h', text: 'line1\r\nline2\r\n' }, { path: 'd.cpp', text: '\n\n' }] },
+      { main: '', files: [{ path: 'e.h', text: 'e' }] },
+    ]
+    for (const parts of cases) {
+      const src = joinFastLedSource(parts)
+      expect(splitFastLedSource(src)).toEqual(parts)
+      expect(joinFastLedSource(splitFastLedSource(src))).toBe(src)
+    }
+  })
+
+  it('keeps the marker and directives in the sketch section, so the Pattern stays FastLED', () => {
+    const src = joinFastLedSource({ main: MAIN, files: [{ path: 'NoisePlusPalette.h', text: HEADER }] })
+    expect(isFastLedSource(src)).toBe(true)
+    expect(parseFastLedDirectives(src).dim).toBe(2)
+    expect(src).toContain('\n// @pxlblz-file NoisePlusPalette.h\n#pragma once')
+  })
+
+  it('only treats exact whole-line delimiters as file boundaries', () => {
+    const src = `${MAIN}  // @pxlblz-file indented.h\nint x; // @pxlblz-file trailing.h\n`
+    expect(splitFastLedSource(src).files).toEqual([])
+  })
+
+  it('builds the compile request parts', () => {
+    const src = joinFastLedSource({ main: MAIN, files: [{ path: 'NoisePlusPalette.h', text: HEADER }, { path: 'src/wave.cpp', text: CPP }] })
+    expect(fastLedCompileParts(src)).toEqual({ source: MAIN, files: { 'NoisePlusPalette.h': HEADER, 'src/wave.cpp': CPP } })
+    expect(fastLedCompileParts(MAIN)).toEqual({ source: MAIN, files: {} })
+  })
+
+  it('edits, adds, renames and removes one section without touching the others', () => {
+    let src = withFastLedFileAdded(MAIN, 'NoisePlusPalette.h', HEADER)
+    src = withFastLedFileAdded(src, 'extra.cpp')
+    expect(splitFastLedSource(src).files.map((f) => f.path)).toEqual(['NoisePlusPalette.h', 'extra.cpp'])
+    src = withFastLedFileText(src, 'extra.cpp', CPP)
+    src = withFastLedFileText(src, null, MAIN.replace('void loop() {}', 'void loop() { FastLED.show(); }'))
+    expect(fastLedFileText(src, 'NoisePlusPalette.h')).toBe(HEADER)
+    expect(fastLedFileText(src, 'extra.cpp')).toBe(CPP)
+    expect(fastLedFileText(src, null)).toContain('FastLED.show()')
+    src = withFastLedFileRenamed(src, 'extra.cpp', 'helpers.cpp')
+    expect(fastLedFileText(src, 'helpers.cpp')).toBe(CPP)
+    // Invalid or duplicate targets are refused (source unchanged).
+    expect(withFastLedFileRenamed(src, 'helpers.cpp', 'NoisePlusPalette.H')).toBe(src)
+    expect(withFastLedFileAdded(src, '../evil.h')).toBe(src)
+    src = withFastLedFileRemoved(src, 'helpers.cpp')
+    expect(splitFastLedSource(src)).toEqual({ main: expect.stringContaining('FastLED.show()'), files: [{ path: 'NoisePlusPalette.h', text: HEADER }] })
+    // Editing a file that does not exist is a no-op.
+    expect(withFastLedFileText(src, 'missing.h', 'x')).toBe(src)
+  })
+
+  it('validates file paths like the compile service and the fork rules', () => {
+    expect(fastLedFilePathError('Palette.h')).toBeNull()
+    expect(fastLedFilePathError('src/wave.cpp')).toBeNull()
+    expect(fastLedFilePathError('detail/impl.hpp')).toBeNull()
+    expect(fastLedFilePathError('Second.ino')).toBeNull()
+    expect(fastLedFilePathError('data/screenmap.json')).toBeNull()
+    for (const bad of ['', '../x.h', '/abs.h', 'a/../b.h', '.hidden.h', 'x.exe', 'x.H', 'x.md', 'con.h', 'a\\b.h', 'sp ace.h', 'x'.repeat(200) + '.h']) {
+      expect(fastLedFilePathError(bad), bad).not.toBeNull()
+    }
+    expect(fastLedFilePathError('palette.h', ['Palette.h'])).toMatch(/already exists/)
+  })
+
+  it('reports content that would break the round trip and oversized Patterns', () => {
+    expect(validateFastLedFiles({ main: MAIN, files: [{ path: 'a.h', text: HEADER }] })).toEqual([])
+    expect(validateFastLedFiles({ main: MAIN, files: [{ path: 'a.h', text: '// @pxlblz-file b.h\n' }] })[0]).toMatch(/reserved/)
+    expect(validateFastLedFiles({ main: MAIN, files: [{ path: 'a.h', text: '' }, { path: 'A.h', text: '' }] })[0]).toMatch(/already exists/)
+    expect(validateFastLedFiles({ main: 'x'.repeat(1024 * 1024 + 1), files: [] })[0]).toMatch(/1 MiB/)
+  })
+
+  it('names the sketch tab from @pxlblz-main', () => {
+    expect(fastLedMainFileName(MAIN)).toBe(FASTLED_DEFAULT_MAIN_FILE)
+    expect(fastLedMainFileName(`// @pxlblz-language fastled\n// @pxlblz-main NoisePlusPalette.ino\n#include <FastLED.h>\n`)).toBe('NoisePlusPalette.ino')
+    expect(fastLedMainFileName(`#include <FastLED.h>\n// @pxlblz-main Late.ino\n`)).toBe(FASTLED_DEFAULT_MAIN_FILE)
+  })
+})
+
+describe('FastLED file path extension check', () => {
+  it('requires a literal dot before the extension', () => {
+    expect(fastLedFilePathError('Paletteh')).not.toBeNull()
+    expect(fastLedFilePathError('Palette_h')).not.toBeNull()
+  })
+})
diff --git a/src/engine/fastled/fastledFiles.ts b/src/engine/fastled/fastledFiles.ts
new file mode 100644
index 00000000..5778dedf
--- /dev/null
+++ b/src/engine/fastled/fastledFiles.ts
@@ -0,0 +1,167 @@
+// Supporting files of a FastLED Pattern (.h/.cpp next to the sketch).
+//
+// A FastLED Pattern stays ONE `src` string, so every save, autosave, clone,
+// navigation flush and D1 row keeps all of its files without a schema change or
+// migration. Supporting files follow the sketch as delimited sections:
+//
+//   // @pxlblz-language fastled
+//   ...sketch (the main file, sent as `source`)...
+//   // @pxlblz-file NoisePlusPalette.h
+//   ...file text...
+//   // @pxlblz-file src/wave.cpp
+//   ...file text...
+//
+// File model = the compile service's sketch folder: subfolders allowed; every
+// .c/.cpp is its own translation unit, further .ino tabs are appended to the
+// sketch (Arduino IDE), headers and data files (.json/.txt/.csv) sit next to it.
+// A delimiter is a whole line `// @pxlblz-file <path>`. joinFastLedSource and
+// splitFastLedSource round-trip exactly (byte for byte) for any content that
+// does not itself contain a delimiter line, which validateFastLedFiles enforces.
+// The editor shows one section at a time; the compile client sends the sections
+// as `{ source, files }` (POST /compile).
+
+export const FASTLED_FILE_DIRECTIVE = '// @pxlblz-file'
+/** Optional header directive naming the sketch file (tab label only). */
+const MAIN_DIRECTIVE = /^\s*\/\/\s*@pxlblz-main\s*[:=]?\s*(\S+)/i
+const DELIMITER = /^\/\/ @pxlblz-file (\S+)[ \t]*\r?$/
+export const FASTLED_DEFAULT_MAIN_FILE = 'sketch.ino'
+
+export const FASTLED_MAX_FILES = 128
+export const FASTLED_MAX_SOURCE_BYTES = 1024 * 1024
+const MAX_PATH_LENGTH = 160
+const SEGMENT = '[A-Za-z0-9_][A-Za-z0-9_.+-]*'
+const PATH_RE = new RegExp(`^(?:${SEGMENT}/)*${SEGMENT}\\.(?:h|hh|hpp|hxx|inc|ipp|tpp|c|cc|cpp|cxx|ino|pde|json|txt|csv)$`)
+const RESERVED = /^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/i
+
+export interface FastLedFile {
+  /** Relative path inside the sketch folder, e.g. `NoisePlusPalette.h`, `src/wave.cpp`. */
+  path: string
+  text: string
+}
+
+export interface FastLedSourceParts {
+  /** The sketch itself, including the marker/header lines. */
+  main: string
+  files: FastLedFile[]
+}
+
+/** Splits a FastLED Pattern source into the sketch and its supporting files. */
+export function splitFastLedSource(src: string): FastLedSourceParts {
+  // Delimiter lines: [lineStart, lineEnd (index of '\n' or src.length), path]
+  const marks: Array<[number, number, string]> = []
+  let start = 0
+  while (start <= src.length) {
+    const nl = src.indexOf('\n', start)
+    const end = nl < 0 ? src.length : nl
+    // Cheap prefilter before the regex: only lines starting with the directive.
+    if (src.startsWith(FASTLED_FILE_DIRECTIVE, start)) {
+      const m = DELIMITER.exec(src.slice(start, end))
+      if (m) marks.push([start, end, m[1]])
+    }
+    if (nl < 0) break
+    start = nl + 1
+  }
+  if (marks.length === 0) return { main: src, files: [] }
+  const before = (lineStart: number) => (lineStart > 0 && src[lineStart - 1] === '\n' ? lineStart - 1 : lineStart)
+  const main = src.slice(0, before(marks[0][0]))
+  const files = marks.map(([, end, path], i) => {
+    const textStart = Math.min(src.length, end + 1)
+    const textEnd = i + 1 < marks.length ? before(marks[i + 1][0]) : src.length
+    return { path, text: textStart <= textEnd ? src.slice(textStart, textEnd) : '' }
+  })
+  return { main, files }
+}
+
+/** Inverse of splitFastLedSource. */
+export function joinFastLedSource(parts: FastLedSourceParts): string {
+  let out = parts.main
+  for (const file of parts.files) out += `\n${FASTLED_FILE_DIRECTIVE} ${file.path}\n${file.text}`
+  return out
+}
+
+/** The sketch's display name: `// @pxlblz-main Name.ino` or `sketch.ino`. */
+export function fastLedMainFileName(src: string): string {
+  const lines = src.split('\n', 20)
+  for (const line of lines) {
+    const trimmed = line.trim()
+    if (trimmed !== '' && !trimmed.startsWith('//')) break
+    const m = MAIN_DIRECTIVE.exec(line)
+    if (m) return m[1]
+  }
+  return FASTLED_DEFAULT_MAIN_FILE
+}
+
+/** `null` when the path is acceptable as a new supporting file. */
+export function fastLedFilePathError(path: string, existing: readonly string[] = []): string | null {
+  if (path.length === 0) return 'Enter a file name, e.g. Palette.h'
+  if (path.length > MAX_PATH_LENGTH) return `File names are limited to ${MAX_PATH_LENGTH} characters`
+  if (!PATH_RE.test(path) || path.split('/').some((segment) => RESERVED.test(segment))) {
+    return 'Use a relative .h, .hpp, .cpp or .ino path (letters, digits, _ . + -; folders with /)'
+  }
+  const lower = path.toLowerCase()
+  if (existing.some((p) => p.toLowerCase() === lower)) return `${path} already exists`
+  return null
+}
+
+const ENCODER = new TextEncoder()
+
+/** Problems that would break the round trip or the compile request; [] when fine. */
+export function validateFastLedFiles(parts: FastLedSourceParts): string[] {
+  const problems: string[] = []
+  if (parts.files.length > FASTLED_MAX_FILES) problems.push(`A FastLED Pattern holds at most ${FASTLED_MAX_FILES} supporting files`)
+  const seen: string[] = []
+  let bytes = ENCODER.encode(parts.main).length
+  for (const file of parts.files) {
+    const err = fastLedFilePathError(file.path, seen)
+    if (err) problems.push(`${file.path}: ${err}`)
+    seen.push(file.path)
+    bytes += ENCODER.encode(file.text).length
+  }
+  for (const [name, text] of [['sketch', parts.main] as const, ...parts.files.map((f) => [f.path, f.text] as const)]) {
+    if (text.split('\n').some((line) => DELIMITER.test(line))) {
+      problems.push(`${name}: a line starting with "${FASTLED_FILE_DIRECTIVE} " is reserved`)
+    }
+  }
+  if (bytes > FASTLED_MAX_SOURCE_BYTES) problems.push('Sketch and supporting files exceed 1 MiB')
+  return problems
+}
+
+/** The request body parts for POST /compile. */
+export function fastLedCompileParts(src: string): { source: string; files: Record<string, string> } {
+  const { main, files } = splitFastLedSource(src)
+  const out: Record<string, string> = {}
+  for (const f of files) out[f.path] = f.text
+  return { source: main, files: out }
+}
+
+/** Text of one section (`null` = the sketch). Missing files read as ''. */
+export function fastLedFileText(src: string, path: string | null): string {
+  const parts = splitFastLedSource(src)
+  if (path === null) return parts.main
+  return parts.files.find((f) => f.path === path)?.text ?? ''
+}
+
+/** Replaces one section's text; the other sections stay byte-identical. */
+export function withFastLedFileText(src: string, path: string | null, text: string): string {
+  const parts = splitFastLedSource(src)
+  if (path === null) return joinFastLedSource({ ...parts, main: text })
+  if (!parts.files.some((f) => f.path === path)) return src
+  return joinFastLedSource({ ...parts, files: parts.files.map((f) => (f.path === path ? { path, text } : f)) })
+}
+
+export function withFastLedFileAdded(src: string, path: string, text = ''): string {
+  const parts = splitFastLedSource(src)
+  if (fastLedFilePathError(path, parts.files.map((f) => f.path))) return src
+  return joinFastLedSource({ ...parts, files: [...parts.files, { path, text }] })
+}
+
+export function withFastLedFileRemoved(src: string, path: string): string {
+  const parts = splitFastLedSource(src)
+  return joinFastLedSource({ ...parts, files: parts.files.filter((f) => f.path !== path) })
+}
+
+export function withFastLedFileRenamed(src: string, from: string, to: string): string {
+  const parts = splitFastLedSource(src)
+  if (fastLedFilePathError(to, parts.files.filter((f) => f.path !== from).map((f) => f.path))) return src
+  return joinFastLedSource({ ...parts, files: parts.files.map((f) => (f.path === from ? { path: to, text: f.text } : f)) })
+}

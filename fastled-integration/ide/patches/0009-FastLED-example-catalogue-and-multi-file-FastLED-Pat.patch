+    expect(() => parseFastLedCatalog({ schemaVersion: 1, examples: [{ id: 'A', mainFile: 'A.ino', files: [] }] })).toThrow(/main file/)
+    const dup = { id: 'A', mainFile: 'A.ino', files: [{ path: 'A.ino' }] }
+    expect(() => parseFastLedCatalog({ schemaVersion: 1, examples: [dup, dup] })).toThrow(/duplicate/)
+    expect(() => parseFastLedCatalog({ schemaVersion: 1, examples: [{ id: 'A', mainFile: 'A.ino', files: [{ path: 'A.ino' }, { path: '../b.h', compile: true }] }] })).toThrow(/unsupported file path/)

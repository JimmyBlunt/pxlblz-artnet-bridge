--- /dev/null
+++ b/src/engine/patternLanguage.test.ts
@@ -0,0 +1,75 @@
+import { describe, expect, it } from 'vitest'
+import {
+  FASTLED_MARKER,
+  isFastLedSource,
+  looksLikeFastLedSource,
+  parseFastLedDirectives,
+  patternLanguage,
+  withFastLedMarker,
+} from './patternLanguage'
+import { NEW_FASTLED_PATTERN_SRC } from './fastled/newFastLedPattern'
+import { NEW_PATTERN_SRC } from '@/pixelblaze/newPattern'
+
+describe('patternLanguage', () => {
+  it.each([
+    ['first line', '// @pxlblz-language fastled\n#include <FastLED.h>\n', 'fastled'],
+    ['after a license comment and blank line', '// MIT License\n// (c) me\n\n// @pxlblz-language fastled\nvoid loop() {}', 'fastled'],
+    ['upper case', '// @PXLBLZ-LANGUAGE FastLED\n', 'fastled'],
+    ['colon form', '//@pxlblz-language: fastled\n', 'fastled'],
+    ['equals form', '// @pxlblz-language = fastled\n', 'fastled'],
+    ['CRLF line endings', '// @pxlblz-language fastled\r\n#include <FastLED.h>\r\n', 'fastled'],
+    ['marker after code', '#include <FastLED.h>\n// @pxlblz-language fastled\n', 'pixelblaze'],
+    ['Pixelblaze mentioning FastLED', '// Ported from a FastLED demo\nexport function render(i) { hsv(0, 1, 1) }', 'pixelblaze'],
+    ['other language value', '// @pxlblz-language pixelblaze\n', 'pixelblaze'],
+    ['prefix of a longer word', '// @pxlblz-language fastledx\n', 'pixelblaze'],
+    ['empty source', '', 'pixelblaze'],
+    ['new Pixelblaze template', NEW_PATTERN_SRC, 'pixelblaze'],
+    ['new FastLED template', NEW_FASTLED_PATTERN_SRC, 'fastled'],
+  ])('%s', (_label, src, expected) => {
+    expect(patternLanguage(src)).toBe(expected)
+    expect(isFastLedSource(src)).toBe(expected === 'fastled')
+  })
+
+  it('ignores a marker beyond the 20-line header cap', () => {
+    const header = Array.from({ length: 20 }, (_, i) => `// line ${i}`).join('\n')
+    expect(patternLanguage(`${header}\n${FASTLED_MARKER}\n`)).toBe('pixelblaze')
+  })
+
+  it('treats null and undefined as not FastLED', () => {
+    expect(isFastLedSource(null)).toBe(false)
+    expect(isFastLedSource(undefined)).toBe(false)
+  })
+})
+
+describe('parseFastLedDirectives', () => {
+  it('defaults to 1D wire output', () => {
+    expect(parseFastLedDirectives('// @pxlblz-language fastled\n')).toEqual({ dim: 1, output: 'wire' })
+  })
+
+  it('reads dim and output from the header block only', () => {
+    const src = '// @pxlblz-language fastled\n// @pxlblz-dim 2\n// @pxlblz-output leds\n#include <FastLED.h>\n// @pxlblz-dim 3\n'
+    expect(parseFastLedDirectives(src)).toEqual({ dim: 2, output: 'leds' })
+  })
+
+  it('ignores invalid values', () => {
+    expect(parseFastLedDirectives('// @pxlblz-dim 4\n// @pxlblz-output rgbw\n')).toEqual({ dim: 1, output: 'wire' })
+  })
+})
+
+describe('looksLikeFastLedSource / withFastLedMarker', () => {
+  const cpp = '#include <FastLED.h>\nCRGB leds[8];\n'
+
+  it('hints only for unmarked FastLED C++', () => {
+    expect(looksLikeFastLedSource(cpp)).toBe(true)
+    expect(looksLikeFastLedSource('#include "FastLED.h"\n')).toBe(true)
+    expect(looksLikeFastLedSource(withFastLedMarker(cpp))).toBe(false)
+    expect(looksLikeFastLedSource(NEW_PATTERN_SRC)).toBe(false)
+  })
+
+  it('prepends the marker once', () => {
+    const marked = withFastLedMarker(cpp)
+    expect(marked).toBe(`${FASTLED_MARKER}\n${cpp}`)
+    expect(withFastLedMarker(marked)).toBe(marked)
+    expect(isFastLedSource(marked)).toBe(true)
+  })
+})

+// Starter source for "New FastLED pattern" (rail menu). The marker on the first
+// line makes it a FastLED Pattern; PXLBLZ_NUM_LEDS is passed by the IDE as a
+// compiler define (the current map's pixel count), so the Pattern follows the
+// map. UISlider/UICheckbox values appear in the preview's Controls panel and are
+// remembered per Pattern.
+export const NEW_FASTLED_PATTERN_SRC = `// @pxlblz-language fastled
+// @pxlblz-dim 1
+// FastLED Pattern: runs in PXLBLZ-IDE and goes out through the LED router.
+#include <FastLED.h>
+
+// PXLBLZ passes the map's pixel count; the fallback is for other tools.
+#ifndef PXLBLZ_NUM_LEDS
+#define PXLBLZ_NUM_LEDS 64
+#endif
+#define NUM_LEDS PXLBLZ_NUM_LEDS
+#define DATA_PIN 2
+
+CRGB leds[NUM_LEDS];
+
+// Controls (shown in the preview's Controls panel)
+UISlider speed("Speed", 30, 1, 120, 1);
+UISlider density("Hue density", 7, 1, 32, 1);
+UISlider brightness("Brightness", 200, 0, 255, 1);
+UICheckbox glitter("Glitter", true);
+
+void setup() {
+  FastLED.addLeds<WS2812B, DATA_PIN, GRB>(leds, NUM_LEDS).setCorrection(TypicalLEDStrip);
+}
+
+void loop() {
+  FastLED.setBrightness((uint8_t)brightness.value());
+  fill_rainbow(leds, NUM_LEDS, beat8((uint8_t)speed.value()), (uint8_t)density.value());
+  if (glitter && random8() < 80) {
+    leds[random16(NUM_LEDS)] += CRGB::White;
+  }
+  FastLED.show();
+  FastLED.delay(1000 / 60);
+}
+`

+import { describe, expect, it } from 'vitest'
+import type { FastLedUiElement } from './fastledWasmHost'
+import {
+  fastLedControlBindings,
+  fastLedControlMetadata,
+  fastLedUiValue,
+  mergePersistedControlValues,
+  persistedControlPatch,
+} from './fastledControls'
+
+function el(partial: Partial<FastLedUiElement> & Pick<FastLedUiElement, 'id' | 'name' | 'kind'>): FastLedUiElement {
+  return { type: partial.kind, value: partial.defaultValue, defaultValue: undefined, raw: {}, ...partial }
+}
+
+const UI = [
+  el({ id: 1, name: 'Speed', kind: 'slider', min: 1, max: 120, step: 1, defaultValue: 30 }),
+  el({ id: 2, name: 'hue shift!', kind: 'number', min: -128, max: 127, defaultValue: 0 }),
+  el({ id: 3, name: 'Glitter', kind: 'checkbox', defaultValue: true }),
+  el({ id: 4, name: 'Speed', kind: 'slider', min: 0, max: 1, step: -1, defaultValue: 5 }),
+  el({ id: 5, name: 'Go', kind: 'button', defaultValue: false }),
+  el({ id: 6, name: 'Mode', kind: 'dropdown', options: ['a', 'b'], defaultValue: 0 }),
+  el({ id: 7, name: '3D', kind: 'slider', min: 0, max: 0, defaultValue: 0 }),
+  el({ id: 8, name: '', kind: 'checkbox', defaultValue: false }),
+]
+
+describe('fastLedControlBindings', () => {
+  const bindings = fastLedControlBindings(UI)
+
+  it('maps sliders, number fields and checkboxes; skips v1-unmapped and degenerate elements', () => {
+    expect(bindings.map((b) => [b.id, b.exportName, b.kind])).toEqual([
+      [1, 'sliderSpeed', 'slider'],
+      [2, 'sliderHueShift', 'slider'],
+      [3, 'toggleGlitter', 'toggle'],
+      [4, 'sliderSpeed2', 'slider'],
+      [8, 'toggleControl', 'toggle'],
+    ])
+  })
+
+  it('derives ranges, continuous steps and clamped defaults', () => {
+    expect(bindings[0].range).toEqual({ min: 1, max: 120, step: 1 })
+    expect(bindings[1].range).toEqual({ min: -128, max: 127, step: 0.255 })
+    expect(bindings[3]).toMatchObject({ range: { min: 0, max: 1, step: 0.001 }, defaultValue: 1 })
+    expect(bindings[2].defaultValue).toBe(1)
+  })
+
+  it('produces Control metadata labelled with the FastLED name', () => {
+    expect(fastLedControlMetadata(bindings)[2]).toEqual({ exportName: 'toggleGlitter', kind: 'toggle', label: 'Glitter' })
+  })
+
+  it('converts Control values to FastLED values', () => {
+    expect(fastLedUiValue(bindings[0], 500)).toBe(120)
+    expect(fastLedUiValue(bindings[2], 0)).toBe(false)
+    expect(fastLedUiValue(bindings[2], 1)).toBe(true)
+  })
+})
+
+describe('persisted Control values', () => {
+  const bindings = fastLedControlBindings(UI.slice(0, 3))
+
+  it('merges persisted values by UI name with clamping and ignores unknown or non-numeric keys', () => {
+    expect(mergePersistedControlValues(bindings, undefined)).toEqual({ sliderSpeed: 30, sliderHueShift: 0, toggleGlitter: 1 })
+    expect(mergePersistedControlValues(bindings, { Speed: -4, 'hue shift!': [1, 2], Glitter: 0, Other: 9 })).toEqual({
+      sliderSpeed: 1, sliderHueShift: 0, toggleGlitter: 0,
+    })
+  })
+
+  it('builds the record patch keyed by UI name', () => {
+    expect(persistedControlPatch(bindings, { sliderSpeed: 42, toggleGlitter: 0.4, sliderUnknown: 1 })).toEqual({ Speed: 42, Glitter: 1 })
+  })
+})
diff --git a/src/engine/fastled/fastledControls.ts b/src/engine/fastled/fastledControls.ts
new file mode 100644
index 00000000..5d2830ef
--- /dev/null
+++ b/src/engine/fastled/fastledControls.ts
@@ -0,0 +1,125 @@
+// FastLED UI elements (UISlider, UICheckbox, UINumberField) as preview Controls.
+// The Controls panel keeps working on PatternMetadata.controls; a FastLED slider
+// carries its own `range` and its value is the raw FastLED value (not 0..1).
+// Persisted values live in PatternRecord.controls keyed by the FastLED UI *name*
+// (element ids may change between compiles); unknown keys are ignored and values
+// are clamped, so stale entries stay harmless.
+import type { PatternMetadata } from '@/engine/loadPattern'
+import type { FastLedUiElement } from './fastledWasmHost'
+
+export interface FastLedControlBinding {
+  /** FastLED element id (setUi target for this instance). */
+  id: number
+  /** FastLED UI name (persistence key, Control label). */
+  uiName: string
+  exportName: string
+  kind: 'slider' | 'toggle'
+  range?: { min: number; max: number; step: number }
+  defaultValue: number
+}
+
+type ControlMetadata = PatternMetadata['controls'][number]
+
+function pascalCase(name: string): string {
+  const words = name.match(/[A-Za-z0-9]+/g) ?? []
+  const joined = words.map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join('')
+  return joined === '' ? 'Control' : /^[0-9]/.test(joined) ? `C${joined}` : joined
+}
+
+function finite(n: unknown): n is number {
+  return typeof n === 'number' && Number.isFinite(n)
+}
+
+function clamp(value: number, range: { min: number; max: number }): number {
+  return Math.min(range.max, Math.max(range.min, value))
+}
+
+function numericValue(value: unknown): number | undefined {
+  if (typeof value === 'boolean') return value ? 1 : 0
+  if (finite(value)) return value
+  return undefined
+}
+
+/** UI elements → Control bindings (v1: sliders, number fields, checkboxes). */
+export function fastLedControlBindings(ui: readonly FastLedUiElement[]): FastLedControlBinding[] {
+  const taken = new Set<string>()
+  const unique = (base: string): string => {
+    let name = base
+    for (let n = 2; taken.has(name); n += 1) name = `${base}${n}`
+    taken.add(name)
+    return name
+  }
+  const out: FastLedControlBinding[] = []
+  for (const el of ui) {
+    if (el.kind === 'checkbox') {
+      out.push({
+        id: el.id,
+        uiName: el.name,
+        exportName: unique(`toggle${pascalCase(el.name)}`),
+        kind: 'toggle',
+        defaultValue: numericValue(el.defaultValue) ? 1 : 0,
+      })
+    } else if ((el.kind === 'slider' || el.kind === 'number') && finite(el.min) && finite(el.max) && el.max > el.min) {
+      const step = finite(el.step) && el.step > 0 ? el.step : (el.max - el.min) / 1000
+      const range = { min: el.min, max: el.max, step }
+      out.push({
+        id: el.id,
+        uiName: el.name,
+        exportName: unique(`slider${pascalCase(el.name)}`),
+        kind: 'slider',
+        range,
+        defaultValue: clamp(numericValue(el.defaultValue) ?? el.min, range),
+      })
+    }
+  }
+  return out
+}
+
+export function fastLedControlMetadata(bindings: readonly FastLedControlBinding[]): ControlMetadata[] {
+  return bindings.map((b) => ({
+    exportName: b.exportName,
+    kind: b.kind,
+    label: b.uiName,
+    ...(b.range ? { range: { ...b.range } } : {}),
+  }))
+}
+
+/** Control store value (by exportName) → the value FastLED receives. */
+export function fastLedUiValue(binding: FastLedControlBinding, value: number): number | boolean {
+  if (binding.kind === 'toggle') return value !== 0
+  return binding.range ? clamp(value, binding.range) : value
+}
+
+/**
+ * Initial Control values: UI defaults, overridden by persisted values (keyed by
+ * UI name) when they are numbers; sliders are clamped to their range.
+ */
+export function mergePersistedControlValues(
+  bindings: readonly FastLedControlBinding[],
+  persisted: Record<string, unknown> | undefined,
+): Record<string, number> {
+  const values: Record<string, number> = {}
+  for (const b of bindings) {
+    const stored = persisted && Object.prototype.hasOwnProperty.call(persisted, b.uiName)
+      ? numericValue(persisted[b.uiName])
+      : undefined
+    if (stored === undefined) values[b.exportName] = b.defaultValue
+    else if (b.kind === 'toggle') values[b.exportName] = stored !== 0 ? 1 : 0
+    else values[b.exportName] = b.range ? clamp(stored, b.range) : stored
+  }
+  return values
+}
+
+/** Live Control values → the PatternRecord.controls patch (keyed by UI name). */
+export function persistedControlPatch(
+  bindings: readonly FastLedControlBinding[],
+  values: Record<string, unknown>,
+): Record<string, number> {
+  const patch: Record<string, number> = {}
+  for (const b of bindings) {
+    const v = numericValue(values[b.exportName])
+    if (v === undefined) continue
+    patch[b.uiName] = b.kind === 'toggle' ? (v !== 0 ? 1 : 0) : v
+  }
+  return patch
+}
diff --git a/src/engine/fastled/fastledPatternHandle.test.ts b/src/engine/fastled/fastledPatternHandle.test.ts
new file mode 100644
index 00000000..cd2d8d07
--- /dev/null
+++ b/src/engine/fastled/fastledPatternHandle.test.ts
@@ -0,0 +1,148 @@
+import { describe, expect, it, vi } from 'vitest'
+import { createShim } from '@/engine/shim'
+import { createRenderLoop } from '@/engine/renderLoop'
+import { createVirtualClock } from '@/engine/virtualClock'
+import { selectRenderCompatibility } from '@/engine/renderCompatibility'
+import type { MapPoint } from '@/engine/maps/types'
+import type { FastLedUiElement } from './fastledWasmHost'
+import { createFastLedPatternHandle, type FastLedHostLike } from './fastledPatternHandle'
+import { fastLedControlBindings } from './fastledControls'
+
+function uiEl(partial: Partial<FastLedUiElement> & Pick<FastLedUiElement, 'id' | 'name' | 'kind'>): FastLedUiElement {
+  return { type: partial.kind, value: partial.defaultValue, defaultValue: undefined, raw: {}, ...partial }
+}
+
+// A deterministic fake: each frame(dt>0) fills L1 with (frame, index, 7) and L2
+// with distinct bytes so wire/leds selection is observable.
+function fakeHost(ledCount: number, ui: FastLedUiElement[] = []) {
+  const leds = new Uint8Array(ledCount * 3)
+  const wire = new Uint8Array(ledCount * 3)
+  let frames = 0
+  const host: FastLedHostLike & { frame: ReturnType<typeof vi.fn>; setUi: ReturnType<typeof vi.fn> } = {
+    frame: vi.fn((dt: number) => {
+      if (dt > 0 || frames === 0) {
+        frames += 1
+        for (let i = 0; i < ledCount; i++) {
+          leds.set([(frames * 13 + i) & 255, (i * 7) & 255, 7], i * 3)
+          wire.set([(frames * 29 + i * 3) & 255, 255 - i, (frames + i * 11) & 255], i * 3)
+        }
+      }
+      return { status: 0 }
+    }),
+    getLeds: () => leds,
+    getWire: () => wire,
+    ledCount: () => ledCount,
+    getUi: () => ui,
+    setUi: vi.fn(() => true),
+    millis: () => frames * 16,
+    showCount: () => frames,
+  }
+  return host
+}
+
+function line(n: number): MapPoint[] {
+  return Array.from({ length: n }, (_, i) => ({ sample: [n > 1 ? i / (n - 1) : 0] }))
+}
+
+describe('createFastLedPatternHandle', () => {
+  it('renders the first frame once with frame(0) and ignores later zero deltas', () => {
+    const host = fakeHost(4)
+    const rgb = vi.fn()
+    const { handle } = createFastLedPatternHandle({ host, rgb, output: 'wire', controls: [] })
+    handle.beforeRender(0)
+    handle.beforeRender(0)
+    expect(host.frame).toHaveBeenCalledTimes(1)
+    expect(host.frame).toHaveBeenCalledWith(0)
+    handle.beforeRender(16.5)
+    expect(host.frame).toHaveBeenLastCalledWith(16.5)
+    handle.beforeRender(-1)
+    expect(host.frame).toHaveBeenCalledTimes(2)
+  })
+
+  it('emits byte/255 of the selected buffer and black past ledCount', () => {
+    for (const output of ['wire', 'leds'] as const) {
+      const host = fakeHost(3)
+      const rgb = vi.fn()
+      const { handle } = createFastLedPatternHandle({ host, rgb, output, controls: [] })
+      handle.beforeRender(0)
+      const buf = output === 'wire' ? host.getWire() : host.getLeds()
+      handle.render(1)
+      expect(rgb).toHaveBeenLastCalledWith(buf[3] / 255, buf[4] / 255, buf[5] / 255)
+      handle.render2D(2, 0.1, 0.2)
+      expect(rgb).toHaveBeenLastCalledWith(buf[6] / 255, buf[7] / 255, buf[8] / 255)
+      handle.render3D(3, 0, 0, 0)
+      expect(rgb).toHaveBeenLastCalledWith(0, 0, 0)
+    }
+  })
+
+  it('declares every render slot so renderer compatibility never adapts', () => {
+    const { metadata } = createFastLedPatternHandle({ host: fakeHost(1), rgb: () => {}, output: 'wire', controls: [] })
+    for (const dim of [1, 2, 3] as const) {
+      expect(selectRenderCompatibility(dim, metadata.renderFns).description).toBeNull()
+    }
+  })
+
+  it('forwards Controls to setUi by element id with FastLED values', () => {
+    const ui = [
+      uiEl({ id: 5, name: 'Speed', kind: 'slider', min: 1, max: 120, step: 1, defaultValue: 30 }),
+      uiEl({ id: 6, name: 'Glitter', kind: 'checkbox', defaultValue: true }),
+    ]
+    const host = fakeHost(1, ui)
+    const controls = fastLedControlBindings(ui)
+    const { handle, metadata } = createFastLedPatternHandle({ host, rgb: () => {}, output: 'wire', controls })
+    expect(metadata.controls).toEqual([
+      { exportName: 'sliderSpeed', kind: 'slider', label: 'Speed', range: { min: 1, max: 120, step: 1 } },
+      { exportName: 'toggleGlitter', kind: 'toggle', label: 'Glitter' },
+    ])
+    handle.controls.sliderSpeed(500)
+    expect(host.setUi).toHaveBeenLastCalledWith(5, 120)
+    handle.controls.toggleGlitter(0)
+    expect(host.setUi).toHaveBeenLastCalledWith(6, false)
+  })
+
+  it('exposes the virtual clock and UI values to the var watcher', () => {
+    const ui = [uiEl({ id: 1, name: 'Speed', kind: 'slider', min: 0, max: 10, value: 4, defaultValue: 3 })]
+    const host = fakeHost(2, ui)
+    const { handle, metadata } = createFastLedPatternHandle({ host, rgb: () => {}, output: 'wire', controls: fastLedControlBindings(ui) })
+    handle.beforeRender(0)
+    handle.beforeRender(16)
+    expect(handle.getExports()).toEqual({ ledCount: 2, millis: 32, shows: 2, frames: 2, Speed: 4 })
+    expect(metadata.patternVars).toEqual(['ledCount', 'millis', 'shows', 'frames', 'Speed'])
+  })
+
+  it('reports runaway budget frames', () => {
+    const host = fakeHost(1)
+    host.frame.mockReturnValue({ status: 1 })
+    const onBudget = vi.fn()
+    const { handle } = createFastLedPatternHandle({ host, rgb: () => {}, output: 'wire', controls: [], onBudget })
+    handle.beforeRender(0)
+    expect(onBudget).toHaveBeenCalledTimes(1)
+  })
+
+  it('round-trips exact bytes through createRenderLoop, the fast shim and paintPacked', () => {
+    const n = 5
+    const host = fakeHost(n)
+    const clock = createVirtualClock()
+    const shim = createShim({ mapPoints: line(n), pixelCount: n, dimensions: 1, getVirtualTime: () => clock.getTime() })
+    const { handle, metadata } = createFastLedPatternHandle({
+      host,
+      rgb: shim.builtins.rgb as (r: number, g: number, b: number) => void,
+      output: 'wire',
+      controls: [],
+    })
+    const frames: Uint8Array[] = []
+    const loop = createRenderLoop({
+      handle, shim, clock, mapPoints: line(n), pixelCount: n,
+      renderCompatibility: selectRenderCompatibility(1, metadata.renderFns),
+      getSpeed: () => 1, getBrightness: () => 0.3, isDimmed: () => false,
+      paint: () => { throw new Error('packed path expected') },
+      paintPacked: (frame) => { frames.push(Uint8Array.from(frame, (v) => Math.round(v * 255))) },
+    })
+    loop.renderPreviewFrame()
+    expect(frames[0]).toEqual(host.getWire())
+    for (let f = 0; f < 10; f++) {
+      loop.tickFrame(1000 / 60)
+      expect(frames[frames.length - 1]).toEqual(host.getWire())
+    }
+  })
+})
diff --git a/src/engine/fastled/fastledPatternHandle.ts b/src/engine/fastled/fastledPatternHandle.ts
new file mode 100644
index 00000000..2fe1eed9
--- /dev/null
+++ b/src/engine/fastled/fastledPatternHandle.ts
@@ -0,0 +1,121 @@
+// A FastLED Pattern as a PatternHandle, so the unchanged render loop, shim,
+// renderer, var watcher and external pixel output drive it like any Pattern.
+//
+// beforeRender(delta) advances the wasm sketch by delta ms (the loop already
+// applied preview speed); render*(index) emits byte/255 of the chosen output
+// buffer through the fast shim's rgb(). Byte → /255 → Math.round(v*255) is exact
+// in float64, so the packed frame carries FastLED's bytes unchanged.
+import type { PatternHandle, PatternMetadata } from '@/engine/loadPattern'
+import type { FastLedOutput } from '@/engine/patternLanguage'
+import type { FastLedUiElement } from './fastledWasmHost'
+import {
+  fastLedControlMetadata,
+  fastLedUiValue,
+  type FastLedControlBinding,
+} from './fastledControls'
+
+/** The subset of FastLedHost the handle uses (lets tests pass a fake). */
+export interface FastLedHostLike {
+  frame(dtMs: number): { status: number }
+  getLeds(): Uint8Array
+  getWire(): Uint8Array
+  ledCount(): number
+  getUi(): FastLedUiElement[]
+  setUi(idOrName: number | string, value: number | boolean | string): boolean
+  millis(): number
+  showCount(): number
+}
+
+export const FASTLED_FRAME_BUDGET = 1
+
+export function createFastLedPatternHandle(opts: {
+  host: FastLedHostLike
+  rgb: (r: number, g: number, b: number) => void
+  output: FastLedOutput
+  controls: readonly FastLedControlBinding[]
+  /** Called when a frame hit the runaway budget (the sketch stays resumable). */
+  onBudget?: () => void
+}): { handle: PatternHandle; metadata: PatternMetadata } {
+  const { host, rgb, output, controls } = opts
+  let started = false
+  let buf: Uint8Array = new Uint8Array(0)
+  let count = 0
+  let frames = 0
+
+  const refresh = () => {
+    // A fresh view per frame: memory.grow() detaches older views.
+    buf = output === 'leds' ? host.getLeds() : host.getWire()
+    count = Math.min(host.ledCount(), Math.floor(buf.length / 3))
+  }
+
+  const emit = (index: number) => {
+    const i = index | 0
+    if (i >= 0 && i < count) {
+      const o = i * 3
+      rgb(buf[o] / 255, buf[o + 1] / 255, buf[o + 2] / 255)
+    } else {
+      rgb(0, 0, 0)
+    }
+  }
+
+  const advance = (delta: number) => {
+    // delta <= 0 after the first frame is a paused repaint: re-emit the cached
+    // frame instead of running loop() again (frame(0) would be a no-op anyway).
+    if (started && !(delta > 0)) return
+    const result = host.frame(started ? delta : Math.max(0, delta))
+    started = true
+    frames += 1
+    if (result.status === FASTLED_FRAME_BUDGET) opts.onBudget?.()
+  }
+
+  const uiValues = (): Record<string, unknown> => {
+    const out: Record<string, unknown> = {}
+    const byId = new Map(host.getUi().map((el) => [el.id, el]))
+    for (const c of controls) {
+      const v = byId.get(c.id)?.value
+      out[c.uiName] = typeof v === 'boolean' ? (v ? 1 : 0) : v
+    }
+    return out
+  }
+
+  const controlFns: Record<string, (...args: number[]) => void> = {}
+  for (const c of controls) {
+    controlFns[c.exportName] = (value: number) => {
+      host.setUi(c.id, fastLedUiValue(c, value))
+    }
+  }
+
+  const handle: PatternHandle = {
+    beforeRender: (delta: number) => {
+      advance(delta)
+      refresh()
+    },
+    render: (index: number) => emit(index),
+    render2D: (index: number) => emit(index),
+    render3D: (index: number) => emit(index),
+    getExports: () => ({
+      ledCount: host.ledCount(),
+      millis: host.millis(),
+      shows: host.showCount(),
+      frames,
+      ...uiValues(),
+    }),
+    getRuntimeState: () => ({}),
+    getPatternFunctions: () => ({}),
+    setPatternFunction: () => false,
+    setPatternVar: () => false,
+    setRuntimeVar: () => false,
+    controls: controlFns,
+  }
+
+  const metadata: PatternMetadata = {
+    exportedVars: [],
+    patternVars: ['ledCount', 'millis', 'shows', 'frames', ...controls.map((c) => c.uiName)],
+    controls: fastLedControlMetadata(controls),
+    // Every slot exists, so renderer compatibility always picks the exact
+    // dimension and never reports an adaptation for a FastLED Pattern.
+    renderFns: { hasBeforeRender: true, hasRender: true, hasRender2D: true, hasRender3D: true },
+  }
+
+  return { handle, metadata }
+}
diff --git a/src/engine/fastled/fastledPatternHandle.wasm.test.ts b/src/engine/fastled/fastledPatternHandle.wasm.test.ts
new file mode 100644
index 00000000..60f36cb5
--- /dev/null
+++ b/src/engine/fastled/fastledPatternHandle.wasm.test.ts
@@ -0,0 +1,116 @@
+// Real FastLED wasm through the IDE preview path: vendored host → FastLED Pattern
+// handle → createRenderLoop (fast shim, packed frame). The goldens come from the
+// NATIVE FastLED reference build (scripts/generate-fastled-fixtures.mjs), so
+// 0 differing bytes means the router receives exactly FastLED's bytes.
+import { readFileSync } from 'node:fs'
+import { describe, expect, it } from 'vitest'
+import { createShim } from '@/engine/shim'
+import { createRenderLoop } from '@/engine/renderLoop'
+import { createVirtualClock } from '@/engine/virtualClock'
+import { selectRenderCompatibility } from '@/engine/renderCompatibility'
+import type { MapPoint } from '@/engine/maps/types'
+import { FASTLED_HOST_ABI_VERSION, instantiateFastLedHost } from './fastledWasmHost'
+import { createFastLedPatternHandle } from './fastledPatternHandle'
+import { fastLedControlBindings, mergePersistedControlValues } from './fastledControls'
+
+interface Golden {
+  frameMs: number
+  frames: number
+  seed: number
+  events: Record<string, Record<string, number | boolean>>
+  ledCount: number
+  l1: string
+  l2: string
+}
+
+const fixture = (name: string) => new URL(`./__fixtures__/${name}`, import.meta.url)
+
+async function replay(name: string, output: 'wire' | 'leds', pixelCount?: number) {
+  const golden = JSON.parse(readFileSync(fixture(`${name}.golden.json`), 'utf8')) as Golden
+  const expected = Buffer.from(output === 'wire' ? golden.l2 : golden.l1, 'base64')
+  const host = await instantiateFastLedHost(readFileSync(fixture(`${name}.wasm`)))
+  host.init(golden.seed)
+  const n = pixelCount ?? host.ledCount()
+  const mapPoints: MapPoint[] = Array.from({ length: n }, (_, i) => ({ sample: [i / Math.max(1, n - 1)] }))
+  const clock = createVirtualClock()
+  const shim = createShim({ mapPoints, pixelCount: n, dimensions: 1, getVirtualTime: () => clock.getTime() })
+  const controls = fastLedControlBindings(host.getUi())
+  const { handle, metadata } = createFastLedPatternHandle({
+    host,
+    rgb: shim.builtins.rgb as (r: number, g: number, b: number) => void,
+    output,
+    controls,
+  })
+  const frames: Uint8Array[] = []
+  const loop = createRenderLoop({
+    handle, shim, clock, mapPoints, pixelCount: n,
+    renderCompatibility: selectRenderCompatibility(1, metadata.renderFns),
+    getSpeed: () => 1, getBrightness: () => 0.5, isDimmed: () => false,
+    paint: () => { throw new Error('packed path expected') },
+    paintPacked: (frame) => { frames.push(Uint8Array.from(frame, (v) => Math.round(v * 255))) },
+  })
+  const byName = new Map(controls.map((c) => [c.uiName, c.exportName]))
+  const applyEvents = (f: number) => {
+    const event = golden.events[String(f)]
+    if (!event) return
+    for (const [uiName, value] of Object.entries(event)) {
+      handle.controls[byName.get(uiName)!](typeof value === 'boolean' ? (value ? 1 : 0) : value)
+    }
+  }
+  applyEvents(0)
+  loop.renderPreviewFrame()
+  for (let f = 1; f < golden.frames; f++) {
+    applyEvents(f)
+    loop.tickFrame(golden.frameMs)
+  }
+  return { golden, expected, frames, n, host, controls }
+}
+
+function countDiff(frames: Uint8Array[], expected: Buffer, ledCount: number, n: number): number {
+  let diff = 0
+  frames.forEach((frame, f) => {
+    for (let k = 0; k < n * 3; k++) {
+      const want = k < ledCount * 3 ? expected[f * ledCount * 3 + k] : 0
+      if (frame[k] !== want) diff += 1
+    }
+  })
+  return diff
+}
+
+describe('FastLED Pattern handle with real wasm (golden)', () => {
+  it('pins the vendored host ABI', () => {
+    expect(FASTLED_HOST_ABI_VERSION).toBe(1)
+  })
+
+  for (const name of ['template64', 'pipeline']) {
+    for (const output of ['wire', 'leds'] as const) {
+      it(`${name}: ${output === 'wire' ? 'L2 wire' : 'L1 leds'} bytes match the native reference (0 differing bytes)`, async () => {
+        const { golden, expected, frames, n } = await replay(name, output)
+        expect(frames).toHaveLength(golden.frames)
+        expect(n).toBe(golden.ledCount)
+        expect(countDiff(frames, expected, golden.ledCount, n)).toBe(0)
+      })
+    }
+  }
+
+  it('renders extra map pixels black when the map is larger than the Pattern', async () => {
+    const { golden, expected, frames, n } = await replay('template64', 'wire', 70)
+    expect(n).toBe(70)
+    expect(countDiff(frames, expected, golden.ledCount, n)).toBe(0)
+  })
+
+  it('maps the template UI elements to ranged Controls and merges persisted values', async () => {
+    const host = await instantiateFastLedHost(readFileSync(fixture('template64.wasm')))
+    host.init(1)
+    const controls = fastLedControlBindings(host.getUi())
+    expect(controls.map((c) => [c.exportName, c.kind, c.range, c.defaultValue])).toEqual([
+      ['sliderSpeed', 'slider', { min: 1, max: 120, step: 1 }, 30],
+      ['sliderHueDensity', 'slider', { min: 1, max: 32, step: 1 }, 7],
+      ['sliderBrightness', 'slider', { min: 0, max: 255, step: 1 }, 200],
+      ['toggleGlitter', 'toggle', undefined, 1],
+    ])
+    expect(mergePersistedControlValues(controls, { Speed: 999, Glitter: 0, Unknown: 3 })).toEqual({
+      sliderSpeed: 120, sliderHueDensity: 7, sliderBrightness: 200, toggleGlitter: 0,
+    })
+  })
+})
diff --git a/src/engine/fastled/fastledWasmHost.ts b/src/engine/fastled/fastledWasmHost.ts

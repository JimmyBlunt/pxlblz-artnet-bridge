diff --git a/scripts/generate-fastled-fixtures.mjs b/scripts/generate-fastled-fixtures.mjs
new file mode 100644
index 00000000..468f6de1
--- /dev/null
+++ b/scripts/generate-fastled-fixtures.mjs
@@ -0,0 +1,98 @@
+// Regenerates the FastLED Pattern test fixtures in src/engine/fastled/__fixtures__/:
+// one wasm module per case (built by the FastLED compile toolchain) plus a golden
+// L1/L2 dump produced by the NATIVE reference build (x86_64 FastLED, same virtual
+// frame schedule, seed and UI events). fastledPatternHandle.wasm.test.ts replays
+// the wasm through createRenderLoop and requires 0 differing bytes.
+//
+//   FASTLED_WORK=E:/PXLBLZ-ArtNet/fastled-work node scripts/generate-fastled-fixtures.mjs
+//
+// FASTLED_WORK defaults to ../fastled-work next to this checkout. It needs the
+// engine's setup/build done (zig, prebuilt libraries).
+import fs from 'node:fs'
+import path from 'node:path'
+import os from 'node:os'
+import { pathToFileURL, fileURLToPath } from 'node:url'
+
+const repo = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const work = path.resolve(process.env.FASTLED_WORK || path.join(repo, '..', 'fastled-work'))
+const { loadConfig, buildLib, compileSketch, run } = await import(pathToFileURL(path.join(work, 'toolchain', 'toolchain.mjs')).href)
+const { parseTrace } = await import(pathToFileURL(path.join(work, 'tests', 'trace.mjs')).href)
+const out = path.join(repo, 'src', 'engine', 'fastled', '__fixtures__')
+
+// The IDE frame sequence: renderPreviewFrame() (frame(0)) and then tickFrame(dt).
+const FRAME_MS = 1000 / 60
+const FRAMES = 240
+const SEED = 7
+
+// Copy of the template without importing TS: keep in sync with newFastLedPattern.ts.
+const templateSrc = fs.readFileSync(path.join(repo, 'src', 'engine', 'fastled', 'newFastLedPattern.ts'), 'utf8')
+const template = templateSrc.slice(templateSrc.indexOf('`') + 1, templateSrc.lastIndexOf('`'))
+
+const CASES = [
+  {
+    name: 'template64',
+    source: template,
+    defines: { PXLBLZ_NUM_LEDS: 64 },
+    events: { 60: { Speed: 90 }, 120: { Glitter: false }, 180: { Brightness: 77, 'Hue density': 3 } },
+  },
+  {
+    name: 'pipeline',
+    source: fs.readFileSync(path.join(work, 'tests', 'sketches', 'PipelineTest.ino'), 'utf8'),
+    defines: { PXLBLZ_NUM_LEDS: 40 },
+    events: { 100: { Speed: 120 }, 150: { Sparkle: false }, 200: { 'Hue shift': -40, Brightness: 77 } },
+  },
+]
+
+// Microsecond schedule exactly as FastLedHost.frame(dtMs) derives it.
+function schedule() {
+  const us = [0]
+  let acc = 0
+  let issued = 0
+  for (let f = 1; f < FRAMES; f++) {
+    acc += FRAME_MS
+    const whole = Math.round(acc * 1000) - issued
+    issued += whole
+    us.push(whole)
+  }
+  return Uint32Array.from(us)
+}
+
+const cfg = loadConfig()
+await buildLib(cfg, 'wasm', {})
+await buildLib(cfg, 'native', {})
+const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'pxlblz-fastled-fixtures-'))
+const sched = schedule()
+const schedFile = path.join(tmp, 'schedule.bin')
+fs.writeFileSync(schedFile, Buffer.from(sched.buffer))
+fs.mkdirSync(out, { recursive: true })
+
+for (const c of CASES) {
+  const [w, n] = await Promise.all([
+    compileSketch(cfg, { source: c.source, defines: c.defines, target: 'wasm', options: { optimize: 'full' } }),
+    compileSketch(cfg, { source: c.source, defines: c.defines, target: 'native' }),
+  ])
+  if (!w.ok || !n.ok) throw new Error(`${c.name}: compile failed ${JSON.stringify((w.ok ? n : w).diagnostics.slice(0, 3))}`)
+  const evFile = path.join(tmp, `${c.name}.events.txt`)
+  fs.writeFileSync(evFile, Object.entries(c.events).map(([f, v]) => `${f} ${JSON.stringify(v)}`).join('\n'))
+  const traceFile = path.join(tmp, `${c.name}.trace`)
+  const r = await run(n.path, [schedFile, traceFile, evFile, String(SEED), 'eager'], {})
+  if (r.code !== 0) throw new Error(`${c.name}: native run failed ${r.err}`)
+  const { frames } = parseTrace(fs.readFileSync(traceFile))
+  const ledCount = frames[0].n
+  const l1 = Buffer.concat(frames.map((fr) => fr.l1))
+  const l2 = Buffer.concat(frames.map((fr) => fr.l2))
+  fs.copyFileSync(w.path, path.join(out, `${c.name}.wasm`))
+  fs.writeFileSync(path.join(out, `${c.name}.golden.json`), JSON.stringify({
+    generator: 'scripts/generate-fastled-fixtures.mjs (native FastLED reference, eager encode)',
+    frameMs: FRAME_MS,
+    frames: FRAMES,
+    seed: SEED,
+    defines: c.defines,
+    events: c.events,
+    ledCount,
+    l1: l1.toString('base64'),
+    l2: l2.toString('base64'),
+  }) + '\n')
+  console.log(`${c.name}: ${ledCount} LEDs, ${FRAMES} frames, wasm ${w.size} bytes, L2!=L1 bytes ${l1.reduce((s, b, i) => s + (b !== l2[i] ? 1 : 0), 0)}`)
+}
+fs.rmSync(tmp, { recursive: true, force: true })

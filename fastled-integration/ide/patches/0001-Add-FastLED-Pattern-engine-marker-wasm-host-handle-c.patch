index 00000000..f139aa11
--- /dev/null
+++ b/src/engine/patternLanguage.ts
@@ -0,0 +1,68 @@
+// The language a Pattern's source is written in. A Pattern is Pixelblaze source
+// unless its leading comment block carries the FastLED marker
+// `// @pxlblz-language fastled`. The marker rides in `src`, so every save,
+// autosave, clone and navigation path keeps it without a schema change.
+//
+// A FastLED Pattern is C++ against the FastLED library. PXLBLZ-IDE compiles it
+// to wasm and renders it itself; it is never bundled, never part of a Show and
+// never sent to a Controller (see isFastLedSource call sites).
+
+export type PatternLanguage = 'pixelblaze' | 'fastled'
+export type FastLedOutput = 'wire' | 'leds'
+
+export const FASTLED_MARKER = '// @pxlblz-language fastled'
+
+const MAX_HEADER_LINES = 20
+const LANGUAGE_DIRECTIVE = /^\s*\/\/\s*@pxlblz-language\s*[:=]?\s*fastled\b/i
+const DIM_DIRECTIVE = /^\s*\/\/\s*@pxlblz-dim\s*[:=]?\s*([123])\b/i
+const OUTPUT_DIRECTIVE = /^\s*\/\/\s*@pxlblz-output\s*[:=]?\s*(wire|leds)\b/i
+const FASTLED_INCLUDE = /^\s*#\s*include\s*[<"]FastLED\.h[>"]/m
+
+// Lines of the leading comment block: blank lines and `//` comments before the
+// first other line, capped so a long license header still counts but a marker
+// buried after code never does. Block comments end the scan (rare in headers).
+function headerLines(src: string): string[] {
+  const lines: string[] = []
+  let start = 0
+  while (start <= src.length && lines.length < MAX_HEADER_LINES) {
+    const end = src.indexOf('\n', start)
+    const line = src.slice(start, end < 0 ? src.length : end)
+    const trimmed = line.trim()
+    if (trimmed !== '' && !trimmed.startsWith('//')) break
+    lines.push(line)
+    if (end < 0) break
+    start = end + 1
+  }
+  return lines
+}
+
+export function patternLanguage(src: string): PatternLanguage {
+  return headerLines(src).some((line) => LANGUAGE_DIRECTIVE.test(line)) ? 'fastled' : 'pixelblaze'
+}
+
+export function isFastLedSource(src: string | null | undefined): boolean {
+  return typeof src === 'string' && patternLanguage(src) === 'fastled'
+}
+
+/** Optional header directives of a FastLED Pattern (defaults: 1D, wire bytes). */
+export function parseFastLedDirectives(src: string): { dim: 1 | 2 | 3; output: FastLedOutput } {
+  let dim: 1 | 2 | 3 = 1
+  let output: FastLedOutput = 'wire'
+  for (const line of headerLines(src)) {
+    const d = DIM_DIRECTIVE.exec(line)
+    if (d) dim = Number(d[1]) as 1 | 2 | 3
+    const o = OUTPUT_DIRECTIVE.exec(line)
+    if (o) output = o[1].toLowerCase() as FastLedOutput
+  }
+  return { dim, output }
+}
+
+/** Hint only: C++ that includes FastLED but has no marker yet. Never applied silently. */
+export function looksLikeFastLedSource(src: string): boolean {
+  return FASTLED_INCLUDE.test(src) && !isFastLedSource(src)
+}
+
+/** Prepends the marker (the explicit "Convert to FastLED Pattern" action). */
+export function withFastLedMarker(src: string): string {
+  return isFastLedSource(src) ? src : `${FASTLED_MARKER}\n${src}`
+}

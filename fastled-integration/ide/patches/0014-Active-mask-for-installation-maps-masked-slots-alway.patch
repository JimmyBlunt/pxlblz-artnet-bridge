--- /dev/null
+++ b/src/engine/maps/activeMask.ts
@@ -0,0 +1,207 @@
+// Active mask: which slots of an installation map carry a real LED position.
+//
+// An installation map exported from TouchDesigner has one slot per routed
+// channel; slots without an LED position (TD active mask = 0) are parked at one
+// coordinate. A Pattern still runs for every slot (render functions keep their
+// index semantics and determinism), but masked slots always output black, are
+// not drawn in the preview and do not count towards a FastLED surface fit.
+//
+// Stored on the map record in `importMetadata.activeMask` (no schema change):
+//
+//   { version: 1, encoding: 'rle01', count: 10330, first: 1,
+//     runs: [120, 4, 300, ...], active: 6962,
+//     source: 'touchdesigner', fingerprint: 'fnv1a32:1a2b3c4d' }
+//
+// `runs` are alternating run lengths starting with value `first` and must sum to
+// `count`. `active` and `fingerprint` (FNV-1a over the 0/1 bytes) are redundant
+// checks. A mask whose `count` differs from the map's point count is ignored
+// (all slots active) with a warning.
+
+export interface MapActiveMask {
+  version: 1
+  encoding: 'rle01'
+  /** Number of map slots the mask covers; must equal the map's point count. */
+  count: number
+  /** Value (0 or 1) of the first run. */
+  first: 0 | 1
+  /** Alternating run lengths starting with `first`; positive integers summing to `count`. */
+  runs: number[]
+  /** Number of active (1) slots. */
+  active: number
+  /** Where the mask came from, e.g. 'touchdesigner'. */
+  source?: string
+  /** `fnv1a32:<hex8>` over the decoded 0/1 bytes. */
+  fingerprint?: string
+  updatedAt?: number
+}
+
+export interface ResolvedActiveMask {
+  /** 1 = real LED position, 0 = masked (always black). Length = map point count. */
+  bits: Uint8Array
+  active: number
+  masked: number
+}
+
+export type ActiveMaskResult =
+  | { status: 'none' }
+  | { status: 'ok'; mask: ResolvedActiveMask }
+  | { status: 'invalid'; warning: string }
+
+/** FNV-1a (32 bit) over 0/1 bytes, as `fnv1a32:<hex8>`. */
+export function activeMaskFingerprint(bits: ArrayLike<number>): string {
+  let h = 0x811c9dc5
+  for (let i = 0; i < bits.length; i++) {
+    h ^= bits[i] ? 1 : 0
+    h = Math.imul(h, 0x01000193)
+  }
+  return `fnv1a32:${(h >>> 0).toString(16).padStart(8, '0')}`
+}
+
+/** Encodes a 0/1 array (any truthy value counts as 1) as an `rle01` mask. */
+export function encodeActiveMask(
+  bits: ArrayLike<number | boolean>,
+  extra: { source?: string; updatedAt?: number } = {},
+): MapActiveMask {
+  const count = bits.length
+  if (count === 0) throw new Error('active mask needs at least one slot')
+  const norm = new Uint8Array(count)
+  for (let i = 0; i < count; i++) norm[i] = bits[i] ? 1 : 0
+  const runs: number[] = []
+  let current = norm[0]
+  let length = 0
+  let active = 0
+  for (let i = 0; i < count; i++) {
+    if (norm[i]) active++
+    if (norm[i] === current) {
+      length++
+    } else {
+      runs.push(length)
+      current = norm[i]
+      length = 1
+    }
+  }
+  runs.push(length)
+  return {
+    version: 1,
+    encoding: 'rle01',
+    count,
+    first: norm[0] as 0 | 1,
+    runs,
+    active,
+    ...(extra.source ? { source: extra.source } : {}),
+    fingerprint: activeMaskFingerprint(norm),
+    ...(extra.updatedAt !== undefined ? { updatedAt: extra.updatedAt } : {}),
+  }
+}
+
+/** Decodes an `rle01` mask without checking it against a map; throws on malformed data. */
+export function decodeActiveMask(mask: MapActiveMask): Uint8Array {
+  if (!mask || typeof mask !== 'object') throw new Error('active mask is not an object')
+  if (mask.version !== 1) throw new Error(`unsupported active mask version ${String(mask.version)}`)
+  if (mask.encoding !== 'rle01') throw new Error(`unsupported active mask encoding ${String(mask.encoding)}`)
+  if (!Number.isInteger(mask.count) || mask.count <= 0) throw new Error('active mask count must be a positive integer')
+  if (mask.first !== 0 && mask.first !== 1) throw new Error('active mask first must be 0 or 1')
+  if (!Array.isArray(mask.runs) || mask.runs.length === 0) throw new Error('active mask runs are missing')
+  const bits = new Uint8Array(mask.count)
+  let offset = 0
+  let value: number = mask.first
+  for (const run of mask.runs) {
+    if (!Number.isInteger(run) || run <= 0) throw new Error('active mask runs must be positive integers')
+    if (offset + run > mask.count) throw new Error(`active mask runs exceed count ${mask.count}`)
+    if (value) bits.fill(1, offset, offset + run)
+    offset += run
+    value ^= 1
+  }
+  if (offset !== mask.count) throw new Error(`active mask runs cover ${offset} of ${mask.count} slots`)
+  if (mask.fingerprint !== undefined && mask.fingerprint !== activeMaskFingerprint(bits)) {
+    throw new Error('active mask fingerprint does not match its runs')
+  }
+  if (mask.active !== undefined) {
+    let active = 0
+    for (let i = 0; i < bits.length; i++) active += bits[i]
+    if (active !== mask.active) throw new Error(`active mask says ${mask.active} active slots, runs give ${active}`)
+  }
+  return bits
+}
+
+/**
+ * The active mask stored on a map record (`importMetadata.activeMask`), checked
+ * against the map's point count. Absent → `none`; malformed or wrong length →
+ * `invalid` with a warning (callers then treat every slot as active).
+ */
+export function resolveActiveMask(
+  metadata: { activeMask?: unknown } | null | undefined,
+  pointCount: number,
+): ActiveMaskResult {
+  const raw = metadata && typeof metadata === 'object' ? metadata.activeMask : undefined
+  if (raw === undefined || raw === null) return { status: 'none' }
+  let bits: Uint8Array
+  try {
+    bits = decodeActiveMask(raw as MapActiveMask)
+  } catch (err) {
+    return { status: 'invalid', warning: `Maske ignoriert: ${err instanceof Error ? err.message : String(err)}` }
+  }
+  if (bits.length !== pointCount) {
+    return { status: 'invalid', warning: `Maske ignoriert: ${bits.length} Einträge, Map hat ${pointCount} Punkte` }
+  }
+  let active = 0
+  for (let i = 0; i < bits.length; i++) active += bits[i]
+  return { status: 'ok', mask: { bits, active, masked: bits.length - active } }
+}
+
+/**
+ * The per-pixel mask for a resolved layout of `pixelCount` pixels: slots past the
+ * mask's end (a custom map replayed at a larger count) stay active. Null when
+ * nothing is masked.
+ */
+export function activeMaskForPixelCount(mask: ResolvedActiveMask | null | undefined, pixelCount: number): Uint8Array | null {
+  if (!mask || mask.masked === 0) return null
+  const out = new Uint8Array(pixelCount).fill(1)
+  out.set(mask.bits.subarray(0, Math.min(pixelCount, mask.bits.length)))
+  for (let i = 0; i < out.length; i++) if (out[i] === 0) return out
+  return null
+}
+
+/** "6.962 aktiv / 3.368 ausgeblendet" (German digit grouping, locale-independent). */
+export function formatActiveMaskSummary(active: number, masked: number): string {
+  return `${groupDigits(active)} aktiv / ${groupDigits(masked)} ausgeblendet`
+}
+
+function groupDigits(n: number): string {
+  return String(Math.trunc(n)).replace(/\B(?=(\d{3})+(?!\d))/g, '.')
+}
+
+/** Forces masked pixels of a packed RGB frame (3 values per pixel) to black. */
+export function blackMaskedPacked(frame: Float64Array | Float32Array, mask: Uint8Array | null): void {
+  if (!mask) return
+  const n = Math.min(mask.length, Math.floor(frame.length / 3))
+  for (let i = 0; i < n; i++) {
+    if (mask[i]) continue
+    const o = i * 3
+    frame[o] = 0
+    frame[o + 1] = 0
+    frame[o + 2] = 0
+  }
+}
+
+/** Indices of active pixels (the preview draws only these). */
+export function activeIndices(mask: Uint8Array): Uint32Array {
+  let n = 0
+  for (let i = 0; i < mask.length; i++) n += mask[i] ? 1 : 0
+  const out = new Uint32Array(n)
+  let k = 0
+  for (let i = 0; i < mask.length; i++) if (mask[i]) out[k++] = i
+  return out
+}
+
+/** Copies the active pixels of a packed frame into `out` (3 values per active index). */
+export function compactPacked(frame: Float64Array, indices: Uint32Array, out: Float64Array): Float64Array {
+  for (let k = 0; k < indices.length; k++) {
+    const s = indices[k] * 3
+    const d = k * 3
+    out[d] = frame[s]
+    out[d + 1] = frame[s + 1]
+    out[d + 2] = frame[s + 2]
+  }
+  return out
+}

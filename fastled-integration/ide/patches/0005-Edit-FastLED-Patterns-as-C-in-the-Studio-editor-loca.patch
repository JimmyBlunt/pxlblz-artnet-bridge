+import { describe, expect, it } from 'vitest'
+import { fastLedCompletionContext, resolveFastLedHover } from './fastledProviders'
+import { FASTLED_API, FASTLED_GLOBAL_API } from '@/engine/fastled/fastledApiCatalog'
+
+describe('FastLED completion and hover', () => {
+  it('picks the member list from the text before the cursor', () => {
+    expect(fastLedCompletionContext('  FastLED.')).toBe('FastLED')
+    expect(fastLedCompletionContext('  FastLED.setB')).toBe('FastLED')
+    expect(fastLedCompletionContext('  leds[i] = CRGB::')).toBe('CRGB-colour')
+    expect(fastLedCompletionContext('  leds[i].')).toBe('member')
+    expect(fastLedCompletionContext('  speed.val')).toBe('member')
+    expect(fastLedCompletionContext('  fill_')).toBeNull()
+  })
+
+  it('resolves hovers in their context', () => {
+    expect(resolveFastLedHover('  FastLED.', 'show')?.signature).toBe('void FastLED.show()')
+    expect(resolveFastLedHover('  leds[0] = CRGB::', 'Red')?.signature).toBe('CRGB::Red')
+    expect(resolveFastLedHover('  x = ', 'beatsin8')?.kind).toBe('function')
+    expect(resolveFastLedHover('  speed.', 'value')?.owner).toBe('UI')
+    expect(resolveFastLedHover('', 'notAnApi')).toBeUndefined()
+  })
+
+  it('keeps a catalogue of unique, documented entries', () => {
+    expect(FASTLED_API.length).toBeGreaterThan(150)
+    const keys = FASTLED_API.map((e) => `${e.owner ?? ''}:${e.name}`)
+    expect(new Set(keys).size).toBe(keys.length)
+    expect(FASTLED_API.every((e) => e.doc.length > 0 && e.signature.length > 0)).toBe(true)
+    expect(FASTLED_GLOBAL_API.some((e) => e.name === 'UISlider')).toBe(true)
+    expect(FASTLED_GLOBAL_API.some((e) => e.owner)).toBe(false)
+  })
+})
diff --git a/src/components/monaco/fastledProviders.ts b/src/components/monaco/fastledProviders.ts
new file mode 100644
index 00000000..b0c23bc0
--- /dev/null
+++ b/src/components/monaco/fastledProviders.ts
@@ -0,0 +1,100 @@
+import type * as monacoType from 'monaco-editor'
+import {
+  FASTLED_GLOBAL_API,
+  fastLedMembers,
+  findFastLedApi,
+  type FastLedApiEntry,
+} from '@/engine/fastled/fastledApiCatalog'
+
+// FastLED Patterns edit in Monaco's built-in `cpp` language; these providers add
+// completion and hover from the static FastLED catalogue. Registered once.
+export const FASTLED_MONACO_LANGUAGE = 'cpp'
+
+let registered = false
+
+type MemberContext = 'FastLED' | 'CRGB-colour' | 'member' | null
+
+/** Which completion list applies at the end of `textBefore` (line text up to the cursor). */
+export function fastLedCompletionContext(textBefore: string): MemberContext {
+  if (/\bFastLED\s*\.\s*\w*$/.test(textBefore)) return 'FastLED'
+  if (/\bCRGB\s*::\s*\w*$/.test(textBefore)) return 'CRGB-colour'
+  if (/(\]|\b[A-Za-z_]\w*)\s*\.\s*\w*$/.test(textBefore)) return 'member'
+  return null
+}
+
+/** The catalogue entry a hover over `word` resolves to, given the text before it. */
+export function resolveFastLedHover(textBefore: string, word: string): FastLedApiEntry | undefined {
+  if (/\bFastLED\s*\.\s*$/.test(textBefore)) return findFastLedApi(word, 'FastLED')
+  if (/\bCRGB\s*::\s*$/.test(textBefore)) return findFastLedApi(word, 'CRGB')
+  if (/\.\s*$/.test(textBefore)) return findFastLedApi(word, 'CRGB') ?? findFastLedApi(word, 'UI')
+  return findFastLedApi(word)
+}
+
+function completionKind(monaco: typeof monacoType, entry: FastLedApiEntry): monacoType.languages.CompletionItemKind {
+  const k = monaco.languages.CompletionItemKind
+  switch (entry.kind) {
+    case 'function': return k.Function
+    case 'method': return entry.signature.includes('(') ? k.Method : k.Field
+    case 'macro': return k.Snippet
+    case 'type': return k.Class
+    case 'keyword': return k.Keyword
+    default: return k.Constant
+  }
+}
+
+export function registerFastLedProviders(monaco: typeof monacoType): void {
+  if (registered) return
+  registered = true
+
+  monaco.languages.registerCompletionItemProvider(FASTLED_MONACO_LANGUAGE, {
+    triggerCharacters: ['.', ':'],
+    provideCompletionItems(model, position) {
+      const word = model.getWordUntilPosition(position)
+      const range: monacoType.IRange = {
+        startLineNumber: position.lineNumber,
+        endLineNumber: position.lineNumber,
+        startColumn: word.startColumn,
+        endColumn: word.endColumn,
+      }
+      const textBefore = model.getLineContent(position.lineNumber).slice(0, position.column - 1)
+      const context = fastLedCompletionContext(textBefore)
+      const entries = context === 'FastLED'
+        ? fastLedMembers('FastLED')
+        : context === 'CRGB-colour'
+          ? fastLedMembers('CRGB').filter((e) => e.kind === 'constant')
+          : context === 'member'
+            ? [...fastLedMembers('CRGB').filter((e) => e.kind === 'method'), ...fastLedMembers('UI')]
+            : FASTLED_GLOBAL_API
+      return {
+        suggestions: entries.map((entry) => ({
+          label: entry.name,
+          kind: completionKind(monaco, entry),
+          detail: entry.signature,
+          documentation: { value: entry.doc },
+          insertText: entry.insert ?? entry.name,
+          insertTextRules: entry.insert && entry.insert.includes('$')
+            ? monaco.languages.CompletionItemInsertTextRule.InsertAsSnippet
+            : undefined,
+          range,
+        })),
+      }
+    },
+  })
+
+  monaco.languages.registerHoverProvider(FASTLED_MONACO_LANGUAGE, {
+    provideHover(model, position) {
+      const word = model.getWordAtPosition(position)
+      if (!word) return null
+      const textBefore = model.getLineContent(position.lineNumber).slice(0, word.startColumn - 1)
+      const entry = resolveFastLedHover(textBefore, word.word)
+      if (!entry) return null
+      return {
+        range: new monaco.Range(position.lineNumber, word.startColumn, position.lineNumber, word.endColumn),
+        contents: [
+          { value: `\`\`\`cpp\n${entry.signature}\n\`\`\`` },
+          { value: entry.doc },
+        ],
+      }
+    },
+  })
+}

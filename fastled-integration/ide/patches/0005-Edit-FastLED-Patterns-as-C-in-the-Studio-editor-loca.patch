--- /dev/null
+++ b/src/engine/fastled/fastledApiCatalog.ts
@@ -0,0 +1,204 @@
+// Static FastLED API catalogue for completion and hover in FastLED Patterns.
+// Curated by hand from FastLED 3.10 (the version the compile service pins);
+// not exhaustive, it covers what Patterns use day to day. `owner` scopes a
+// member: 'FastLED' for `FastLED.x`, 'CRGB' for `leds[i].x` / colour values,
+// 'UI' for `mySlider.x`.
+
+export type FastLedApiKind = 'function' | 'macro' | 'type' | 'constant' | 'method' | 'keyword'
+
+export interface FastLedApiEntry {
+  name: string
+  kind: FastLedApiKind
+  signature: string
+  doc: string
+  owner?: 'FastLED' | 'CRGB' | 'UI'
+  /** Snippet body for completion (Monaco snippet syntax); defaults to name. */
+  insert?: string
+}
+
+const fn = (name: string, params: string, doc: string, ret = 'void'): FastLedApiEntry => ({
+  name,
+  kind: 'function',
+  signature: `${ret} ${name}(${params})`,
+  doc,
+  insert: params ? `${name}(${params.split(',').map((p, i) => `\${${i + 1}:${p.trim().split(/\s+/).pop()!.replace(/[[\]=].*$/, '')}}`).join(', ')})` : `${name}()`,
+})
+const constant = (name: string, doc: string, type = 'const'): FastLedApiEntry => ({ name, kind: 'constant', signature: `${type} ${name}`, doc })
+const member = (owner: 'FastLED' | 'CRGB' | 'UI', name: string, params: string, doc: string, ret = 'void'): FastLedApiEntry => ({
+  ...fn(name, params, doc, ret),
+  kind: 'method',
+  owner,

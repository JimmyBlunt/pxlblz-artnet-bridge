+  return FASTLED_API.filter((e) => e.owner === owner)
+}
+
+export function findFastLedApi(word: string, owner?: 'FastLED' | 'CRGB' | 'UI'): FastLedApiEntry | undefined {
+  if (owner) {
+    const scoped = FASTLED_API.find((e) => e.owner === owner && e.name === word)
+    if (scoped) return scoped
+  }
+  return FASTLED_API.find((e) => !e.owner && e.name === word) ?? FASTLED_API.find((e) => e.name === word)
+}

+import { act, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { Editor } from './Editor'
+import { editorInitialState, useEditorStore } from '@/store/editorStore'
+import { patternInitialState, usePatternStore } from '@/store/patternStore'
+import { __resetFastLedStoreForTests, useFastLedStore } from '@/store/fastledStore'
+import { FASTLED_MARKER } from '@/engine/patternLanguage'
+
+const markers = vi.hoisted(() => ({ calls: [] as Array<{ owner: string; markers: Array<{ message: string; startLineNumber: number; startColumn: number; severity: number }> }> }))
+const languages = vi.hoisted(() => ({ last: '' }))
+
+vi.mock('@/components/PixelblazeCodeEditor', () => ({
+  PixelblazeCodeEditor: ({ value, language, onChange, onMount }: {
+    value: string
+    language?: string
+    onChange?: (value: string) => void
+    onMount?: (editor: unknown, monaco: unknown) => void
+  }) => {
+    languages.last = language ?? 'pixelblaze'
+    onMount?.(
+      { getModel: () => ({ getLineMaxColumn: () => 40, getLineCount: () => 10 }) },
+      {
+        editor: { setModelMarkers: (_model: unknown, owner: string, list: typeof markers.calls[number]['markers']) => markers.calls.push({ owner, markers: list }) },
+        MarkerSeverity: { Error: 8, Warning: 4, Info: 2 },
+      },
+    )
+    return <textarea aria-label="Pattern source" value={value} onChange={(event) => onChange?.(event.target.value)} />
+  },
+}))
+
+const FASTLED = `${FASTLED_MARKER}\n#include <FastLED.h>\nvoid setup() {}\nvoid loop() {}\n`
+const CPP = '#include <FastLED.h>\nCRGB leds[8];\nvoid loop() {}\n'
+
+beforeEach(() => {
+  __resetFastLedStoreForTests()
+  markers.calls = []
+  usePatternStore.setState({ ...patternInitialState, activePatternId: 'p1' })
+  useEditorStore.setState({ ...editorInitialState, editorFlavor: 'pattern', isReadOnly: false })
+})
+
+afterEach(() => {
+  vi.restoreAllMocks()
+})
+
+describe('Editor with FastLED Patterns', () => {
+  it('edits FastLED source as C++, skips the Pixelblaze validator and requests a compile', () => {
+    const requestCompile = vi.spyOn(useFastLedStore.getState(), 'requestCompile')
+    useEditorStore.setState({ source: FASTLED, previewSource: 'older', compileStatus: 'good' })
+    render(<Editor />)
+    expect(languages.last).toBe('fastled')
+    expect(useEditorStore.getState().compileStatus).toBe('good')
+    expect(requestCompile).toHaveBeenCalledWith(FASTLED)
+    expect(markers.calls.some((c) => c.owner === 'pixelblaze' && c.markers.length === 0)).toBe(true)
+  })
+
+  it('writes compiler diagnostics for the exact buffer as fastled markers', () => {
+    useEditorStore.setState({ source: FASTLED, previewSource: FASTLED })
+    render(<Editor />)
+    act(() => {
+      useFastLedStore.setState({
+        diagnosticsSource: FASTLED,
+        diagnostics: [{ line: 4, column: 13, severity: 'error', message: "use of undeclared identifier 'x'" }],
+      })
+    })
+    const last = markers.calls.filter((c) => c.owner === 'fastled').pop()
+    expect(last?.markers).toEqual([expect.objectContaining({ message: "use of undeclared identifier 'x'", startLineNumber: 4, startColumn: 13, severity: 8 })])
+  })
+
+  it('offers an explicit conversion for unmarked FastLED C++', () => {
+    useEditorStore.setState({ source: CPP })
+    render(<Editor />)
+    expect(languages.last).toBe('pixelblaze')
+    fireEvent.click(screen.getByRole('button', { name: 'Convert to FastLED Pattern' }))
+    expect(useEditorStore.getState().source).toBe(`${FASTLED_MARKER}\n${CPP}`)
+    expect(screen.queryByTestId('fastled-convert-offer')).not.toBeInTheDocument()
+    expect(languages.last).toBe('fastled')
+  })
+
+  it('never publishes a FastLED buffer from the Pixelblaze debounce', () => {
+    vi.useFakeTimers()
+    try {
+      useEditorStore.setState({ source: FASTLED, previewSource: FASTLED, compileStatus: 'good' })
+      render(<Editor />)
+      const edited = `${FASTLED}// tweak\n`
+      fireEvent.change(screen.getByLabelText('Pattern source'), { target: { value: edited } })
+      act(() => { vi.advanceTimersByTime(1000) })
+      expect(useEditorStore.getState().previewSource).toBe(FASTLED)
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+})

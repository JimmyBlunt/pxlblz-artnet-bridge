+import { describe, expect, it, vi } from 'vitest'
+import {
+  base64ToBytes,
+  checkFastLedService,
+  compileFastLed,
+  DEFAULT_FASTLED_SERVICE_URL,
+  FastLedServiceOfflineError,
+  fastLedServiceUrl,
+  normalizeFastLedDiagnostics,
+} from './fastledCompileClient'
+
+const json = (body: unknown, status = 200) => new Response(JSON.stringify(body), { status, headers: { 'content-type': 'application/json' } })
+
+describe('compileFastLed', () => {
+  it('posts source and defines and decodes the base64 wasm', async () => {
+    const fetch = vi.fn(async () => json({ ok: true, key: 'k1', cached: true, wasm: btoa('\0asm'), diagnostics: [] }))
+    const result = await compileFastLed({ source: 'x', defines: { PXLBLZ_NUM_LEDS: 12 } }, { baseUrl: 'http://svc', fetch })
+    expect(fetch).toHaveBeenCalledWith('http://svc/compile', expect.objectContaining({ method: 'POST' }))
+    const init = (fetch.mock.calls[0] as unknown as [string, RequestInit])[1]
+    expect(JSON.parse(init.body as string)).toEqual({ source: 'x', defines: { PXLBLZ_NUM_LEDS: 12 } })
+    expect(result).toMatchObject({ ok: true, key: 'k1', cached: true })
+    expect(result.ok && Array.from(result.wasm)).toEqual([0, 0x61, 0x73, 0x6d])
+  })
+
+  it('returns normalised diagnostics and a first-error message on failure', async () => {
+    const fetch = vi.fn(async () => json({
+      ok: false,
+      diagnostics: [
+        { file: 'sketch.ino', line: 10, col: 32, severity: 'error', message: "use of undeclared identifier 'hue'", inSketch: true },
+        { file: 'FastLED.h', line: 3, col: 1, severity: 'warning', message: 'deprecated', inSketch: false },
+      ],
+    }))
+    const result = await compileFastLed({ source: 'x', defines: {} }, { baseUrl: 'http://svc', fetch })
+    expect(result).toEqual({
+      ok: false,
+      message: "Line 10: use of undeclared identifier 'hue'",
+      diagnostics: [
+        { line: 10, column: 32, severity: 'error', message: "use of undeclared identifier 'hue'" },
+        { line: 1, column: 1, severity: 'warning', message: 'FastLED.h:3: deprecated' },
+      ],
+    })
+  })
+
+  it('classifies a rejected fetch as offline and passes aborts through', async () => {
+    await expect(compileFastLed({ source: 'x', defines: {} }, {
+      baseUrl: 'http://svc', fetch: async () => { throw new TypeError('Failed to fetch') },
+    })).rejects.toBeInstanceOf(FastLedServiceOfflineError)
+    const abort = new DOMException('aborted', 'AbortError')
+    await expect(compileFastLed({ source: 'x', defines: {} }, {
+      baseUrl: 'http://svc', fetch: async () => { throw abort },
+    })).rejects.toBe(abort)
+  })
+
+  it('reports a non-JSON answer as a compile failure', async () => {
+    const result = await compileFastLed({ source: 'x', defines: {} }, { baseUrl: 'http://svc', fetch: async () => new Response('oops', { status: 502 }) })
+    expect(result).toMatchObject({ ok: false, message: expect.stringContaining('HTTP 502') })
+  })
+})
+
+describe('service URL and health', () => {
+  it('defaults to the local service and accepts ?fastledService=', () => {
+    const mem = new Map<string, string>()
+    vi.stubGlobal('sessionStorage', {
+      getItem: (k: string) => mem.get(k) ?? null,
+      setItem: (k: string, v: string) => { mem.set(k, v) },
+      removeItem: (k: string) => { mem.delete(k) },
+    })
+    expect(fastLedServiceUrl('')).toBe(DEFAULT_FASTLED_SERVICE_URL)
+    expect(fastLedServiceUrl('?fastledService=http://127.0.0.1:9999/')).toBe('http://127.0.0.1:9999')
+    // Remembered for the session.
+    expect(fastLedServiceUrl('')).toBe('http://127.0.0.1:9999')
+    expect(fastLedServiceUrl('?fastledService=javascript:alert(1)')).toBe('http://127.0.0.1:9999')
+    vi.unstubAllGlobals()
+  })
+
+  it('probes /health', async () => {
+    expect(await checkFastLedService({ baseUrl: 'http://svc', fetch: async () => json({ ok: true }) })).toBe(true)
+    expect(await checkFastLedService({ baseUrl: 'http://svc', fetch: async () => { throw new TypeError('x') } })).toBe(false)
+  })
+})
+
+describe('helpers', () => {
+  it('drops malformed diagnostics and clamps positions', () => {
+    expect(normalizeFastLedDiagnostics([null, { message: '' }, { line: 0, message: 'm', severity: 'fatal' }, { line: 4, message: 'n', severity: 'note' }])).toEqual([
+      { line: 1, column: 1, severity: 'error', message: 'm' },
+      { line: 4, column: 1, severity: 'info', message: 'n' },
+    ])
+    expect(normalizeFastLedDiagnostics('nope')).toEqual([])
+  })
+
+  it('decodes base64', () => {
+    expect(Array.from(base64ToBytes(btoa('AB')))).toEqual([65, 66])
+  })
+})
diff --git a/src/engine/fastled/fastledCompileClient.ts b/src/engine/fastled/fastledCompileClient.ts
new file mode 100644
index 00000000..8906edb5
--- /dev/null
+++ b/src/engine/fastled/fastledCompileClient.ts
@@ -0,0 +1,156 @@
+// Client for the local FastLED compile service (fastled-integration
+// service/server.mjs, default http://127.0.0.1:9996). The service turns a
+// FastLED Pattern's C++ into a wasm module; PXLBLZ-IDE never compiles C++ itself.
+//
+// The URL can be overridden per tab with `?fastledService=<url>` (kept in
+// sessionStorage like the other session preferences).
+
+export const DEFAULT_FASTLED_SERVICE_URL = 'http://127.0.0.1:9996'
+const SESSION_KEY = 'pxlblz.fastledService'
+
+export type FastLedDefines = Record<string, number | string | boolean>
+
+export interface FastLedDiagnostic {
+  /** 1-based line in the Pattern source. */
+  line: number
+  /** 1-based column. */
+  column: number
+  severity: 'error' | 'warning' | 'info'
+  message: string
+}
+
+export type FastLedCompileResult =
+  | { ok: true; wasm: Uint8Array; key: string | null; cached: boolean; diagnostics: FastLedDiagnostic[] }
+  | { ok: false; diagnostics: FastLedDiagnostic[]; message: string }
+
+/** The service could not be reached (not started, wrong port, CORS refusal). */
+export class FastLedServiceOfflineError extends Error {
+  readonly url: string
+  constructor(url: string, cause?: unknown) {
+    super(`FastLED compile service not reachable at ${url}`)
+    this.name = 'FastLedServiceOfflineError'
+    this.url = url
+    if (cause !== undefined) (this as { cause?: unknown }).cause = cause
+  }
+}
+
+function sessionStore(): Storage | null {
+  try {
+    return typeof sessionStorage === 'undefined' ? null : sessionStorage
+  } catch {
+    return null
+  }
+}
+
+export function fastLedServiceUrl(search: string = typeof location === 'undefined' ? '' : location.search): string {
+  const store = sessionStore()
+  try {
+    const fromQuery = new URLSearchParams(search).get('fastledService')
+    if (fromQuery && /^https?:\/\//i.test(fromQuery)) {
+      store?.setItem(SESSION_KEY, fromQuery)
+      return fromQuery.replace(/\/+$/, '')
+    }
+  } catch {
+    // Malformed query: fall through to the stored or default URL.
+  }
+  const stored = store?.getItem(SESSION_KEY)
+  return (stored && /^https?:\/\//i.test(stored) ? stored : DEFAULT_FASTLED_SERVICE_URL).replace(/\/+$/, '')
+}
+
+function severity(value: unknown): FastLedDiagnostic['severity'] {
+  const s = String(value ?? '').toLowerCase()
+  return s.startsWith('err') || s === 'fatal' ? 'error' : s.startsWith('warn') ? 'warning' : 'info'
+}
+
+/**
+ * Service diagnostics ({file, line, col, severity, message}) → editor markers.
+ * The service already maps lines to the Pattern; anything located elsewhere
+ * (a FastLED header) lands on line 1 with its file:line prefixed.
+ */
+export function normalizeFastLedDiagnostics(raw: unknown): FastLedDiagnostic[] {
+  if (!Array.isArray(raw)) return []
+  return raw.flatMap((d): FastLedDiagnostic[] => {
+    if (!d || typeof d !== 'object') return []
+    const r = d as Record<string, unknown>
+    const message = String(r.message ?? '').trim()
+    if (!message) return []
+    const file = typeof r.file === 'string' ? r.file : ''
+    const line = Number(r.line)
+    const col = Number(r.col ?? r.column)
+    const inSketch = typeof r.inSketch === 'boolean' ? r.inSketch : file === '' || /^sketch\.(ino|cpp)$/i.test(file)
+    if (!inSketch || !(line >= 1)) {
+      return [{
+        line: 1,
+        column: 1,
+        severity: severity(r.severity),
+        message: file && line >= 1 ? `${file}:${line}: ${message}` : message,
+      }]
+    }
+    return [{ line: Math.floor(line), column: col >= 1 ? Math.floor(col) : 1, severity: severity(r.severity), message }]
+  })
+}
+
+export function base64ToBytes(b64: string): Uint8Array {
+  const bin = atob(b64)
+  const out = new Uint8Array(bin.length)
+  for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i)
+  return out
+}
+
+type FetchLike = (input: string, init?: RequestInit) => Promise<Response>
+
+export async function compileFastLed(
+  request: { source: string; defines: FastLedDefines },
+  options: { signal?: AbortSignal; baseUrl?: string; fetch?: FetchLike } = {},
+): Promise<FastLedCompileResult> {
+  const baseUrl = options.baseUrl ?? fastLedServiceUrl()
+  const doFetch: FetchLike = options.fetch ?? ((input, init) => fetch(input, init))
+  let res: Response
+  try {
+    res = await doFetch(`${baseUrl}/compile`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json', accept: 'application/json' },
+      body: JSON.stringify({ source: request.source, defines: request.defines }),
+      signal: options.signal,
+    })
+  } catch (err) {
+    if (err instanceof DOMException && err.name === 'AbortError') throw err
+    if (err instanceof Error && err.name === 'AbortError') throw err
+    throw new FastLedServiceOfflineError(baseUrl, err)
+  }
+  let body: Record<string, unknown>
+  try {
+    body = (await res.json()) as Record<string, unknown>
+  } catch {
+    return { ok: false, diagnostics: [], message: `FastLED compile service answered HTTP ${res.status} without JSON` }
+  }
+  const diagnostics = normalizeFastLedDiagnostics(body.diagnostics)
+  if (body.ok === true && typeof body.wasm === 'string') {
+    return {
+      ok: true,
+      wasm: base64ToBytes(body.wasm),
+      key: typeof body.key === 'string' ? body.key : null,
+      cached: body.cached === true,
+      diagnostics,
+    }
+  }
+  const firstError = diagnostics.find((d) => d.severity === 'error')
+  const message = typeof body.error === 'string' && body.error
+    ? body.error
+    : firstError
+      ? `Line ${firstError.line}: ${firstError.message}`
+      : `FastLED compile failed (HTTP ${res.status})`
+  return { ok: false, diagnostics, message }
+}
+
+/** True when GET /health answers; used for the offline retry probe. */
+export async function checkFastLedService(options: { baseUrl?: string; fetch?: FetchLike; signal?: AbortSignal } = {}): Promise<boolean> {
+  const baseUrl = options.baseUrl ?? fastLedServiceUrl()
+  const doFetch: FetchLike = options.fetch ?? ((input, init) => fetch(input, init))
+  try {
+    const res = await doFetch(`${baseUrl}/health`, { signal: options.signal })
+    return res.ok
+  } catch {
+    return false
+  }
+}
diff --git a/src/store/fastledStore.test.ts b/src/store/fastledStore.test.ts

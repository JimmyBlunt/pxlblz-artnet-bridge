index 00000000..c67a0b97
--- /dev/null
+++ b/src/engine/fastled/fastledArtifactCache.ts
@@ -0,0 +1,46 @@
+// Compiled FastLED Pattern artifacts, keyed by (source, defines). A small LRU:
+// editing produces one entry per compiled buffer, a pixel-count change one per
+// map size. Failed compiles are cached too, so an unchanged broken source does
+// not hit the service again.
+import type { FastLedDefines, FastLedDiagnostic } from './fastledCompileClient'
+
+export type FastLedArtifact =
+  | { ok: true; module: WebAssembly.Module; diagnostics: FastLedDiagnostic[] }
+  | { ok: false; message: string; diagnostics: FastLedDiagnostic[] }
+
+const MAX_ENTRIES = 16
+
+export function fastLedArtifactKey(source: string, defines: FastLedDefines): string {
+  const sorted = Object.keys(defines).sort().map((k) => [k, defines[k]])
+  return JSON.stringify([source, sorted])
+}
+
+export function createFastLedArtifactCache(maxEntries = MAX_ENTRIES) {
+  const entries = new Map<string, FastLedArtifact>()
+  return {
+    get(source: string, defines: FastLedDefines): FastLedArtifact | undefined {
+      const key = fastLedArtifactKey(source, defines)
+      const hit = entries.get(key)
+      if (hit) {
+        // Refresh recency.
+        entries.delete(key)
+        entries.set(key, hit)
+      }
+      return hit
+    },
+    set(source: string, defines: FastLedDefines, artifact: FastLedArtifact): void {
+      const key = fastLedArtifactKey(source, defines)
+      entries.delete(key)
+      entries.set(key, artifact)
+      while (entries.size > maxEntries) entries.delete(entries.keys().next().value as string)
+    },
+    clear(): void {
+      entries.clear()
+    },
+    get size(): number {
+      return entries.size
+    },
+  }
+}
+
+export type FastLedArtifactCache = ReturnType<typeof createFastLedArtifactCache>

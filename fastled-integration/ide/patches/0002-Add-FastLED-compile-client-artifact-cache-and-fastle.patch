+// Async compilation of FastLED Patterns through the local compile service.
+//
+// Publication rule (mirrors the Pixelblaze debounce in Editor.tsx): only a
+// successful compile of the *still current* buffer of the *same* Pattern
+// publishes previewSource and sets compileStatus 'good'; a failed compile sets
+// 'broken' and never replaces the running preview, so "last working preview"
+// behaves exactly as for Pixelblaze. Reopening a saved FastLED Pattern that does
+// not compile makes the preview explicitly unavailable (#818 rule).
+//
+// When the service is not reachable, compileStatus is left alone (autosave keeps
+// working), serviceStatus turns 'offline' and the latest request retries with
+// backoff until the service answers.
+import { create } from 'zustand'
+import { useEditorStore } from './editorStore'
+import { usePatternStore } from './patternStore'
+import { isFastLedSource } from '@/engine/patternLanguage'
+import {
+  compileFastLed,
+  FastLedServiceOfflineError,
+  fastLedServiceUrl,
+  type FastLedDefines,
+  type FastLedDiagnostic,
+} from '@/engine/fastled/fastledCompileClient'
+import {
+  createFastLedArtifactCache,
+  fastLedArtifactKey,
+  type FastLedArtifact,
+} from '@/engine/fastled/fastledArtifactCache'
+
+export type FastLedServiceStatus = 'unknown' | 'online' | 'offline'
+
+export const FASTLED_EDIT_DEBOUNCE_MS = 700
+const RETRY_MIN_MS = 2000
+const RETRY_MAX_MS = 15000
+
+interface FastLedState {
+  serviceStatus: FastLedServiceStatus
+  serviceUrl: string
+  /** Source of the newest in-flight compile (drives the working badge). */
+  compilingSource: string | null
+  /** Diagnostics of the last finished compile of `diagnosticsSource`. */
+  diagnosticsSource: string | null
+  diagnostics: FastLedDiagnostic[]
+  /** Bumped whenever an artifact (or failure) lands in the cache. */
+  artifactVersion: number
+  /** Defines of the layout the preview last resolved (PXLBLZ_NUM_LEDS, ...). */
+  lastDefines: FastLedDefines | null
+  setLastDefines: (defines: FastLedDefines) => void
+  /**
+   * Compile `source` against `defines` (default: lastDefines). Edits are
+   * debounced and supersede each other; `immediate` skips the debounce.
+   */
+  requestCompile: (source: string, defines?: FastLedDefines | null, options?: { immediate?: boolean }) => void
+  getArtifact: (source: string, defines: FastLedDefines) => FastLedArtifact | undefined
+}
+
+const cache = createFastLedArtifactCache()
+const inflight = new Map<string, Promise<void>>()
+let debounceTimer: ReturnType<typeof setTimeout> | null = null
+let editAbort: AbortController | null = null
+let retryTimer: ReturnType<typeof setTimeout> | null = null
+let retryDelay = RETRY_MIN_MS
+
+export const fastLedStoreInitialState = {
+  serviceStatus: 'unknown' as FastLedServiceStatus,
+  serviceUrl: '',
+  compilingSource: null as string | null,
+  diagnosticsSource: null as string | null,
+  diagnostics: [] as FastLedDiagnostic[],
+  artifactVersion: 0,
+  lastDefines: null as FastLedDefines | null,
+}
+
+/** Test-only: drop cache, timers and in-flight bookkeeping. */
+export function __resetFastLedStoreForTests(): void {
+  cache.clear()
+  inflight.clear()
+  if (debounceTimer) clearTimeout(debounceTimer)
+  if (retryTimer) clearTimeout(retryTimer)
+  debounceTimer = null
+  retryTimer = null
+  editAbort = null
+  retryDelay = RETRY_MIN_MS
+  useFastLedStore.setState({ ...fastLedStoreInitialState })
+}
+
+function sameDefines(a: FastLedDefines | null, b: FastLedDefines): boolean {
+  return a !== null && fastLedArtifactKey('', a) === fastLedArtifactKey('', b)
+}
+
+// The compile result reaches the editor only for the exact buffer of the same
+// Pattern that asked for it.
+function applyResult(source: string, artifact: FastLedArtifact, requestedFor: string | null): void {
+  useFastLedStore.setState((s) => ({
+    artifactVersion: s.artifactVersion + 1,
+    compilingSource: s.compilingSource === source ? null : s.compilingSource,
+  }))
+  const editor = useEditorStore.getState()
+  const activePatternId = usePatternStore.getState().activePatternId
+  if (
+    editor.editorFlavor !== 'pattern'
+    || editor.source !== source
+    || activePatternId === null
+    || activePatternId !== requestedFor
+  ) return
+  useFastLedStore.setState({ diagnosticsSource: source, diagnostics: artifact.diagnostics })
+  if (artifact.ok) {
+    editor.setCompileStatus('good')
+    if (editor.previewSource !== source) editor.setPreviewSource(source)
+  } else {
+    editor.setCompileStatus('broken')
+    if (editor.previewSource === source) editor.setPreviewUnavailable('broken-source')
+  }
+}
+
+function stillWanted(source: string): boolean {
+  const editor = useEditorStore.getState()
+  return editor.source === source || editor.previewSource === source
+}
+
+function scheduleRetry(source: string, defines: FastLedDefines): void {
+  if (retryTimer) clearTimeout(retryTimer)
+  const delay = retryDelay
+  retryDelay = Math.min(RETRY_MAX_MS, retryDelay * 2)
+  retryTimer = setTimeout(() => {
+    retryTimer = null
+    if (!stillWanted(source) || !isFastLedSource(source)) return
+    runCompile(source, defines, false)
+  }, delay)
+}
+
+function runCompile(source: string, defines: FastLedDefines, isEdit: boolean): void {
+  const hit = cache.get(source, defines)
+  const requestedFor = usePatternStore.getState().activePatternId
+  if (hit) {
+    applyResult(source, hit, requestedFor)
+    return
+  }
+  const key = fastLedArtifactKey(source, defines)
+  if (inflight.has(key)) return
+  let signal: AbortSignal | undefined
+  if (isEdit) {
+    editAbort?.abort()
+    editAbort = new AbortController()
+    signal = editAbort.signal
+  }
+  const serviceUrl = fastLedServiceUrl()
+  useFastLedStore.setState({ compilingSource: source, serviceUrl })
+  const job = (async () => {
+    try {
+      const result = await compileFastLed({ source, defines }, { signal, baseUrl: serviceUrl })
+      retryDelay = RETRY_MIN_MS
+      useFastLedStore.setState({ serviceStatus: 'online' })
+      let artifact: FastLedArtifact
+      if (result.ok) {
+        try {
+          const module = await WebAssembly.compile(result.wasm as BufferSource)
+          artifact = { ok: true, module, diagnostics: result.diagnostics }
+        } catch (err) {
+          artifact = { ok: false, message: `FastLED module rejected: ${err instanceof Error ? err.message : String(err)}`, diagnostics: result.diagnostics }
+        }
+      } else {
+        artifact = { ok: false, message: result.message, diagnostics: result.diagnostics }
+      }
+      cache.set(source, defines, artifact)
+      applyResult(source, artifact, requestedFor)
+    } catch (err) {
+      useFastLedStore.setState((s) => ({ compilingSource: s.compilingSource === source ? null : s.compilingSource }))
+      if (err instanceof FastLedServiceOfflineError) {
+        useFastLedStore.setState((s) => ({ serviceStatus: 'offline', artifactVersion: s.artifactVersion + 1 }))
+        scheduleRetry(source, defines)
+      }
+      // AbortError: superseded by a newer edit; nothing to report.
+    } finally {
+      inflight.delete(key)
+    }
+  })()
+  inflight.set(key, job)
+}
+
+export const useFastLedStore = create<FastLedState>()((set, get) => ({
+  ...fastLedStoreInitialState,
+  setLastDefines: (defines) => {
+    if (!sameDefines(get().lastDefines, defines)) set({ lastDefines: { ...defines } })
+  },
+  requestCompile: (source, defines, options = {}) => {
+    const resolved = defines ?? get().lastDefines
+    if (!resolved || !isFastLedSource(source)) return
+    if (options.immediate) {
+      runCompile(source, resolved, false)
+      return
+    }
+    if (debounceTimer) clearTimeout(debounceTimer)
+    debounceTimer = setTimeout(() => {
+      debounceTimer = null
+      runCompile(source, resolved, true)
+    }, FASTLED_EDIT_DEBOUNCE_MS)
+  },
+  getArtifact: (source, defines) => cache.get(source, defines),
+}))
+
+/** Test seam: wait until every in-flight compile settled. */
+export async function __settleFastLedCompilesForTests(): Promise<void> {
+  while (inflight.size > 0) await Promise.all([...inflight.values()])
+}

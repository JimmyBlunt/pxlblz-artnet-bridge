+++ b/src/store/fastledStore.test.ts
@@ -0,0 +1,146 @@
+import { readFileSync } from 'node:fs'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { editorInitialState, useEditorStore } from './editorStore'
+import { patternInitialState, usePatternStore } from './patternStore'
+import {
+  __resetFastLedStoreForTests,
+  __settleFastLedCompilesForTests,
+  FASTLED_EDIT_DEBOUNCE_MS,
+  useFastLedStore,
+} from './fastledStore'
+import { FastLedServiceOfflineError, type FastLedCompileResult } from '@/engine/fastled/fastledCompileClient'
+
+const compileMock = vi.hoisted(() => vi.fn())
+vi.mock('@/engine/fastled/fastledCompileClient', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/engine/fastled/fastledCompileClient')>()),
+  compileFastLed: compileMock,
+}))
+
+const WASM = new Uint8Array(readFileSync(new URL('../engine/fastled/__fixtures__/template64.wasm', import.meta.url)))
+const DEFINES = { PXLBLZ_NUM_LEDS: 64 }
+const GOOD = '// @pxlblz-language fastled\n#include <FastLED.h>\nvoid setup(){}\nvoid loop(){}\n'
+const BROKEN = '// @pxlblz-language fastled\nvoid loop() { nope(); }\n'
+
+const ok = (): FastLedCompileResult => ({ ok: true, wasm: WASM, key: 'k', cached: false, diagnostics: [] })
+const fail = (): FastLedCompileResult => ({
+  ok: false,
+  message: 'Line 2: nope',
+  diagnostics: [{ line: 2, column: 15, severity: 'error', message: "use of undeclared identifier 'nope'" }],
+})
+
+function openBuffer(source: string, previewSource = '') {
+  usePatternStore.setState({ ...patternInitialState, activePatternId: 'p1' })
+  useEditorStore.setState({ ...editorInitialState, editorFlavor: 'pattern', isReadOnly: false, source, previewSource })
+}
+
+beforeEach(() => {
+  __resetFastLedStoreForTests()
+  compileMock.mockReset()
+})
+
+afterEach(() => {
+  vi.useRealTimers()
+})
+
+describe('fastledStore publication rule', () => {
+  it('publishes previewSource and good status for a successful compile of the current buffer', async () => {
+    compileMock.mockResolvedValue(ok())
+    openBuffer(GOOD, 'old')
+    useFastLedStore.getState().requestCompile(GOOD, DEFINES, { immediate: true })
+    expect(useFastLedStore.getState().compilingSource).toBe(GOOD)
+    await __settleFastLedCompilesForTests()
+    expect(compileMock).toHaveBeenCalledWith({ source: GOOD, defines: DEFINES }, expect.anything())
+    expect(useEditorStore.getState()).toMatchObject({ previewSource: GOOD, compileStatus: 'good' })
+    expect(useFastLedStore.getState()).toMatchObject({ compilingSource: null, serviceStatus: 'online', diagnosticsSource: GOOD })
+    expect(useFastLedStore.getState().getArtifact(GOOD, DEFINES)?.ok).toBe(true)
+  })
+
+  it('keeps the last working preview and marks the buffer broken on errors', async () => {
+    compileMock.mockResolvedValue(fail())
+    openBuffer(BROKEN, GOOD)
+    useFastLedStore.getState().requestCompile(BROKEN, DEFINES, { immediate: true })
+    await __settleFastLedCompilesForTests()
+    expect(useEditorStore.getState()).toMatchObject({ previewSource: GOOD, compileStatus: 'broken', previewUnavailableReason: null })
+    expect(useFastLedStore.getState().diagnostics).toEqual(fail().diagnostics)
+  })
+
+  it('makes a reopened unexecutable source explicitly unavailable', async () => {
+    compileMock.mockResolvedValue(fail())
+    openBuffer(BROKEN, BROKEN)
+    useFastLedStore.getState().requestCompile(BROKEN, DEFINES, { immediate: true })
+    await __settleFastLedCompilesForTests()
+    expect(useEditorStore.getState()).toMatchObject({ previewSource: '', previewUnavailableReason: 'broken-source', compileStatus: 'broken' })
+  })
+
+  it('does not publish when the buffer or the Pattern changed meanwhile', async () => {
+    compileMock.mockResolvedValue(ok())
+    openBuffer(GOOD, 'old')
+    useFastLedStore.getState().requestCompile(GOOD, DEFINES, { immediate: true })
+    useEditorStore.setState({ source: `${GOOD}// more` })
+    await __settleFastLedCompilesForTests()
+    expect(useEditorStore.getState().previewSource).toBe('old')
+
+    __resetFastLedStoreForTests()
+    openBuffer(GOOD, 'old')
+    useFastLedStore.getState().requestCompile(GOOD, DEFINES, { immediate: true })
+    usePatternStore.setState({ activePatternId: 'p2' })
+    await __settleFastLedCompilesForTests()
+    expect(useEditorStore.getState().previewSource).toBe('old')
+    // The artifact still lands in the cache for the preview.
+    expect(useFastLedStore.getState().getArtifact(GOOD, DEFINES)?.ok).toBe(true)
+  })
+
+  it('serves cache hits without another fetch', async () => {
+    compileMock.mockResolvedValue(ok())
+    openBuffer(GOOD)
+    useFastLedStore.getState().requestCompile(GOOD, DEFINES, { immediate: true })
+    await __settleFastLedCompilesForTests()
+    useFastLedStore.getState().requestCompile(GOOD, DEFINES, { immediate: true })
+    await __settleFastLedCompilesForTests()
+    expect(compileMock).toHaveBeenCalledTimes(1)
+  })
+
+  it('debounces edits against lastDefines and aborts a superseded edit compile', async () => {
+    vi.useFakeTimers()
+    const signals: AbortSignal[] = []
+    compileMock.mockImplementation((_req: unknown, opts: { signal: AbortSignal }) => {
+      signals.push(opts.signal)
+      return new Promise(() => {})
+    })
+    openBuffer(GOOD)
+    useFastLedStore.getState().requestCompile(GOOD)
+    vi.advanceTimersByTime(FASTLED_EDIT_DEBOUNCE_MS * 2)
+    expect(compileMock).not.toHaveBeenCalled() // no layout resolved yet
+    useFastLedStore.getState().setLastDefines(DEFINES)
+    useFastLedStore.getState().requestCompile('// @pxlblz-language fastled\n// a')
+    useFastLedStore.getState().requestCompile('// @pxlblz-language fastled\n// ab')
+    vi.advanceTimersByTime(FASTLED_EDIT_DEBOUNCE_MS)
+    expect(compileMock).toHaveBeenCalledTimes(1)
+    useFastLedStore.getState().requestCompile('// @pxlblz-language fastled\n// abc')
+    vi.advanceTimersByTime(FASTLED_EDIT_DEBOUNCE_MS)
+    expect(compileMock).toHaveBeenCalledTimes(2)
+    expect(signals[0].aborted).toBe(true)
+    expect(signals[1].aborted).toBe(false)
+  })
+
+  it('ignores Pixelblaze sources', () => {
+    openBuffer('export function render(i) {}')
+    useFastLedStore.getState().requestCompile('export function render(i) {}', DEFINES, { immediate: true })
+    expect(compileMock).not.toHaveBeenCalled()
+  })
+
+  it('goes offline without touching compileStatus and retries until the service answers', async () => {
+    vi.useFakeTimers()
+    compileMock.mockRejectedValueOnce(new FastLedServiceOfflineError('http://127.0.0.1:9996')).mockResolvedValue(ok())
+    openBuffer(GOOD, GOOD)
+    useEditorStore.setState({ compileStatus: 'good' })
+    useFastLedStore.getState().requestCompile(GOOD, DEFINES, { immediate: true })
+    await vi.waitFor(() => expect(useFastLedStore.getState().serviceStatus).toBe('offline'))
+    expect(useEditorStore.getState().compileStatus).toBe('good')
+    await vi.advanceTimersByTimeAsync(2000)
+    await vi.waitFor(() => expect(useFastLedStore.getState().serviceStatus).toBe('online'))
+    await __settleFastLedCompilesForTests()
+    expect(compileMock).toHaveBeenCalledTimes(2)
+    expect(useFastLedStore.getState().getArtifact(GOOD, DEFINES)?.ok).toBe(true)
+  })
+})

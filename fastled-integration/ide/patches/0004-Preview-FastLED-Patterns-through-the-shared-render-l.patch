+describe('fastledPreview helpers', () => {
+  it('passes the map pixel count and grid size as defines', () => {
+    expect(fastLedDefinesForLayout({ pixelCount: 144, layoutLabel: null })).toEqual({ PXLBLZ_NUM_LEDS: 144 })
+    expect(fastLedDefinesForLayout({ pixelCount: 256, layoutLabel: '32×8' })).toEqual({ PXLBLZ_NUM_LEDS: 256, PXLBLZ_WIDTH: 32, PXLBLZ_HEIGHT: 8 })
+    expect(fastLedDefinesForLayout({ pixelCount: 512, layoutLabel: '8×8×8' })).toEqual({ PXLBLZ_NUM_LEDS: 512 })
+    expect(fastLedDefinesForLayout({ pixelCount: 250, layoutLabel: '32×8' })).toEqual({ PXLBLZ_NUM_LEDS: 250 })
+  })
+
+  it('derives a stable non-zero seed', () => {
+    expect(fastLedSeed('pattern-a')).toBe(fastLedSeed('pattern-a'))
+    expect(fastLedSeed('pattern-a')).not.toBe(fastLedSeed('pattern-b'))
+    expect(fastLedSeed('')).toBeGreaterThan(0)
+  })
+
+  it('describes LED count mismatches only', () => {
+    expect(fastLedLedCountNotice(64, 64)).toBeNull()
+    expect(fastLedLedCountNotice(60, 64)).toContain('extra pixels stay black')
+    expect(fastLedLedCountNotice(80, 64)).toContain('not shown')
+  })
+})

+// Small pure helpers for running a FastLED Pattern in the preview.
+import type { FastLedDefines } from './fastledCompileClient'
+
+/**
+ * Compiler defines for the resolved layout: PXLBLZ_NUM_LEDS is always the map's
+ * pixel count; a regular 2D grid (`cols×rows` label) adds width and height.
+ */
+export function fastLedDefinesForLayout(layout: { pixelCount: number; layoutLabel: string | null }): FastLedDefines {
+  const defines: FastLedDefines = { PXLBLZ_NUM_LEDS: layout.pixelCount }
+  const grid = /^(\d+)×(\d+)$/.exec(layout.layoutLabel ?? '')
+  if (grid && Number(grid[1]) * Number(grid[2]) === layout.pixelCount) {
+    defines.PXLBLZ_WIDTH = Number(grid[1])
+    defines.PXLBLZ_HEIGHT = Number(grid[2])
+  }
+  return defines
+}
+
+/** Deterministic non-zero seed for Arduino random(), stable per Pattern. */
+export function fastLedSeed(key: string): number {
+  let h = 0x811c9dc5
+  for (let i = 0; i < key.length; i++) {
+    h ^= key.charCodeAt(i)
+    h = Math.imul(h, 0x01000193)
+  }
+  return (h >>> 0) || 1
+}
+
+/** One-line readout when the Pattern's LED count differs from the map. */
+export function fastLedLedCountNotice(ledCount: number, pixelCount: number): string | null {
+  if (ledCount === pixelCount) return null
+  return ledCount < pixelCount
+    ? `FastLED Pattern drives ${ledCount} LEDs; map has ${pixelCount} - extra pixels stay black`
+    : `FastLED Pattern drives ${ledCount} LEDs; map has ${pixelCount} - LEDs beyond the map are not shown`
+}

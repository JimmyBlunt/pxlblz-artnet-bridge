--- /dev/null
+++ b/src/engine/fastled/fastledWorkerHost.ts
@@ -0,0 +1,346 @@
+// Main-thread side of a FastLED Pattern running in a Web Worker.
+//
+// Why: wasm on the main thread cannot be interrupted. A loop() that never calls
+// delay()/millis()/FastLED.show() (e.g. `while (true) {}`) froze the tab. In a
+// worker, a watchdog terminates the thread instead and the preview keeps its
+// last frame and shows a runtime error.
+//
+// Render-loop contract: the preview still asks for exactly one FastLED frame per
+// IDE frame, with that frame's delta. The answer arrives asynchronously, so the
+// frames are pipelined by one IDE frame: frame(dt_k) posts the request for frame
+// k and the IDE shows frame k-1 (the newest finished one). The worker receives
+// the identical dt sequence and runs the identical host calls, so the sequence
+// of frames, and every byte in it, is the same as on the main thread, one frame
+// later (≈16.7 ms at 60 fps). If the worker has not answered by the next IDE
+// frame, the IDE repeats the last frame and the deltas accumulate into the next
+// request (sketch time stays in step with preview time; nothing is dropped).
+//
+// FastLedWorkerHost implements FastLedHostLike, so createFastLedPatternHandle,
+// the render loop, the packed frame and the external pixel output are unchanged.
+import type { FastLedHostLike } from './fastledPatternHandle'
+import type { FastLedStrip, FastLedUiElement } from './fastledWasmHost'
+import type {
+  FastLedUiValues,
+  FastLedWorkerEvent,
+  FastLedWorkerFrame,
+  FastLedWorkerOutput,
+  FastLedWorkerRequest,
+} from './fastledWorkerProtocol'
+
+/** Transport to one worker (browser Worker, MessageChannel or worker_thread in tests). */
+export interface FastLedWorkerPort {
+  post(request: FastLedWorkerRequest, transfer?: Transferable[]): void
+  onEvent(listener: (event: FastLedWorkerEvent) => void): void
+  /** Uncaught worker failure (load error, out of memory). */
+  onFailure(listener: (error: Error) => void): void
+  terminate(): void
+}
+
+export const FASTLED_WORKER_WATCHDOG_MS = 2000
+export const FASTLED_WORKER_START_TIMEOUT_MS = 10000
+
+export class FastLedWorkerStoppedError extends Error {
+  constructor(message: string) {
+    super(message)
+    this.name = 'FastLedWorkerStoppedError'
+  }
+}
+
+export function fastLedWatchdogMessage(ms: number, phase: 'setup' | 'loop'): string {
+  const seconds = ms >= 1000 ? `${Math.round(ms / 100) / 10} s` : `${ms} ms`
+  return phase === 'setup'
+    ? `FastLED Pattern stopped: setup() did not finish within ${seconds}. Check setup() for an endless loop; the Pattern restarts when you change it.`
+    : `FastLED Pattern stopped: loop() ran for more than ${seconds} without delay(), millis() or FastLED.show() (endless loop?). The last frame is kept; the Pattern restarts when you change it.`
+}
+
+export interface FastLedWorkerStats {
+  /** Frames answered by the worker. */
+  frames: number
+  /** IDE frames that had to repeat the previous frame (worker answer not back yet). */
+  repeats: number
+  /** Request → answer, ms (mean / max). */
+  meanRoundTripMs: number
+  maxRoundTripMs: number
+  /** Time inside the worker's frame() + copy, ms (mean / max). */
+  meanComputeMs: number
+  maxComputeMs: number
+}
+
+export interface StartFastLedWorkerOptions {
+  port: FastLedWorkerPort
+  seed: number
+  output: FastLedWorkerOutput
+  watchdogMs?: number
+  startTimeoutMs?: number
+  onConsole?: (text: string, stream: 'stdout' | 'stderr') => void
+  /** Called once when the worker is stopped by the watchdog or crashes. */
+  onFatal?: (error: Error) => void
+  now?: () => number
+  setTimer?: (fn: () => void, ms: number) => unknown
+  clearTimer?: (handle: unknown) => void
+}
+
+export class FastLedWorkerHost implements FastLedHostLike {
+  private readonly port: FastLedWorkerPort
+  private readonly opts: StartFastLedWorkerOptions
+  private readonly now: () => number
+  private readonly setTimer: (fn: () => void, ms: number) => unknown
+  private readonly clearTimer: (handle: unknown) => void
+  private dead: Error | null = null
+  private ui: FastLedUiElement[] = []
+  private leds = 0
+  private strips: FastLedStrip[] = []
+  private current: FastLedWorkerFrame | null = null
+  private bytes: Uint8Array = new Uint8Array(0)
+  private inflight: { seq: number; sentAt: number; timer: unknown } | null = null
+  private pendingDt = 0
+  private seq = 0
+  private lastStatus = 0
+  private waiters: Array<() => void> = []
+  private startWaiter: { resolve: () => void; reject: (e: Error) => void; timer: unknown } | null = null
+  private readonly stat = { frames: 0, repeats: 0, rtSum: 0, rtMax: 0, cSum: 0, cMax: 0 }
+
+  constructor(opts: StartFastLedWorkerOptions) {
+    this.opts = opts
+    this.port = opts.port
+    this.now = opts.now ?? (() => (typeof performance !== 'undefined' ? performance.now() : Date.now()))
+    this.setTimer = opts.setTimer ?? ((fn, ms) => setTimeout(fn, ms))
+    this.clearTimer = opts.clearTimer ?? ((h) => clearTimeout(h as ReturnType<typeof setTimeout>))
+    this.port.onEvent((event) => this.onEvent(event))
+    this.port.onFailure((error) => this.kill(new FastLedWorkerStoppedError(`FastLED worker failed: ${error.message}`)))
+  }
+
+  /** Instantiates the module in the worker and runs setup(). */
+  start(module: WebAssembly.Module): Promise<void> {
+    return new Promise<void>((resolve, reject) => {
+      const ms = this.opts.startTimeoutMs ?? FASTLED_WORKER_START_TIMEOUT_MS
+      const timer = this.setTimer(() => this.kill(new FastLedWorkerStoppedError(fastLedWatchdogMessage(ms, 'setup'))), ms)
+      this.startWaiter = { resolve, reject, timer }
+      this.port.post({ type: 'start', module, seed: this.opts.seed, output: this.opts.output })
+    })
+  }
+
+  /** Renders the first frame (frame(0)) and waits for it, before the loop starts. */
+  async primeFirstFrame(): Promise<void> {
+    this.send(0, this.opts.startTimeoutMs ?? FASTLED_WORKER_START_TIMEOUT_MS)
+    await this.whenIdle()
+    if (this.dead) throw this.dead
+  }
+
+  /** Resolves when no frame request is outstanding (or the worker is gone). */
+  whenIdle(): Promise<void> {
+    if (!this.inflight || this.dead) return Promise.resolve()
+    return new Promise((resolve) => this.waiters.push(resolve))
+  }
+
+  get stopped(): Error | null {
+    return this.dead
+  }
+
+  stats(): FastLedWorkerStats {
+    const s = this.stat
+    return {
+      frames: s.frames,
+      repeats: s.repeats,
+      meanRoundTripMs: s.frames ? s.rtSum / s.frames : 0,
+      maxRoundTripMs: s.rtMax,
+      meanComputeMs: s.frames ? s.cSum / s.frames : 0,
+      maxComputeMs: s.cMax,
+    }
+  }
+
+  getStrips(): FastLedStrip[] {
+    return this.strips
+  }
+
+  dispose(): void {
+    if (this.inflight) this.clearTimer(this.inflight.timer)
+    if (this.startWaiter) this.clearTimer(this.startWaiter.timer)
+    this.inflight = null
+    this.startWaiter = null
+    if (!this.dead) this.dead = new FastLedWorkerStoppedError('FastLED worker disposed')
+    this.port.terminate()
+    this.flushWaiters()
+  }
+
+  // ------------------------------------------------------------ FastLedHostLike
+  frame(dtMs: number): { status: number } {
+    if (this.dead) throw this.dead
+    // The handle calls frame(0) once for the first frame; primeFirstFrame()
+    // already produced it.
+    if (dtMs > 0) this.pendingDt += dtMs
+    if (this.inflight) {
+      if (dtMs > 0) this.stat.repeats += 1
+    } else if (this.pendingDt > 0) {
+      const dt = this.pendingDt
+      this.pendingDt = 0
+      this.send(dt, this.opts.watchdogMs ?? FASTLED_WORKER_WATCHDOG_MS)
+    }
+    return { status: this.lastStatus }
+  }
+
+  getLeds(): Uint8Array {
+    return this.bytes
+  }
+
+  getWire(): Uint8Array {
+    return this.bytes
+  }
+
+  ledCount(): number {
+    return this.current?.ledCount ?? this.leds
+  }
+
+  getUi(): FastLedUiElement[] {
+    return this.ui
+  }
+
+  setUi(idOrName: number | string, value: number | boolean | string): boolean {
+    if (this.dead) return false
+    const values: FastLedUiValues = { [String(idOrName)]: value }
+    // Mirror like FastLedHost.setUiMany (FastLED clamps sliders/number fields).
+    const el = this.ui.find((e) => String(e.id) === String(idOrName)) ?? this.ui.find((e) => e.name === idOrName)
+    if (el) {
+      let v: unknown = value
+      if (typeof value === 'number' && (el.kind === 'slider' || el.kind === 'number')) {
+        v = Math.min(el.max ?? Infinity, Math.max(el.min ?? -Infinity, value))
+      }
+      el.value = v
+    }
+    this.port.post({ type: 'setUi', values })
+    return el !== undefined
+  }
+
+  millis(): number {
+    return this.current?.millis ?? 0
+  }
+
+  showCount(): number {
+    return this.current?.showCount ?? 0
+  }
+
+  // ------------------------------------------------------------ internals
+  private send(dtMs: number, watchdogMs: number): void {
+    const seq = ++this.seq
+    const timer = this.setTimer(() => {
+      if (this.inflight?.seq === seq) this.kill(new FastLedWorkerStoppedError(fastLedWatchdogMessage(watchdogMs, 'loop')))
+    }, watchdogMs)
+    this.inflight = { seq, sentAt: this.now(), timer }
+    this.port.post({ type: 'frame', seq, dtMs })
+  }
+
+  private onEvent(event: FastLedWorkerEvent): void {
+    if (this.dead) return
+    switch (event.type) {
+      case 'started': {
+        this.leds = event.ledCount
+        this.ui = event.ui
+        this.strips = event.strips
+        const waiter = this.startWaiter
+        this.startWaiter = null
+        if (waiter) {
+          this.clearTimer(waiter.timer)
+          waiter.resolve()
+        }
+        return
+      }
+      case 'frame': {
+        if (!this.inflight || this.inflight.seq !== event.seq) return
+        this.clearTimer(this.inflight.timer)
+        const rt = this.now() - this.inflight.sentAt
+        this.inflight = null
+        this.current = event
+        this.bytes = new Uint8Array(event.buffer)
+        this.lastStatus = event.status
+        if (event.ui) this.ui = mergeUi(event.ui, this.ui)
+        const s = this.stat
+        s.frames += 1
+        s.rtSum += rt
+        s.rtMax = Math.max(s.rtMax, rt)
+        s.cSum += event.computeMs
+        s.cMax = Math.max(s.cMax, event.computeMs)
+        this.flushWaiters()
+        return
+      }
+      case 'console':
+        this.opts.onConsole?.(event.text, event.stream)
+        return
+      case 'error':
+        this.kill(new FastLedWorkerStoppedError(event.message))
+        return
+    }
+  }
+
+  private kill(error: Error): void {
+    if (this.dead) return
+    this.dead = error
+    if (this.inflight) this.clearTimer(this.inflight.timer)
+    this.inflight = null
+    this.port.terminate()
+    const waiter = this.startWaiter
+    this.startWaiter = null
+    if (waiter) {
+      this.clearTimer(waiter.timer)
+      waiter.reject(error)
+    }
+    this.flushWaiters()
+    this.opts.onFatal?.(error)
+  }
+
+  private flushWaiters(): void {
+    const waiters = this.waiters
+    this.waiters = []
+    for (const w of waiters) w()
+  }
+}
+
+// A UI list sent by the worker reflects the sketch; values the preview set since
+// then (still in flight to the worker) are already mirrored in `previous`.
+function mergeUi(next: FastLedUiElement[], previous: FastLedUiElement[]): FastLedUiElement[] {
+  return next.map((el) => {
+    const prev = previous.find((p) => p.id === el.id)
+    return prev ? { ...el, defaultValue: prev.defaultValue } : el
+  })
+}
+
+/** Starts a FastLED Pattern in a worker: instantiate + setup(), ready for frames. */
+export async function startFastLedWorkerHost(module: WebAssembly.Module, opts: StartFastLedWorkerOptions): Promise<FastLedWorkerHost> {
+  const host = new FastLedWorkerHost(opts)
+  try {
+    await host.start(module)
+  } catch (err) {
+    host.dispose()
+    throw err
+  }
+  return host
+}
+
+/** A browser Worker running fastled.worker.ts as a FastLedWorkerPort. */
+export function createBrowserFastLedWorkerPort(): FastLedWorkerPort {
+  const worker = new Worker(new URL('./fastled.worker.ts', import.meta.url), { type: 'module', name: 'fastled-pattern' })
+  let failure: ((error: Error) => void) | null = null
+  worker.onerror = (event) => {
+    event.preventDefault?.()
+    failure?.(new Error(event.message || 'worker error'))
+  }
+  return {
+    post: (request, transfer) => worker.postMessage(request, transfer ?? []),
+    onEvent: (listener) => {
+      worker.onmessage = (event: MessageEvent<FastLedWorkerEvent>) => listener(event.data)
+    },
+    onFailure: (listener) => {
+      failure = listener
+    },
+    terminate: () => worker.terminate(),
+  }
+}
+
+/** False when the preview must run FastLED on the main thread (no Worker, or `?fastledWorker=0`). */
+export function fastLedWorkerEnabled(search: string = typeof location === 'undefined' ? '' : location.search): boolean {
+  if (typeof Worker === 'undefined') return false
+  try {
+    return new URLSearchParams(search).get('fastledWorker') !== '0'
+  } catch {
+    return true
+  }
+}

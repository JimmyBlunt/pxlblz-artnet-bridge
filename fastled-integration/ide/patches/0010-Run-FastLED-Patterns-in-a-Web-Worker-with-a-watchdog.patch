diff --git a/src/engine/fastled/fastled.worker.ts b/src/engine/fastled/fastled.worker.ts
new file mode 100644
index 00000000..a6c0640b
--- /dev/null
+++ b/src/engine/fastled/fastled.worker.ts
@@ -0,0 +1,15 @@
+// Dedicated worker running one FastLED Pattern (one wasm instance). The preview
+// creates one per run and terminates it on stop, Pattern change or watchdog
+// (a sketch that never yields cannot be interrupted any other way).
+import { createFastLedWorkerCore } from './fastledWorkerCore.ts'
+import type { FastLedWorkerRequest } from './fastledWorkerProtocol.ts'
+
+const scope = self as unknown as {
+  postMessage(message: unknown, transfer?: Transferable[]): void
+  onmessage: ((event: MessageEvent<FastLedWorkerRequest>) => void) | null
+}
+
+const onRequest = createFastLedWorkerCore((event, transfer) => scope.postMessage(event, transfer ?? []))
+scope.onmessage = (event) => {
+  void onRequest(event.data)
+}
diff --git a/src/engine/fastled/fastledWorkerCore.ts b/src/engine/fastled/fastledWorkerCore.ts
new file mode 100644
index 00000000..ffaa4793
--- /dev/null
+++ b/src/engine/fastled/fastledWorkerCore.ts
@@ -0,0 +1,86 @@
+// The FastLED Pattern worker's logic, independent of the messaging transport:
+// fastled.worker.ts wires it to `self` in the browser, tests wire it to a
+// MessageChannel or a Node worker_thread.
+//
+// It runs exactly the same host calls in the same order as the main-thread
+// preview did (instantiate → init(seed) → setUi → frame(dt) → getWire/getLeds),
+// so the bytes are identical; only the thread differs. Messages are processed
+// strictly in order (a `start` that is still instantiating holds back later
+// `setUi`/`frame` messages).
+//
+// Imports carry `.ts` so Node can load this file in a worker_thread directly.
+import { instantiateFastLedHost, type FastLedHost, type FastLedUiElement } from './fastledWasmHost.ts'
+import type { FastLedWorkerEvent, FastLedWorkerOutput, FastLedWorkerRequest } from './fastledWorkerProtocol.ts'
+
+type Post = (event: FastLedWorkerEvent, transfer?: Transferable[]) => void
+
+const now = () => (typeof performance !== 'undefined' ? performance.now() : Date.now())
+
+export function createFastLedWorkerCore(post: Post): (request: FastLedWorkerRequest) => Promise<void> {
+  let host: FastLedHost | null = null
+  let output: FastLedWorkerOutput = 'wire'
+  let lastUi: FastLedUiElement[] | null = null
+  let failed = false
+  let queue: Promise<void> = Promise.resolve()
+
+  const fail = (phase: 'start' | 'frame' | 'setUi', err: unknown) => {
+    failed = true
+    post({ type: 'error', phase, message: err instanceof Error ? err.message : String(err) })
+  }
+
+  const handle = async (request: FastLedWorkerRequest): Promise<void> => {
+    if (failed) return
+    if (request.type === 'start') {
+      try {
+        output = request.output
+        host = await instantiateFastLedHost(request.module, {
+          onConsole: (text, stream) => post({ type: 'console', text, stream }),
+        })
+        host.init(request.seed)
+        lastUi = host.getUi()
+        post({ type: 'started', ledCount: host.ledCount(), ui: lastUi, strips: host.getStrips() })
+      } catch (err) {
+        fail('start', err)
+      }
+      return
+    }
+    if (!host) return
+    if (request.type === 'setUi') {
+      try {
+        host.setUiMany(request.values)
+      } catch (err) {
+        fail('setUi', err)
+      }
+      return
+    }
+    try {
+      const t0 = now()
+      const result = host.frame(request.dtMs)
+      const view = output === 'leds' ? host.getLeds() : host.getWire()
+      // Copy out of wasm memory into a transferable buffer (the view is
+      // detached by the next memory.grow and must not leave the worker).
+      const buffer = view.slice().buffer
+      const ui = host.getUi()
+      const uiChanged = ui !== lastUi
+      lastUi = ui
+      post({
+        type: 'frame',
+        seq: request.seq,
+        status: result.status,
+        ledCount: host.ledCount(),
+        millis: result.nowMs,
+        showCount: result.showCount,
+        buffer,
+        ...(uiChanged ? { ui } : {}),
+        computeMs: now() - t0,
+      }, [buffer])
+    } catch (err) {
+      fail('frame', err)
+    }
+  }
+
+  return (request) => {
+    queue = queue.then(() => handle(request))
+    return queue
+  }
+}

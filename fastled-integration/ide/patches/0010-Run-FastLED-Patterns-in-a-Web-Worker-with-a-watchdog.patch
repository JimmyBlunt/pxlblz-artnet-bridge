index 468f6de1..6bd682d0 100644
--- a/scripts/generate-fastled-fixtures.mjs
+++ b/scripts/generate-fastled-fixtures.mjs
@@ -57,8 +57,25 @@ function schedule() {
   return Uint32Array.from(us)
 }
 
+// Behaviour fixtures (wasm only, no golden): the sketch next to the module in
+// __fixtures__/<name>.ino. Used by the worker/watchdog tests
+// (fastledWorkerHost.test.ts): runaway (Runaway.ino from fastled-work tests:
+// busy-wait + show() runaway budget), multi-strip-blocked and rapid-show
+// (ported from the fork's scripts/fastled/fixtures).
+const BEHAVIOUR_CASES = ['runaway', 'multi-strip-blocked', 'rapid-show']
+const behaviourOnly = process.argv.includes('--behaviour-only')
+
 const cfg = loadConfig()
 await buildLib(cfg, 'wasm', {})
+fs.mkdirSync(out, { recursive: true })
+for (const name of BEHAVIOUR_CASES) {
+  const source = fs.readFileSync(path.join(out, name + '.ino'), 'utf8')
+  const w = await compileSketch(cfg, { source, defines: {}, target: 'wasm', options: { optimize: 'full' } })
+  if (!w.ok) throw new Error(name + ': compile failed ' + JSON.stringify(w.diagnostics.slice(0, 3)))
+  fs.copyFileSync(w.path, path.join(out, name + '.wasm'))
+  console.log(name + ': wasm ' + w.size + ' bytes')
+}
+if (behaviourOnly) process.exit(0)
 await buildLib(cfg, 'native', {})
 const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'pxlblz-fastled-fixtures-'))
 const sched = schedule()

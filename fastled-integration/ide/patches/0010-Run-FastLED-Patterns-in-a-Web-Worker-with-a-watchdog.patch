+// Messages between the preview (main thread) and the FastLED Pattern worker
+// (fastled.worker.ts → fastledWorkerCore.ts). Plain structured-cloneable data;
+// the compiled WebAssembly.Module is posted as is, frame bytes are transferred.
+//
+// No runtime imports here: the worker core loads in Node worker_threads too
+// (type stripping), where only `.ts` relative imports resolve.
+import type { FastLedStrip, FastLedUiElement } from './fastledWasmHost.ts'
+
+export type FastLedWorkerOutput = 'wire' | 'leds'
+export type FastLedUiValues = Record<string, number | boolean | string>
+
+export type FastLedWorkerRequest =
+  /** Instantiate the module and run setup(). Answered by `started` or `error`. */
+  | { type: 'start'; module: WebAssembly.Module; seed: number; output: FastLedWorkerOutput }
+  /** FastLED UI values by element id or name; applied before the next frame. */
+  | { type: 'setUi'; values: FastLedUiValues }
+  /** Advance the sketch by dtMs (frame(0) = first frame). Answered by `frame`. */
+  | { type: 'frame'; seq: number; dtMs: number }
+
+export interface FastLedWorkerFrame {
+  type: 'frame'
+  seq: number
+  status: number
+  ledCount: number
+  millis: number
+  showCount: number
+  /** RGB888 of the requested output (L2 wire or L1 leds), 3 × ledCount, transferred. */
+  buffer: ArrayBuffer
+  /** Present when the sketch's UI list changed since the last message. */
+  ui?: FastLedUiElement[]
+  /** Time the worker spent in frame() + copy, ms. */
+  computeMs: number
+}
+
+export type FastLedWorkerEvent =
+  | { type: 'started'; ledCount: number; ui: FastLedUiElement[]; strips: FastLedStrip[] }
+  | FastLedWorkerFrame
+  | { type: 'console'; text: string; stream: 'stdout' | 'stderr' }
+  | { type: 'error'; phase: 'start' | 'frame' | 'setUi'; message: string }

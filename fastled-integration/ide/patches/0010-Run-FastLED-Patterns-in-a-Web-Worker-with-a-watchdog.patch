@@ -0,0 +1,322 @@
+// FastLED Patterns in a worker: protocol/pipelining (fake port), the golden
+// bytes through the worker path (in-process MessageChannel, real wasm), and the
+// watchdog with real threads (Node worker_threads, real runaway wasm).
+import { readFileSync } from 'node:fs'
+import { MessageChannel, Worker } from 'node:worker_threads'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createShim } from '@/engine/shim'
+import { createRenderLoop } from '@/engine/renderLoop'
+import { createVirtualClock } from '@/engine/virtualClock'
+import { selectRenderCompatibility } from '@/engine/renderCompatibility'
+import type { MapPoint } from '@/engine/maps/types'
+import { instantiateFastLedHost, type FastLedUiElement } from './fastledWasmHost'
+import { createFastLedPatternHandle } from './fastledPatternHandle'
+import { fastLedControlBindings } from './fastledControls'
+import { createFastLedWorkerCore } from './fastledWorkerCore'
+import {
+  FastLedWorkerHost,
+  FastLedWorkerStoppedError,
+  fastLedWatchdogMessage,
+  startFastLedWorkerHost,
+  type FastLedWorkerPort,
+} from './fastledWorkerHost'
+import type { FastLedWorkerEvent, FastLedWorkerRequest } from './fastledWorkerProtocol'
+
+const fixture = (name: string) => new URL(`./__fixtures__/${name}`, import.meta.url)
+const compileFixture = (name: string) => WebAssembly.compile(readFileSync(fixture(`${name}.wasm`)))
+
+const cleanups: Array<() => unknown> = []
+afterEach(async () => {
+  while (cleanups.length) await cleanups.pop()!()
+})
+
+// ---------------------------------------------------------------- transports
+function fakePort() {
+  const sent: Array<{ request: FastLedWorkerRequest; transfer?: Transferable[] }> = []
+  let listener: (e: FastLedWorkerEvent) => void = () => {}
+  const port: FastLedWorkerPort & { terminated: boolean } = {
+    terminated: false,
+    post: (request, transfer) => { sent.push({ request, transfer }) },
+    onEvent: (l) => { listener = l },
+    onFailure: () => {},
+    terminate: () => { port.terminated = true },
+  }
+  return { port, sent, emit: (e: FastLedWorkerEvent) => listener(e) }
+}
+
+/** The worker core on the other end of an in-process MessageChannel (async, structured clone). */
+function inProcessPort(): FastLedWorkerPort {
+  const { port1, port2 } = new MessageChannel()
+  const core = createFastLedWorkerCore((event, transfer) => port2.postMessage(event, (transfer ?? []) as never))
+  port2.on('message', (request: FastLedWorkerRequest) => { void core(request) })
+  const port: FastLedWorkerPort = {
+    post: (request, transfer) => port1.postMessage(request, (transfer ?? []) as never),
+    onEvent: (l) => { port1.on('message', l) },
+    onFailure: () => {},
+    terminate: () => { port1.close(); port2.close() },
+  }
+  cleanups.push(() => port.terminate())
+  return port
+}
+
+/** A real thread running the worker core (Node worker_threads). */
+function threadPort(): FastLedWorkerPort & { exited: Promise<number> } {
+  const worker = new Worker(fixture('fastledNodeWorker.mjs'))
+  const exited = new Promise<number>((resolve) => worker.once('exit', resolve))
+  cleanups.push(() => worker.terminate())
+  return {
+    exited,
+    post: (request, transfer) => worker.postMessage(request, (transfer ?? []) as never),
+    onEvent: (l) => { worker.on('message', l) },
+    onFailure: (l) => { worker.on('error', l) },
+    terminate: () => { void worker.terminate() },
+  }
+}
+
+const ui = (over: Partial<FastLedUiElement> = {}): FastLedUiElement => ({
+  id: 1, name: 'Speed', type: 'slider', kind: 'slider', min: 1, max: 120, step: 1, value: 30, defaultValue: 30, raw: {}, ...over,
+})
+type FrameEvent = Extract<FastLedWorkerEvent, { type: 'frame' }>
+const frameEvent = (seq: number, bytes: number[], extra: Partial<FrameEvent> = {}): FastLedWorkerEvent => ({
+  type: 'frame', seq, status: 0, ledCount: bytes.length / 3, millis: seq * 16, showCount: seq, buffer: Uint8Array.from(bytes).buffer, computeMs: 0.5, ...extra,
+})
+
+// ---------------------------------------------------------------- protocol
+describe('FastLedWorkerHost (fake worker)', () => {
+  async function started() {
+    const f = fakePort()
+    const host = new FastLedWorkerHost({ port: f.port, seed: 7, output: 'wire', setTimer: () => 0, clearTimer: () => {} })
+    const module = {} as WebAssembly.Module
+    const startP = host.start(module)
+    expect(f.sent[0].request).toEqual({ type: 'start', module, seed: 7, output: 'wire' })
+    f.emit({ type: 'started', ledCount: 2, ui: [ui()], strips: [] })
+    await startP
+    const prime = host.primeFirstFrame()
+    expect(f.sent[1].request).toEqual({ type: 'frame', seq: 1, dtMs: 0 })
+    f.emit(frameEvent(1, [1, 2, 3, 4, 5, 6]))
+    await prime
+    return { f, host }
+  }
+
+  it('pipelines one frame: frame(dt) shows the newest finished frame and requests the next', async () => {
+    const { f, host } = await started()
+    // First handle call: frame(0) re-uses the primed frame, no request.
+    expect(host.frame(0)).toEqual({ status: 0 })
+    expect(Array.from(host.getWire())).toEqual([1, 2, 3, 4, 5, 6])
+    expect(f.sent).toHaveLength(2)
+    host.frame(16)
+    expect(f.sent[2].request).toEqual({ type: 'frame', seq: 2, dtMs: 16 })
+    expect(Array.from(host.getWire())).toEqual([1, 2, 3, 4, 5, 6]) // one frame behind
+    f.emit(frameEvent(2, [9, 9, 9, 8, 8, 8], { status: 1 }))
+    expect(host.frame(17).status).toBe(1)
+    expect(Array.from(host.getWire())).toEqual([9, 9, 9, 8, 8, 8])
+    expect(f.sent[3].request).toEqual({ type: 'frame', seq: 3, dtMs: 17 })
+    expect(host.millis()).toBe(32)
+  })
+
+  it('repeats the last frame while the worker is busy and accumulates the deltas', async () => {
+    const { f, host } = await started()
+    host.frame(0)
+    host.frame(16)
+    host.frame(16) // worker still busy
+    host.frame(17)
+    expect(f.sent.filter((s) => s.request.type === 'frame')).toHaveLength(2)
+    f.emit(frameEvent(2, [0, 0, 0, 0, 0, 0]))
+    host.frame(16)
+    expect(f.sent[f.sent.length - 1].request).toEqual({ type: 'frame', seq: 3, dtMs: 16 + 17 + 16 })
+    expect(host.stats()).toMatchObject({ frames: 2, repeats: 2 })
+    // A paused repaint (delta 0) never requests a frame.
+    f.emit(frameEvent(3, [0, 0, 0, 0, 0, 0]))
+    host.frame(0)
+    expect(f.sent[f.sent.length - 1].request).toMatchObject({ seq: 3 })
+  })
+
+  it('ignores stale answers', async () => {
+    const { f, host } = await started()
+    host.frame(16)
+    f.emit(frameEvent(7, [5, 5, 5, 5, 5, 5]))
+    expect(Array.from(host.getWire())).toEqual([1, 2, 3, 4, 5, 6])
+  })
+
+  it('mirrors setUi locally (clamped like FastLED) and forwards it', async () => {
+    const { f, host } = await started()
+    expect(host.setUi(1, 999)).toBe(true)
+    expect(f.sent[f.sent.length - 1].request).toEqual({ type: 'setUi', values: { 1: 999 } })
+    expect(host.getUi()[0].value).toBe(120)
+    // A UI list from the sketch keeps the defaults the preview captured.
+    host.frame(16)
+    f.emit(frameEvent(2, [0, 0, 0, 0, 0, 0], { ui: [ui({ value: 120, defaultValue: 120 })] }))
+    expect(host.getUi()[0]).toMatchObject({ value: 120, defaultValue: 30 })
+  })
+
+  it('a worker error stops the host, terminates the worker and reports once', async () => {
+    const onFatal = vi.fn()
+    const f = fakePort()
+    const host = new FastLedWorkerHost({ port: f.port, seed: 1, output: 'leds', onFatal, setTimer: () => 0, clearTimer: () => {} })
+    const startP = host.start({} as WebAssembly.Module)
+    f.emit({ type: 'error', phase: 'start', message: 'FastLED sketch crashed: unreachable' })
+    await expect(startP).rejects.toThrow('FastLED sketch crashed: unreachable')
+    expect(f.port.terminated).toBe(true)
+    expect(() => host.frame(16)).toThrow(FastLedWorkerStoppedError)
+    f.emit({ type: 'error', phase: 'frame', message: 'again' })
+    expect(onFatal).toHaveBeenCalledTimes(1)
+  })
+
+  it('the watchdog terminates a worker that does not answer a frame', async () => {
+    vi.useFakeTimers()
+    try {
+      const onFatal = vi.fn()
+      const f = fakePort()
+      const host = new FastLedWorkerHost({ port: f.port, seed: 1, output: 'wire', watchdogMs: 2000, onFatal })
+      const startP = host.start({} as WebAssembly.Module)
+      f.emit({ type: 'started', ledCount: 1, ui: [], strips: [] })
+      await startP
+      const prime = host.primeFirstFrame()
+      f.emit(frameEvent(1, [7, 7, 7]))
+      await prime
+      host.frame(16)
+      vi.advanceTimersByTime(1999)
+      expect(f.port.terminated).toBe(false)
+      vi.advanceTimersByTime(1)
+      expect(f.port.terminated).toBe(true)
+      expect(onFatal).toHaveBeenCalledWith(expect.objectContaining({ message: fastLedWatchdogMessage(2000, 'loop') }))
+      // The last frame stays readable for the preview.
+      expect(Array.from(host.getWire())).toEqual([7, 7, 7])
+      expect(() => host.frame(16)).toThrow(/endless loop/)
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+})
+
+// ---------------------------------------------------------------- golden through the worker
+interface Golden {
+  frameMs: number
+  frames: number
+  seed: number
+  events: Record<string, Record<string, number | boolean>>
+  ledCount: number
+  l1: string
+  l2: string
+}
+
+async function replayThroughWorker(name: string, output: 'wire' | 'leds') {
+  const golden = JSON.parse(readFileSync(fixture(`${name}.golden.json`), 'utf8')) as Golden
+  const expected = Buffer.from(output === 'wire' ? golden.l2 : golden.l1, 'base64')
+  const host = await startFastLedWorkerHost(await compileFixture(name), { port: inProcessPort(), seed: golden.seed, output })
+  cleanups.push(() => host.dispose())
+  const controls = fastLedControlBindings(host.getUi())
+  const n = host.ledCount()
+  const mapPoints: MapPoint[] = Array.from({ length: n }, (_, i) => ({ sample: [i / Math.max(1, n - 1)] }))
+  const clock = createVirtualClock()
+  const shim = createShim({ mapPoints, pixelCount: n, dimensions: 1, getVirtualTime: () => clock.getTime() })
+  const { handle, metadata } = createFastLedPatternHandle({
+    host, rgb: shim.builtins.rgb as (r: number, g: number, b: number) => void, output, controls,
+  })
+  const frames: Uint8Array[] = []
+  const loop = createRenderLoop({
+    handle, shim, clock, mapPoints, pixelCount: n,
+    renderCompatibility: selectRenderCompatibility(1, metadata.renderFns),
+    getSpeed: () => 1, getBrightness: () => 0.5, isDimmed: () => false,
+    paint: () => { throw new Error('packed path expected') },
+    paintPacked: (frame) => { frames.push(Uint8Array.from(frame, (v) => Math.round(v * 255))) },
+  })
+  const byName = new Map(controls.map((c) => [c.uiName, c.exportName]))
+  const applyEvents = (f: number) => {
+    for (const [uiName, value] of Object.entries(golden.events[String(f)] ?? {})) {
+      handle.controls[byName.get(uiName)!](typeof value === 'boolean' ? (value ? 1 : 0) : value)
+    }
+  }
+  // Same IDE sequence as the main-thread golden test; each rAF gap lets the
+  // worker answer (whenIdle), like a 60 fps loop with a ~1 ms frame.
+  applyEvents(0)
+  await host.primeFirstFrame()
+  loop.renderPreviewFrame()
+  for (let f = 1; f <= golden.frames; f++) {
+    if (f < golden.frames) applyEvents(f)
+    loop.tickFrame(golden.frameMs)
+    await host.whenIdle()
+  }
+  return { golden, expected, frames, n, host }
+}
+
+describe('FastLED Pattern through the worker path (real wasm, golden)', () => {
+  for (const name of ['template64', 'pipeline']) {
+    for (const output of ['wire', 'leds'] as const) {
+      it(`${name}: ${output === 'wire' ? 'L2' : 'L1'} sequence is byte-identical to the native reference, one IDE frame later`, async () => {
+        const { golden, expected, frames, n, host } = await replayThroughWorker(name, output)
+        expect(n).toBe(golden.ledCount)
+        // frames[0] = primed first frame (renderPreviewFrame); frames[1] repeats it
+        // (the pipeline's one-frame latency); frames[k+1] = golden frame k.
+        expect(frames).toHaveLength(golden.frames + 1)
+        expect(frames[1]).toEqual(frames[0])
+        const shown = [frames[0], ...frames.slice(2)]
+        let diff = 0
+        shown.forEach((frame, f) => {
+          for (let k = 0; k < n * 3; k++) if (frame[k] !== expected[f * n * 3 + k]) diff += 1
+        })
+        expect(diff).toBe(0)
+        // Primed first frame + one answer per IDE frame, none late.
+        expect(host.stats()).toMatchObject({ frames: golden.frames + 1, repeats: 0 })
+      })
+    }
+  }
+})
+
+// ---------------------------------------------------------------- real threads
+describe('FastLED worker with real threads (watchdog, budget, multi-strip, rapid show)', () => {
+  it('terminates a loop() that never yields (while (true) {}) and reports both strips', async () => {
+    const port = threadPort()
+    const onFatal = vi.fn()
+    const host = await startFastLedWorkerHost(await compileFixture('multi-strip-blocked'), { port, seed: 1, output: 'leds', watchdogMs: 300, startTimeoutMs: 300, onFatal })
+    // Both upstream strips survive into the IDE (registration order, pins 3 and 4).
+    expect(host.ledCount()).toBe(3)
+    expect(host.getStrips().map((s) => [s.pin, s.ledCount, s.colorOrderName])).toEqual([[3, 2, 'GRB'], [4, 1, 'GRB']])
+    const t0 = Date.now()
+    await expect(host.primeFirstFrame()).rejects.toThrow(/did not finish|endless loop/)
+    expect(Date.now() - t0).toBeLessThan(5000)
+    expect(onFatal).toHaveBeenCalledTimes(1)
+    // The spinning thread really is gone.
+    expect(await port.exited).toBe(1)
+  })
+
+  it('multi-strip: setup() bytes of both strips (main-thread host, same module)', async () => {
+    const h = await instantiateFastLedHost(await compileFixture('multi-strip-blocked'))
+    h.init(1)
+    expect(Array.from(h.getLeds())).toEqual([255, 128, 64, 16, 32, 240, 9, 201, 77])
+  })
+
+  it('a show() runaway hits the per-frame budget and keeps running in the worker', async () => {
+    const host = await startFastLedWorkerHost(await compileFixture('runaway'), { port: threadPort(), seed: 1, output: 'leds', watchdogMs: 5000 })
+    cleanups.push(() => host.dispose())
+    await host.primeFirstFrame()
+    host.frame(0)
+    const statuses: number[] = []
+    const step = async () => {
+      host.frame(1000 / 60)
+      await host.whenIdle()
+      statuses.push(host.frame(0).status)
+    }
+    for (let i = 0; i < 40; i++) await step()
+    expect(statuses).not.toContain(1)
+    expect(host.setUi('Runaway', true)).toBe(true)
+    for (let i = 0; i < 40 && !statuses.includes(1); i++) await step()
+    expect(statuses).toContain(1)
+    expect(host.stopped).toBeNull()
+  })
+
+  it('rapid show(): the lasting display is the last show() (blue)', async () => {
+    const host = await startFastLedWorkerHost(await compileFixture('rapid-show'), { port: threadPort(), seed: 1, output: 'wire' })
+    cleanups.push(() => host.dispose())
+    await host.primeFirstFrame()
+    host.frame(0)
+    expect(Array.from(host.getWire())).toEqual([0, 0, 255])
+    for (let i = 0; i < 70; i++) {
+      host.frame(1000 / 60)
+      await host.whenIdle()
+    }
+    host.frame(0)
+    expect(Array.from(host.getWire())).toEqual([0, 0, 255])
+    expect(host.showCount()).toBeGreaterThanOrEqual(4)
+  })
+})

+// Deck section for a FastLED Pattern's projection onto the map (local fork):
+// Index (map pixel i = leds[i]) or Fläche (surface: the sketch keeps its own
+// raster, every map pixel takes the nearest sketch LED). Shows the detected
+// sketch raster; the choice persists per Pattern (header directive) or per
+// read-only example (override bag), see fastledProjectionStore.ts.
+import { DeckCell, DeckGrid, DeckSection, DeckSectionHint } from '@/components/Deck'
+import { DeckSelect } from '@/components/DeckSelect'
+import { usePanelSection } from '@/store/panelPreferencesStore'
+import { useEditorStore } from '@/store/editorStore'
+import { usePatternStore } from '@/store/patternStore'
+import {
+  canWriteFastLedProjection,
+  fastLedDemoProjectionText,
+  useFastLedProjectionStore,
+  writeActiveFastLedProjection,
+} from '@/store/fastledProjectionStore'
+import {
+  fastLedProjectionDirective,
+  parseFastLedProjection,
+  type FastLedProjectionAxes,
+  type FastLedProjectionMode,
+  type FastLedProjectionSettings,
+} from '@/engine/fastled/fastledProjection'
+import { isFastLedExampleKey } from '@/engine/fastled/fastledCatalog'
+
+const HINT = (
+  <DeckSectionHint
+    heading="FastLED projection onto the map"
+    items={[
+      ['Index', 'map pixel i shows leds[i] (strips, sketches that follow the map size)'],
+      ['Fläche', 'the sketch keeps its own raster; each map pixel takes the exact bytes of the sketch LED at its position'],
+      ['fit', 'Contain keeps the map’s aspect inside the sketch raster, Fill stretches each axis'],
+    ]}
+  />
+)
+
+const MODE_LABEL: Record<FastLedProjectionMode, string> = { index: 'Index', surface: 'Fläche' }
+
+function segmentClass(active: boolean): string {
+  return `px-1.5 py-0.5 leading-4 transition-colors ${active ? 'bg-zinc-700 text-zinc-100' : 'text-zinc-400 hover:text-zinc-200'}`
+}
+
+export function FastLedProjectionPanel({ mode: panelMode }: { mode?: string }) {
+  const status = useFastLedProjectionStore((s) => s.status)
+  const activeDemoName = usePatternStore((s) => s.activeDemoName)
+  const demoText = usePatternStore((s) => fastLedDemoProjectionText(s.demoOverrides, s.activeDemoName))
+  const sourceText = useEditorStore((s) => fastLedProjectionDirective(s.source))
+  usePatternStore((s) => s.activePatternId)
+  useEditorStore((s) => s.isReadOnly)
+  const [expanded, setExpanded] = usePanelSection(panelMode ?? 'pattern', 'FastLED')
+  const settings = parseFastLedProjection(isFastLedExampleKey(activeDemoName) ? demoText : sourceText)
+  const writable = canWriteFastLedProjection()
+  const effective = status?.mode ?? settings.mode ?? 'index'
+
+  const write = (patch: Partial<FastLedProjectionSettings>) => {
+    if (!writable) return
+    writeActiveFastLedProjection({ ...settings, ...patch })
+  }
+
+  const explanation = effective === 'surface'
+    ? 'Der Sketch läuft auf seinem eigenen Raster; jedes Map-Pixel zeigt die Bytes der Sketch-LED an seiner Position.'
+    : 'Map-Pixel i zeigt leds[i]; nur die ersten LEDs der Map leuchten, wenn der Sketch weniger hat.'
+  const readout = `${MODE_LABEL[effective]}${settings.mode ? '' : ' (auto)'}${status?.layoutLabel ? ` · ${status.layoutLabel}` : ''}`
+
+  return (
+    <DeckSection
+      label="FastLED"
+      hint={HINT}
+      collapsible
+      summaryRow={Boolean(panelMode)}
+      expanded={panelMode ? expanded : undefined}
+      onExpandedChange={panelMode ? setExpanded : undefined}
+      summary={panelMode ? <span className="truncate text-zinc-400" data-testid="fastled-projection-summary">{readout}</span> : undefined}
+    >
+      <div data-testid="fastled-projection" data-mode={effective} data-automatic={settings.mode ? 'false' : 'true'}>
+        <DeckGrid gapY="gap-y-[3px]">
+          <DeckCell label="projektion" labelClassName="shrink-0">
+            <span className="inline-flex items-center gap-1.5">
+              <span role="group" aria-label="FastLED projection" className="inline-flex overflow-hidden rounded border border-zinc-700">
+                {(['index', 'surface'] as const).map((m) => (
+                  <button
+                    key={m}
+                    type="button"
+                    aria-pressed={effective === m}
+                    disabled={!writable}
+                    data-testid={`fastled-projection-${m}`}
+                    title={m === 'surface' ? 'Fläche: jedes Map-Pixel nimmt die Sketch-LED an seiner Position' : 'Index: Map-Pixel i zeigt leds[i]'}
+                    className={segmentClass(effective === m)}
+                    onClick={() => write({ mode: m })}
+                  >
+                    {MODE_LABEL[m]}
+                  </button>
+                ))}
+              </span>
+              {settings.mode ? (
+                <button
+                  type="button"
+                  disabled={!writable}
+                  data-testid="fastled-projection-auto"
+                  title="Automatisch: Fläche für 2D-Sketches, deren LED-Zahl nicht zur Map passt"
+                  className="text-[10px] text-zinc-500 hover:text-zinc-200"
+                  onClick={() => write({ mode: undefined })}
+                >
+                  auto
+                </button>
+              ) : (
+                <span className="text-[10px] text-zinc-500">auto</span>
+              )}
+            </span>
+          </DeckCell>
+          {effective === 'surface' && (
+            <DeckCell label="fit">
+              <DeckSelect
+                ariaLabel="FastLED projection fit (Contain / Fill)"
+                value={settings.fit}
+                options={[
+                  { value: 'contain', label: 'Contain', title: 'Contain — Seitenverhältnis der Map behalten, ganz im Sketch-Raster' },
+                  { value: 'fill', label: 'Fill', title: 'Fill — jede Achse auf das Sketch-Raster strecken' },
+                ]}
+                onChange={(fit) => write({ fit })}
+                menuWidthClass="w-28"
+                portaled
+              />
+            </DeckCell>
+          )}
+          {effective === 'surface' && (
+            <DeckCell label="spiegeln">
+              <span className="inline-flex overflow-hidden rounded border border-zinc-700">
+                <button type="button" aria-pressed={settings.flipX} disabled={!writable} data-testid="fastled-projection-flip-x" className={segmentClass(settings.flipX)} title="Horizontal spiegeln" onClick={() => write({ flipX: !settings.flipX })}>X</button>
+                <button type="button" aria-pressed={settings.flipY} disabled={!writable} data-testid="fastled-projection-flip-y" className={segmentClass(settings.flipY)} title="Vertikal spiegeln" onClick={() => write({ flipY: !settings.flipY })}>Y</button>
+              </span>
+            </DeckCell>
+          )}
+          {effective === 'surface' && status?.mapDim === 3 && (
+            <DeckCell label="achsen">
+              <DeckSelect<FastLedProjectionAxes>
+                ariaLabel="FastLED projection axes (3D map)"
+                value={settings.axes ?? status.axes ?? 'xy'}
+                options={[
+                  { value: 'xy', label: 'X·Y' },
+                  { value: 'xz', label: 'X·Z' },
+                  { value: 'yz', label: 'Y·Z' },
+                ]}
+                onChange={(axes) => write({ axes })}
+                menuWidthClass="w-20"
+                portaled
+              />
+            </DeckCell>
+          )}
+        </DeckGrid>
+        {effective === 'surface' && status?.layoutLabel && (
+          <div className="mt-1 text-[10px] leading-4 text-zinc-400" data-testid="fastled-projection-raster">
+            Raster: {status.layoutLabel} · {status.litPixels}/{status.pixelCount} Map-Pixel
+          </div>
+        )}
+        <div className="mt-1 text-[10px] leading-4 text-zinc-500">{explanation}</div>
+      </div>
+    </DeckSection>
+  )
+}

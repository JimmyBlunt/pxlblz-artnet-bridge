+import { readFileSync } from 'node:fs'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { editorInitialState, useEditorStore } from './editorStore'
+import { patternInitialState, usePatternStore } from './patternStore'
+import { __resetFastLedStoreForTests, __settleFastLedCompilesForTests, useFastLedStore } from './fastledStore'
+import {
+  activeFastLedProjectionSettings,
+  canWriteFastLedProjection,
+  fastLedCloneSource,
+  fastLedDemoProjectionText,
+  writeActiveFastLedProjection,
+} from './fastledProjectionStore'
+import { DEFAULT_FASTLED_PROJECTION, fastLedProjectionDirective } from '@/engine/fastled/fastledProjection'
+import type { FastLedCompileResult } from '@/engine/fastled/fastledCompileClient'
+
+const compileMock = vi.hoisted(() => vi.fn())
+vi.mock('@/engine/fastled/fastledCompileClient', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/engine/fastled/fastledCompileClient')>()),
+  compileFastLed: compileMock,
+}))
+
+const WASM = new Uint8Array(readFileSync(new URL('../engine/fastled/__fixtures__/template64.wasm', import.meta.url)))
+const ok = (): FastLedCompileResult => ({ ok: true, wasm: WASM, key: 'k', cached: false, diagnostics: [] })
+const SRC = '// @pxlblz-language fastled\n// @pxlblz-dim 2\n#include <FastLED.h>\nvoid setup(){}\nvoid loop(){}\n'
+const EXAMPLE = 'fastled:Animartrix'
+
+beforeEach(() => {
+  __resetFastLedStoreForTests()
+  compileMock.mockReset()
+  compileMock.mockResolvedValue(ok())
+  usePatternStore.setState({ ...patternInitialState })
+  useEditorStore.setState({ ...editorInitialState })
+})
+
+describe('FastLED projection persistence', () => {
+  it('editable Pattern: the choice round-trips through the header directive; changing it does not recompile', async () => {
+    usePatternStore.setState({ activePatternId: 'p1', activeDemoName: null })
+    useEditorStore.setState({ editorFlavor: 'pattern', isReadOnly: false, source: SRC, previewSource: SRC })
+    useFastLedStore.getState().setLastDefines({})
+    useFastLedStore.getState().requestCompile(SRC, {}, { immediate: true })
+    await __settleFastLedCompilesForTests()
+    expect(compileMock).toHaveBeenCalledTimes(1)
+
+    expect(canWriteFastLedProjection()).toBe(true)
+    writeActiveFastLedProjection({ mode: 'surface', fit: 'fill', flipX: false, flipY: true })
+    const edited = useEditorStore.getState().source
+    expect(fastLedProjectionDirective(edited)).toBe('surface fit=fill flip=y')
+    expect(useEditorStore.getState().bufferEdited).toBe(true)
+    expect(activeFastLedProjectionSettings()).toEqual({ mode: 'surface', fit: 'fill', flipX: false, flipY: true })
+    await __settleFastLedCompilesForTests()
+    // Same compiled artifact (the compiler never sees the directive), published at once.
+    expect(compileMock).toHaveBeenCalledTimes(1)
+    expect(useEditorStore.getState().previewSource).toBe(edited)
+
+    writeActiveFastLedProjection(DEFAULT_FASTLED_PROJECTION)
+    expect(useEditorStore.getState().source).toBe(SRC)
+  })
+
+  it('read-only example: the choice lives in its per-demo override bag; Clone writes it into the copy', async () => {
+    usePatternStore.setState({ activePatternId: null, activeDemoName: EXAMPLE })
+    useEditorStore.setState({ editorFlavor: 'pattern', isReadOnly: true, source: SRC, previewSource: SRC })
+    expect(canWriteFastLedProjection()).toBe(true)
+    writeActiveFastLedProjection({ mode: 'index', fit: 'contain', flipX: true, flipY: false })
+    expect(useEditorStore.getState().source).toBe(SRC)
+    expect(fastLedDemoProjectionText(usePatternStore.getState().demoOverrides, EXAMPLE)).toBe('index flip=x')
+    expect(activeFastLedProjectionSettings()).toMatchObject({ mode: 'index', flipX: true })
+    expect(fastLedProjectionDirective(fastLedCloneSource(SRC, EXAMPLE))).toBe('index flip=x')
+    writeActiveFastLedProjection(DEFAULT_FASTLED_PROJECTION)
+    expect(fastLedDemoProjectionText(usePatternStore.getState().demoOverrides, EXAMPLE)).toBeNull()
+    expect(fastLedCloneSource(SRC, EXAMPLE)).toBe(SRC)
+  })
+
+  it('a read-only non-example buffer cannot store a choice', () => {
+    usePatternStore.setState({ activePatternId: null, activeDemoName: null })
+    useEditorStore.setState({ editorFlavor: 'pattern', isReadOnly: true, source: SRC })
+    expect(canWriteFastLedProjection()).toBe(false)
+    writeActiveFastLedProjection({ ...DEFAULT_FASTLED_PROJECTION, mode: 'surface' })
+    expect(useEditorStore.getState().source).toBe(SRC)
+  })
+})

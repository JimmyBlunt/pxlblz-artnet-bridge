new file mode 100644
index 00000000..b5f43e66
--- /dev/null
+++ b/src/engine/fastled/__fixtures__/screenmap-serpentine.ino
@@ -0,0 +1,25 @@
+// Projection fixture: an 8×4 serpentine matrix with a FastLED screen map. Every
+// LED shows its own raster position: red = 30·x, green = 60·y, blue = 7.
+#include <FastLED.h>
+
+#define WIDTH 8
+#define HEIGHT 4
+#define NUM_LEDS (WIDTH * HEIGHT)
+
+CRGB leds[NUM_LEDS];
+fl::XYMap xymap(WIDTH, HEIGHT, true);
+
+void setup() {
+  FastLED.addLeds<WS2812B, 2, RGB>(leds, NUM_LEDS).setScreenMap(xymap);
+  FastLED.setBrightness(255);
+}
+
+void loop() {
+  for (int y = 0; y < HEIGHT; y++) {
+    for (int x = 0; x < WIDTH; x++) {
+      leds[xymap(x, y)] = CRGB(30 * x, 60 * y, 7);
+    }
+  }
+  FastLED.show();
+  delay(16);
+}

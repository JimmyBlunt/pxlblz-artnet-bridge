@@ -0,0 +1,111 @@
+// FastLED projection (index / surface) of the active FastLED Pattern: what the
+// preview resolved (status, for the deck) and where the user's choice lives.
+//
+// Persistence, least invasive per kind:
+//   • editable FastLED Pattern → the `// @pxlblz-projection …` header line in
+//     its source (rides through save/autosave/clone like every directive; the
+//     compiler never sees it, so changing it does not recompile);
+//   • read-only FastLED example (`fastled:<id>`) → `fastledProjection` in its
+//     per-demo override bag (demoOverrides, like its other preview overrides),
+//     same text format. Clone writes it into the copy's header.
+import { create } from 'zustand'
+import type { Settings } from '@/engine/settings'
+import { isFastLedExampleKey } from '@/engine/fastled/fastledCatalog'
+import {
+  fastLedProjectionDirective,
+  formatFastLedProjection,
+  parseFastLedProjection,
+  withFastLedProjectionDirective,
+  type FastLedProjectionAxes,
+  type FastLedProjectionMode,
+  type FastLedProjectionSettings,
+  type FastLedSketchLayoutSource,
+} from '@/engine/fastled/fastledProjection'
+import { useEditorStore } from './editorStore'
+import { useFastLedStore } from './fastledStore'
+import { usePatternStore } from './patternStore'
+
+export const FASTLED_PROJECTION_OVERRIDE_KEY = 'fastledProjection'
+
+export interface FastLedProjectionStatus {
+  mode: FastLedProjectionMode
+  automatic: boolean
+  /** Map dimension the projection reads (axis choice only for 3D). */
+  mapDim: 1 | 2 | 3
+  axes: FastLedProjectionAxes | null
+  /** "64×64 aus Screen-Map"; null in index mode. */
+  layoutLabel: string | null
+  layoutSource: FastLedSketchLayoutSource | null
+  ledCount: number
+  pixelCount: number
+  /** Map pixels that show a sketch LED (surface mode). */
+  litPixels: number
+}
+
+interface FastLedProjectionState {
+  status: FastLedProjectionStatus | null
+  setStatus: (status: FastLedProjectionStatus | null) => void
+}
+
+export const useFastLedProjectionStore = create<FastLedProjectionState>()((set) => ({
+  status: null,
+  setStatus: (status) => set({ status }),
+}))
+
+/** The override text stored for a read-only example, or null. */
+export function fastLedDemoProjectionText(
+  demoOverrides: Readonly<Record<string, Partial<Settings>>>,
+  demoName: string | null,
+): string | null {
+  if (!isFastLedExampleKey(demoName)) return null
+  const bag = demoOverrides[demoName] as Record<string, unknown> | undefined
+  const text = bag?.[FASTLED_PROJECTION_OVERRIDE_KEY]
+  return typeof text === 'string' ? text : null
+}
+
+/** The persisted projection text for a preview source (+ the active demo key). */
+export function fastLedProjectionText(source: string, demoName: string | null): string | null {
+  if (isFastLedExampleKey(demoName)) return fastLedDemoProjectionText(usePatternStore.getState().demoOverrides, demoName)
+  return fastLedProjectionDirective(source)
+}
+
+/** Settings of whatever is active (example override or the buffer's directive). */
+export function activeFastLedProjectionSettings(): FastLedProjectionSettings {
+  const { activeDemoName } = usePatternStore.getState()
+  return parseFastLedProjection(fastLedProjectionText(useEditorStore.getState().source, activeDemoName))
+}
+
+/** Whether the active FastLED Pattern/example can store a projection choice. */
+export function canWriteFastLedProjection(): boolean {
+  const ps = usePatternStore.getState()
+  if (isFastLedExampleKey(ps.activeDemoName)) return true
+  return ps.activePatternId !== null && !useEditorStore.getState().isReadOnly
+}
+
+/**
+ * Persist a projection choice for whatever is active. An example writes its
+ * override bag; an editable Pattern rewrites its header directive and asks for
+ * an immediate compile (a cache hit: the directive is not compiled), which
+ * republishes the preview source.
+ */
+export function writeActiveFastLedProjection(settings: FastLedProjectionSettings): void {
+  const ps = usePatternStore.getState()
+  if (isFastLedExampleKey(ps.activeDemoName)) {
+    const text = formatFastLedProjection(settings)
+    void ps.updateDemoSettings(ps.activeDemoName, { [FASTLED_PROJECTION_OVERRIDE_KEY]: text === '' ? undefined : text } as Partial<Settings>)
+    return
+  }
+  if (ps.activePatternId === null) return
+  const editor = useEditorStore.getState()
+  if (editor.isReadOnly) return
+  const next = withFastLedProjectionDirective(editor.source, settings)
+  if (next === editor.source) return
+  editor.setEditedSource(next)
+  useFastLedStore.getState().requestCompile(next, null, { immediate: true })
+}
+
+/** Source for a clone of a read-only example: its projection override becomes a header directive. */
+export function fastLedCloneSource(source: string, demoName: string | null): string {
+  const text = fastLedDemoProjectionText(usePatternStore.getState().demoOverrides, demoName)
+  return text ? withFastLedProjectionDirective(source, parseFastLedProjection(text)) : source
+}

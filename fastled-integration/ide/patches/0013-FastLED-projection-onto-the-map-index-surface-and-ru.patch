--- /dev/null
+++ b/src/engine/fastled/fastledProjection.wasm.test.ts
@@ -0,0 +1,126 @@
+// Surface projection with real FastLED wasm: the sketch's own screen map
+// (8×4 serpentine XYMap, __fixtures__/screenmap-serpentine.ino) drives the
+// projection onto a denser 2D map, through the handle and createRenderLoop's
+// packed frame, on the main thread and through the worker. Every map pixel must
+// carry exactly the bytes of the sketch LED at its position.
+import { readFileSync } from 'node:fs'
+import { MessageChannel } from 'node:worker_threads'
+import { afterEach, describe, expect, it } from 'vitest'
+import { createShim } from '@/engine/shim'
+import { createRenderLoop } from '@/engine/renderLoop'
+import { createVirtualClock } from '@/engine/virtualClock'
+import { selectRenderCompatibility } from '@/engine/renderCompatibility'
+import type { MapPoint } from '@/engine/maps/types'
+import { instantiateFastLedHost } from './fastledWasmHost'
+import { createFastLedPatternHandle, type FastLedHostLike } from './fastledPatternHandle'
+import { createFastLedWorkerCore } from './fastledWorkerCore'
+import { startFastLedWorkerHost, type FastLedWorkerPort } from './fastledWorkerHost'
+import type { FastLedWorkerRequest } from './fastledWorkerProtocol'
+import { buildFastLedProjectionTable, describeFastLedSketchLayout, resolveFastLedSketchLayout } from './fastledProjection'
+
+const fixture = (name: string) => new URL(`./__fixtures__/${name}`, import.meta.url)
+const WIDTH = 8
+const HEIGHT = 4
+const MAP_COLS = 16
+const MAP_ROWS = 8
+
+const cleanups: Array<() => unknown> = []
+afterEach(async () => {
+  while (cleanups.length) await cleanups.pop()!()
+})
+
+function inProcessPort(): FastLedWorkerPort {
+  const { port1, port2 } = new MessageChannel()
+  const core = createFastLedWorkerCore((event, transfer) => port2.postMessage(event, (transfer ?? []) as never))
+  port2.on('message', (request: FastLedWorkerRequest) => { void core(request) })
+  const port: FastLedWorkerPort = {
+    post: (request, transfer) => port1.postMessage(request, (transfer ?? []) as never),
+    onEvent: (l) => { port1.on('message', l) },
+    onFailure: () => {},
+    terminate: () => { port1.close(); port2.close() },
+  }
+  cleanups.push(() => port.terminate())
+  return port
+}
+
+// A 16×8 row-major 2D map (twice the sketch raster in each axis), Contain coords.
+const mapPoints: MapPoint[] = Array.from({ length: MAP_COLS * MAP_ROWS }, (_, i) => {
+  const x = (i % MAP_COLS) / (MAP_COLS - 1)
+  const y = Math.floor(i / MAP_COLS) / (MAP_ROWS - 1) * ((MAP_ROWS - 1) / (MAP_COLS - 1))
+  return { sample: [x, y], pos: [x, y] }
+})
+
+/** Runs a few frames through the render loop; returns the last packed frame as bytes. */
+async function project(host: FastLedHostLike, output: 'wire' | 'leds', afterFrame: () => Promise<void> = async () => {}) {
+  const screenMaps = host.getScreenMaps?.() ?? []
+  const layout = resolveFastLedSketchLayout({ ledCount: host.ledCount(), screenMaps })
+  const projection = buildFastLedProjectionTable(mapPoints.map((p) => p.sample), layout, { fit: 'contain', flipX: false, flipY: false, axes: 'xy' })
+  const n = mapPoints.length
+  const clock = createVirtualClock()
+  const shim = createShim({ mapPoints, pixelCount: n, dimensions: 2, getVirtualTime: () => clock.getTime() })
+  const { handle, metadata } = createFastLedPatternHandle({
+    host, rgb: shim.builtins.rgb as (r: number, g: number, b: number) => void, output, controls: [], projection,
+  })
+  let last = new Uint8Array(0)
+  const loop = createRenderLoop({
+    handle, shim, clock, mapPoints, pixelCount: n,
+    renderCompatibility: selectRenderCompatibility(2, metadata.renderFns),
+    getSpeed: () => 1, getBrightness: () => 0.5, isDimmed: () => false,
+    paint: () => { throw new Error('packed path expected') },
+    paintPacked: (frame) => { last = Uint8Array.from(frame, (v) => Math.round(v * 255)) },
+  })
+  loop.renderPreviewFrame()
+  for (let f = 0; f < 4; f++) {
+    loop.tickFrame(1000 / 60)
+    await afterFrame()
+  }
+  return { layout, projection, frame: last, screenMaps }
+}
+
+function expectSpatial(frame: Uint8Array) {
+  // Map pixel (mx, my) lies in sketch cell (mx >> 1, my >> 1); the sketch paints
+  // each cell (30·x, 60·y, 7) through its serpentine XYMap.
+  for (let i = 0; i < MAP_COLS * MAP_ROWS; i++) {
+    const sx = (i % MAP_COLS) >> 1
+    const sy = Math.floor(i / MAP_COLS) >> 1
+    expect(Array.from(frame.subarray(i * 3, i * 3 + 3)), `map pixel ${i}`).toEqual([30 * sx, 60 * sy, 7])
+  }
+}
+
+describe('surface projection with a real FastLED screen map', () => {
+  it('main thread: the host reports the 8×4 serpentine screen map; L1 lands spatially right and byte-exact', async () => {
+    const host = await instantiateFastLedHost(readFileSync(fixture('screenmap-serpentine.wasm')))
+    host.init(1)
+    const { layout, projection, frame, screenMaps } = await project(host, 'leds')
+    expect(screenMaps).toHaveLength(1)
+    expect(screenMaps[0]).toMatchObject({ ledOffset: 0, length: WIDTH * HEIGHT, xyWidth: WIDTH, xyHeight: HEIGHT, xyType: 0 })
+    expect(describeFastLedSketchLayout(layout)).toBe('8×4 serpentine aus Screen-Map')
+    expect(projection.every((v) => v >= 0)).toBe(true)
+    expectSpatial(frame)
+    // Exactness: the packed frame equals the sketch's own bytes picked by the table.
+    const leds = host.getLeds()
+    for (let i = 0; i < projection.length; i++) {
+      expect(Array.from(frame.subarray(i * 3, i * 3 + 3))).toEqual(Array.from(leds.subarray(projection[i] * 3, projection[i] * 3 + 3)))
+    }
+  })
+
+  it('main thread, L2 wire bytes: each map pixel equals the wire bytes of its sketch LED', async () => {
+    const host = await instantiateFastLedHost(readFileSync(fixture('screenmap-serpentine.wasm')))
+    host.init(1)
+    const { projection, frame } = await project(host, 'wire')
+    const wire = host.getWire()
+    for (let i = 0; i < projection.length; i++) {
+      expect(Array.from(frame.subarray(i * 3, i * 3 + 3))).toEqual(Array.from(wire.subarray(projection[i] * 3, projection[i] * 3 + 3)))
+    }
+  })
+
+  it('worker: screen maps arrive with `started`; the projected frame is identical to the main thread', async () => {
+    const module = await WebAssembly.compile(readFileSync(fixture('screenmap-serpentine.wasm')))
+    const host = await startFastLedWorkerHost(module, { port: inProcessPort(), seed: 1, output: 'leds' })
+    cleanups.push(() => host.dispose())
+    await host.primeFirstFrame()
+    expect(host.getScreenMaps()[0]).toMatchObject({ xyWidth: WIDTH, xyHeight: HEIGHT, xyType: 0 })
+    const { frame } = await project(host, 'leds', () => host.whenIdle())
+    expectSpatial(frame)
+  })
+})

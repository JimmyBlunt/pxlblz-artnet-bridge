+// FastLED projection: how a FastLED Pattern's own LEDs reach the map's pixels.
+//
+// A FastLED Pattern writes `leds[0..N-1]` in its own layout (a 22×22 serpentine
+// matrix, a 64×64 XYMap, a ring). Two projections:
+//
+//   index    map pixel i shows leds[i] (the sketch drives the installation
+//            directly; right for strips and for sketches that follow the map's
+//            pixel count through PXLBLZ_NUM_LEDS).
+//   surface  the sketch keeps running on its own virtual raster; every map pixel
+//            takes the colour of the sketch LED nearest to its position. The
+//            map's 2D coordinates are fitted onto the sketch's layout (its
+//            FastLED screen map, else the catalogue's width×height, else a square
+//            guess). No interpolation: a map pixel carries exactly the L2 (or L1)
+//            bytes of one sketch LED, so the bytes stay FastLED's own.
+//
+// The projection is a precomputed index table (map index → sketch LED index, −1
+// = black); the handle reads it per pixel. Settings ride in the Pattern source as
+// `// @pxlblz-projection surface fit=contain` (editable Patterns) or in the
+// per-example override bag (read-only catalogue examples), same text format.
+import type { FastLedScreenMap } from './fastledWasmHost'
+
+export type FastLedProjectionMode = 'index' | 'surface'
+export type FastLedProjectionFit = 'contain' | 'fill'
+export type FastLedProjectionAxes = 'xy' | 'xz' | 'yz'
+
+/** Persisted choice. `mode`/`axes` undefined = automatic. */
+export interface FastLedProjectionSettings {
+  mode?: FastLedProjectionMode
+  fit: FastLedProjectionFit
+  flipX: boolean
+  flipY: boolean
+  axes?: FastLedProjectionAxes
+}
+
+export const DEFAULT_FASTLED_PROJECTION: FastLedProjectionSettings = { fit: 'contain', flipX: false, flipY: false }
+
+export const FASTLED_PROJECTION_DIRECTIVE = '@pxlblz-projection'
+const DIRECTIVE_LINE = /^\s*\/\/\s*@pxlblz-projection\b(.*)$/i
+const ANY_DIRECTIVE_LINE = /^\s*\/\/\s*@pxlblz-[a-z]+/i
+const MAX_HEADER_LINES = 20
+
+// ------------------------------------------------------------------ settings text
+
+/** Parses the directive's value text (`surface fit=fill flip=xy axes=xz`). Unknown words are ignored. */
+export function parseFastLedProjection(text: string | null | undefined): FastLedProjectionSettings {
+  const out: FastLedProjectionSettings = { ...DEFAULT_FASTLED_PROJECTION }
+  if (typeof text !== 'string') return out
+  for (const word of text.trim().toLowerCase().split(/\s+/)) {
+    if (word === 'index' || word === 'surface') out.mode = word
+    else if (word === 'auto') out.mode = undefined
+    else if (word === 'fit=contain' || word === 'fit=fill') out.fit = word.slice(4) as FastLedProjectionFit
+    else if (word.startsWith('flip=')) {
+      const v = word.slice(5)
+      out.flipX = v.includes('x')
+      out.flipY = v.includes('y')
+    } else if (word === 'axes=xy' || word === 'axes=xz' || word === 'axes=yz') out.axes = word.slice(5) as FastLedProjectionAxes
+  }
+  return out
+}
+
+/** Canonical value text; '' when everything is automatic/default. */
+export function formatFastLedProjection(s: FastLedProjectionSettings): string {
+  const words: string[] = []
+  if (s.mode) words.push(s.mode)
+  if (s.fit !== 'contain') words.push(`fit=${s.fit}`)
+  if (s.flipX || s.flipY) words.push(`flip=${s.flipX ? 'x' : ''}${s.flipY ? 'y' : ''}`)
+  if (s.axes) words.push(`axes=${s.axes}`)
+  return words.join(' ')
+}
+
+// Leading comment block, as patternLanguage.ts scans it.
+function headerLineCount(lines: readonly string[]): number {
+  let n = 0
+  while (n < lines.length && n < MAX_HEADER_LINES) {
+    const t = lines[n].trim()
+    if (t !== '' && !t.startsWith('//')) break
+    n++
+  }
+  return n
+}
+
+/** The projection directive's value text in the source header, or null when absent. */
+export function fastLedProjectionDirective(src: string): string | null {
+  const lines = src.split('\n')
+  const n = headerLineCount(lines)
+  for (let i = 0; i < n; i++) {
+    const m = DIRECTIVE_LINE.exec(lines[i].replace(/\r$/, ''))
+    if (m) return m[1].trim()
+  }
+  return null
+}
+
+/**
+ * Writes (or removes, for an all-default value) the projection directive in the
+ * header: replaced in place, else inserted after the last `// @pxlblz-…` line.
+ */
+export function withFastLedProjectionDirective(src: string, settings: FastLedProjectionSettings): string {
+  const text = formatFastLedProjection(settings)
+  const lines = src.split('\n')
+  const n = headerLineCount(lines)
+  const existing = lines.slice(0, n).findIndex((l) => DIRECTIVE_LINE.test(l.replace(/\r$/, '')))
+  const line = `// ${FASTLED_PROJECTION_DIRECTIVE} ${text}`
+  if (existing >= 0) {
+    if (text === '') lines.splice(existing, 1)
+    else lines[existing] = line
+    return lines.join('\n')
+  }
+  if (text === '') return src
+  let after = -1
+  for (let i = 0; i < n; i++) if (ANY_DIRECTIVE_LINE.test(lines[i])) after = i
+  lines.splice(after + 1, 0, line)
+  return lines.join('\n')
+}
+
+/**
+ * The compiled-artifact cache key's source: without the projection directive
+ * line, so adding, changing or removing the projection never recompiles (the
+ * module is the same; at most a warning's line differs by one).
+ */
+export function fastLedArtifactSource(src: string): string {
+  if (!src.includes(FASTLED_PROJECTION_DIRECTIVE)) return src
+  const lines = src.split('\n')
+  const n = headerLineCount(lines)
+  return lines.filter((l, i) => i >= n || !DIRECTIVE_LINE.test(l.replace(/\r$/, ''))).join('\n')
+}
+
+/**
+ * The source the compiler sees: the projection directive becomes a bare `//`
+ * (same line count, so diagnostics keep their lines).
+ */
+export function fastLedCompileSource(src: string): string {
+  if (!src.includes(FASTLED_PROJECTION_DIRECTIVE)) return src
+  const lines = src.split('\n')
+  const n = headerLineCount(lines)
+  for (let i = 0; i < n; i++) if (DIRECTIVE_LINE.test(lines[i].replace(/\r$/, ''))) lines[i] = lines[i].endsWith('\r') ? '//\r' : '//'
+  return lines.join('\n')
+}
+
+// ------------------------------------------------------------------ sketch layout
+
+export type FastLedSketchLayoutSource = 'screenmap' | 'catalogue' | 'source' | 'guess'
+
+/** Where each sketch LED sits in sketch space (x,y per LED; NaN = no position). */
+export interface FastLedSketchLayout {
+  ledCount: number
+  /** 2 × ledCount, sketch units (raster cells for XY layouts). */
+  positions: Float64Array
+  /** LED spacing in sketch units (1 for rasters). */
+  pitch: number
+  width: number | null
+  height: number | null
+  serpentine: boolean
+  source: FastLedSketchLayoutSource
+}
+
+/** Row-major (or serpentine: odd rows reversed) raster of width × height. */
+export function rasterSketchLayout(
+  width: number,
+  height: number,
+  ledCount: number,
+  opts: { serpentine?: boolean; source?: FastLedSketchLayoutSource } = {},
+): FastLedSketchLayout {
+  const positions = new Float64Array(ledCount * 2).fill(NaN)
+  const cells = Math.min(ledCount, width * height)
+  for (let i = 0; i < cells; i++) {
+    const y = Math.floor(i / width)
+    const col = i % width
+    positions[i * 2] = opts.serpentine && y % 2 === 1 ? width - 1 - col : col
+    positions[i * 2 + 1] = y
+  }
+  return { ledCount, positions, pitch: 1, width, height, serpentine: Boolean(opts.serpentine), source: opts.source ?? 'catalogue' }
+}
+
+/** The square guess for a 2D sketch with no screen map and no known raster. */
+export function guessedSketchLayout(ledCount: number): FastLedSketchLayout {
+  const side = Math.max(1, Math.ceil(Math.sqrt(ledCount)))
+  return { ...rasterSketchLayout(side, Math.max(1, Math.ceil(ledCount / side)), ledCount), source: 'guess' }
+}
+
+/**
+ * Layout from the sketch's FastLED screen maps (CLEDController::setScreenMap).
+ * They already encode serpentine/XYMap order. Null when none covers any LED.
+ */
+export function screenMapSketchLayout(maps: readonly FastLedScreenMap[], ledCount: number): FastLedSketchLayout | null {
+  const positions = new Float64Array(ledCount * 2).fill(NaN)
+  let placed = 0
+  let width: number | null = null
+  let height: number | null = null
+  let serpentine = false
+  for (const m of maps) {
+    if (!m || !Array.isArray(m.x) || !Array.isArray(m.y)) continue
+    const len = Math.min(m.length ?? m.x.length, m.x.length, m.y.length)
+    for (let k = 0; k < len; k++) {
+      const i = (m.ledOffset ?? 0) + k
+      if (i < 0 || i >= ledCount || !Number.isFinite(m.x[k]) || !Number.isFinite(m.y[k])) continue
+      if (Number.isNaN(positions[i * 2])) placed++
+      positions[i * 2] = m.x[k]
+      positions[i * 2 + 1] = m.y[k]
+    }
+    if (width === null && m.xyWidth && m.xyHeight) {
+      width = m.xyWidth
+      height = m.xyHeight
+      serpentine = m.xyType === 0
+    }
+  }
+  if (placed === 0) return null
+  return { ledCount, positions, pitch: estimatePitch(positions), width, height, serpentine, source: 'screenmap' }
+}
+
+// Median nearest-neighbour distance of (a sample of) the LEDs; 1 for unit rasters.
+function estimatePitch(positions: Float64Array): number {
+  const pts: number[] = []
+  for (let i = 0; i < positions.length; i += 2) if (!Number.isNaN(positions[i])) pts.push(positions[i], positions[i + 1])
+  const n = pts.length / 2
+  if (n < 2) return 1
+  const step = Math.max(1, Math.floor(n / 256))
+  const dists: number[] = []
+  for (let a = 0; a < n; a += step) {
+    let best = Infinity
+    for (let b = 0; b < n; b++) {
+      if (a === b) continue
+      const dx = pts[a * 2] - pts[b * 2]
+      const dy = pts[a * 2 + 1] - pts[b * 2 + 1]
+      const d = dx * dx + dy * dy
+      if (d > 0 && d < best) best = d
+    }
+    if (best < Infinity) dists.push(Math.sqrt(best))
+  }
+  if (dists.length === 0) return 1
+  dists.sort((x, y) => x - y)
+  return dists[Math.floor(dists.length / 2)]
+}
+
+/** The FastLED serpentine idiom in a sketch (`kMatrixSerpentineLayout = true`). */
+export function sourceDeclaresSerpentine(src: string): boolean {
+  return /\b(?:kMatrixSerpentineLayout|SERPENTINE|IS_SERPENTINE|kSerpentine)\s*=\s*true\b/.test(src)
+    || /#\s*define\s+(?:SERPENTINE|IS_SERPENTINE|MATRIX_SERPENTINE)\s+(?:true|1)\b/.test(src)
+}
+
+/**
+ * The sketch layout, best source first: its own screen map, then the catalogue
+ * raster (serpentine when the source declares it), then a square guess.
+ */
+export function resolveFastLedSketchLayout(opts: {
+  ledCount: number
+  screenMaps?: readonly FastLedScreenMap[] | null
+  raster?: { width: number; height: number } | null
+  serpentine?: boolean
+}): FastLedSketchLayout {
+  const fromMap = opts.screenMaps && opts.screenMaps.length > 0 ? screenMapSketchLayout(opts.screenMaps, opts.ledCount) : null
+  if (fromMap) return fromMap
+  const r = opts.raster
+  if (r && r.width > 0 && r.height > 0) {
+    return rasterSketchLayout(r.width, r.height, opts.ledCount, { serpentine: opts.serpentine, source: opts.serpentine ? 'source' : 'catalogue' })
+  }
+  return guessedSketchLayout(opts.ledCount)
+}
+
+/** "64×64 aus Screen-Map" etc. for the deck. */
+export function describeFastLedSketchLayout(layout: FastLedSketchLayout): string {
+  const size = layout.width !== null && layout.height !== null ? `${layout.width}×${layout.height}` : `${layout.ledCount} LEDs`
+  const serp = layout.serpentine ? ' serpentine' : ''
+  switch (layout.source) {
+    case 'screenmap':
+      return `${size}${serp} aus Screen-Map`
+    case 'source':
+      return `${size}${serp} aus Katalog + Quelltext`
+    case 'catalogue':
+      return `${size} aus Katalog (zeilenweise)`
+    case 'guess':
+      return `${size} geschätzt (quadratisch, zeilenweise)`
+  }
+}
+
+// ------------------------------------------------------------------ map side
+
+const AXIS_INDEX: Record<FastLedProjectionAxes, [number, number]> = { xy: [0, 1], xz: [0, 2], yz: [1, 2] }
+
+/** The two axes with the largest extent (ties keep x before y before z). */
+export function largestExtentAxes(points: readonly (readonly number[])[]): FastLedProjectionAxes {
+  const ext = [0, 0, 0]
+  const min = [Infinity, Infinity, Infinity]
+  const max = [-Infinity, -Infinity, -Infinity]
+  for (const p of points) {
+    for (let a = 0; a < 3 && a < p.length; a++) {
+      if (p[a] < min[a]) min[a] = p[a]
+      if (p[a] > max[a]) max[a] = p[a]
+    }
+  }
+  for (let a = 0; a < 3; a++) ext[a] = max[a] >= min[a] ? max[a] - min[a] : 0
+  const smallest = ext[2] <= ext[1] && ext[2] <= ext[0] ? 2 : ext[1] <= ext[0] ? 1 : 0
+  return smallest === 2 ? 'xy' : smallest === 1 ? 'xz' : 'yz'
+}
+
+export interface FastLedProjectionTableOptions {
+  fit: FastLedProjectionFit
+  flipX: boolean
+  flipY: boolean
+  /** Only read for 3D points. */
+  axes: FastLedProjectionAxes
+}
+
+/**
+ * Map index → sketch LED index (−1 = black). Map points are fitted onto the
+ * sketch's bounding box (padded by half an LED): `contain` keeps the map's
+ * aspect (uniform scale, centred, the whole map inside the sketch), `fill`
+ * stretches each axis. Each map point takes the nearest positioned sketch LED
+ * within one LED pitch (ties → lower index); farther points stay black.
+ */
+export function buildFastLedProjectionTable(
+  mapPoints: readonly (readonly number[])[],
+  layout: FastLedSketchLayout,
+  opts: FastLedProjectionTableOptions,
+): Int32Array {
+  const table = new Int32Array(mapPoints.length).fill(-1)
+  const pos = layout.positions
+  // Sketch bounds.
+  let sx0 = Infinity, sy0 = Infinity, sx1 = -Infinity, sy1 = -Infinity
+  for (let i = 0; i < layout.ledCount; i++) {
+    const x = pos[i * 2], y = pos[i * 2 + 1]
+    if (Number.isNaN(x)) continue
+    if (x < sx0) sx0 = x
+    if (x > sx1) sx1 = x
+    if (y < sy0) sy0 = y
+    if (y > sy1) sy1 = y
+  }
+  if (sx0 === Infinity || mapPoints.length === 0) return table
+  const pitch = layout.pitch > 0 ? layout.pitch : 1
+  const half = pitch / 2
+  sx0 -= half; sy0 -= half; sx1 += half; sy1 += half
+  const sw = sx1 - sx0, sh = sy1 - sy0
+
+  // Map 2D coordinates and bounds.
+  const [ax, ay] = AXIS_INDEX[opts.axes]
+  const n = mapPoints.length
+  const mx = new Float64Array(n), my = new Float64Array(n)
+  let mx0 = Infinity, my0 = Infinity, mx1 = -Infinity, my1 = -Infinity
+  for (let i = 0; i < n; i++) {
+    const p = mapPoints[i]
+    const x = p.length >= 3 ? p[ax] : p[0] ?? 0
+    const y = p.length >= 3 ? p[ay] : p.length >= 2 ? p[1] : 0
+    mx[i] = x
+    my[i] = y
+    if (x < mx0) mx0 = x
+    if (x > mx1) mx1 = x
+    if (y < my0) my0 = y
+    if (y > my1) my1 = y
+  }
+  const mw = mx1 - mx0, mh = my1 - my0
+  let scaleX: number, scaleY: number
+  if (opts.fit === 'fill') {
+    scaleX = mw > 0 ? sw / mw : 0
+    scaleY = mh > 0 ? sh / mh : 0
+  } else {
+    const s = Math.min(mw > 0 ? sw / mw : Infinity, mh > 0 ? sh / mh : Infinity)
+    scaleX = scaleY = Number.isFinite(s) ? s : 0
+  }
+  const offX = sx0 + (sw - mw * scaleX) / 2
+  const offY = sy0 + (sh - mh * scaleY) / 2
+
+  // Bucket grid over the sketch LEDs, cell = one pitch.
+  const cols = Math.max(1, Math.ceil(sw / pitch))
+  const rows = Math.max(1, Math.ceil(sh / pitch))
+  const head = new Int32Array(cols * rows).fill(-1)
+  const next = new Int32Array(layout.ledCount).fill(-1)
+  const cellOf = (x: number, y: number) => {
+    const c = Math.min(cols - 1, Math.max(0, Math.floor((x - sx0) / pitch)))
+    const r = Math.min(rows - 1, Math.max(0, Math.floor((y - sy0) / pitch)))
+    return [c, r] as const
+  }
+  // Insert in descending index order so each bucket lists ascending indices.
+  for (let i = layout.ledCount - 1; i >= 0; i--) {
+    const x = pos[i * 2]
+    if (Number.isNaN(x)) continue
+    const [c, r] = cellOf(x, pos[i * 2 + 1])
+    const b = r * cols + c
+    next[i] = head[b]
+    head[b] = i
+  }
+  const maxD2 = pitch * pitch * 1.0000001
+  for (let i = 0; i < n; i++) {
+    let u = mw > 0 ? mx[i] - mx0 : mw / 2
+    let v = mh > 0 ? my[i] - my0 : mh / 2
+    if (opts.flipX) u = mw - u
+    if (opts.flipY) v = mh - v
+    const x = offX + u * scaleX
+    const y = offY + v * scaleY
+    const [c, r] = cellOf(x, y)
+    let best = -1
+    let bestD = Infinity
+    for (let rr = r - 1; rr <= r + 1; rr++) {
+      if (rr < 0 || rr >= rows) continue
+      for (let cc = c - 1; cc <= c + 1; cc++) {
+        if (cc < 0 || cc >= cols) continue
+        for (let j = head[rr * cols + cc]; j !== -1; j = next[j]) {
+          const dx = pos[j * 2] - x
+          const dy = pos[j * 2 + 1] - y
+          const d = dx * dx + dy * dy
+          if (d < bestD || (d === bestD && j < best)) {
+            bestD = d
+            best = j
+          }
+        }
+      }
+    }
+    if (best >= 0 && bestD <= maxD2) table[i] = best
+  }
+  return table
+}
+
+// ------------------------------------------------------------------ mode
+
+/** True when the sketch takes its LED count/raster from the map (template Patterns). */
+export function sourceFollowsMapSize(src: string): boolean {
+  return /\bPXLBLZ_(?:NUM_LEDS|WIDTH|HEIGHT)\b/.test(src.replace(/^\s*\/\/.*$/gm, ''))
+}
+
+/**
+ * Projection before the sketch runs. Automatic: `surface` for a 2D/3D sketch on
+ * a ≥2D map unless the sketch follows the map size or its known LED count
+ * equals the map's pixel count; `index` otherwise. `candidate` marks an
+ * automatic surface whose LED count is not known yet (re-checked after start).
+ */
+export function resolveFastLedProjectionMode(opts: {
+  settings: FastLedProjectionSettings
+  nativeDim: 1 | 2 | 3
+  mapDim: 1 | 2 | 3
+  pixelCount: number
+  followsMapSize: boolean
+  knownLedCount: number | null
+}): { mode: FastLedProjectionMode; automatic: boolean } {
+  if (opts.settings.mode) return { mode: opts.settings.mode, automatic: false }
+  if (opts.nativeDim < 2 || opts.mapDim < 2 || opts.followsMapSize) return { mode: 'index', automatic: true }
+  if (opts.knownLedCount !== null && opts.knownLedCount === opts.pixelCount) return { mode: 'index', automatic: true }
+  return { mode: 'surface', automatic: true }
+}
+
+/** Order-sensitive FNV-1a over numbers, for table cache keys. */
+export function hashNumbers(values: ArrayLike<number>, seed = 0x811c9dc5): number {
+  let h = seed >>> 0
+  const f = new Float64Array(1)
+  const u = new Uint32Array(f.buffer)
+  for (let i = 0; i < values.length; i++) {
+    f[0] = values[i]
+    h = Math.imul(h ^ u[0], 0x01000193)
+    h = Math.imul(h ^ u[1], 0x01000193)
+  }
+  return h >>> 0
+}
+
+const tableCache = new Map<string, Int32Array>()
+const TABLE_CACHE_MAX = 6
+
+/** buildFastLedProjectionTable, memoised per (map points, sketch layout, options). */
+export function cachedFastLedProjectionTable(
+  mapPoints: readonly (readonly number[])[],
+  layout: FastLedSketchLayout,
+  opts: FastLedProjectionTableOptions,
+): Int32Array {
+  let mh = 0x811c9dc5
+  for (const p of mapPoints) mh = hashNumbers(p, mh)
+  const key = [mapPoints.length, mh, layout.ledCount, hashNumbers(layout.positions), layout.pitch, opts.fit, opts.flipX, opts.flipY, opts.axes].join('|')
+  const hit = tableCache.get(key)
+  if (hit) {
+    tableCache.delete(key)
+    tableCache.set(key, hit)
+    return hit
+  }
+  const table = buildFastLedProjectionTable(mapPoints, layout, opts)
+  tableCache.set(key, table)
+  while (tableCache.size > TABLE_CACHE_MAX) tableCache.delete(tableCache.keys().next().value as string)
+  return table
+}

+import { beforeEach, describe, expect, it } from 'vitest'
+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { OutputPanel } from './OutputPanel'
+import { usePreviewStore, previewInitialState } from '@/store/previewStore'
+import { useEditorStore, editorInitialState } from '@/store/editorStore'
+import { usePatternStore, patternInitialState } from '@/store/patternStore'
+import { useMapStore, mapInitialState } from '@/store/mapStore'
+import { useFastLedProjectionStore, type FastLedProjectionStatus } from '@/store/fastledProjectionStore'
+import { usePanelPreferencesStore } from '@/store/panelPreferencesStore'
+
+const FASTLED_SRC = '// @pxlblz-language fastled\n// @pxlblz-dim 2\nvoid setup() {}\nvoid loop() {}\n'
+const status = (mode: 'index' | 'surface'): FastLedProjectionStatus => ({
+  mode, automatic: true, mapDim: 2, axes: null, layoutLabel: null, layoutSource: null, ledCount: 64, pixelCount: 100, litPixels: 100,
+})
+
+beforeEach(() => {
+  usePanelPreferencesStore.setState({ expanded: {} })
+  usePreviewStore.setState(previewInitialState)
+  useEditorStore.setState({ ...editorInitialState, mapDim: 2 })
+  usePatternStore.setState({
+    ...patternInitialState,
+    activePatternId: 'p1',
+    userPatterns: [{ id: 'p1', name: 'P1', src: '', controls: {}, updatedAt: 1 }],
+  })
+  useMapStore.setState(mapInitialState)
+  useFastLedProjectionStore.setState({ status: null })
+})
+
+describe('OutputPanel (Ausgabe)', () => {
+  it('shows the five controls at their neutral values, expanded by default, without badge', () => {
+    render(<OutputPanel mode="pattern" />)
+    expect(screen.getByRole('slider', { name: 'Ausgabe Helligkeit' })).toHaveValue('1')
+    expect(screen.getByRole('slider', { name: 'Ausgabe Speed' })).toHaveValue('1')
+    expect(screen.getByRole('slider', { name: 'Ausgabe Hue' })).toHaveValue('0')
+    expect(screen.getByRole('slider', { name: 'Ausgabe Scale' })).toHaveValue('1')
+    expect(screen.getByRole('slider', { name: 'Ausgabe Rotate' })).toHaveValue('0')
+    expect(screen.queryByTestId('output-modified')).not.toBeInTheDocument()
+    expect(screen.getByTestId('output-reset')).toBeDisabled()
+  })
+
+  it('a change goes live, persists on the Pattern and shows the badge; Zurücksetzen restores neutral', async () => {
+    render(<OutputPanel mode="pattern" />)
+    fireEvent.change(screen.getByRole('slider', { name: 'Ausgabe Helligkeit' }), { target: { value: '0.4' } })
+    fireEvent.change(screen.getByRole('slider', { name: 'Ausgabe Hue' }), { target: { value: '-30' } })
+    expect(usePreviewStore.getState().outputBrightness).toBe(0.4)
+    expect(usePreviewStore.getState().outputHue).toBe(-30)
+    expect(usePatternStore.getState().userPatterns[0].settings).toMatchObject({ outputBrightness: 0.4, outputHue: -30 })
+    expect(screen.getAllByTestId('output-modified').length).toBeGreaterThan(0)
+    expect(screen.getByTestId('output-panel')).toHaveAttribute('data-modified', 'true')
+
+    await act(async () => { fireEvent.click(screen.getByTestId('output-reset')) })
+    await waitFor(() => expect(screen.queryByTestId('output-modified')).not.toBeInTheDocument())
+    expect(usePreviewStore.getState().outputBrightness).toBe(1)
+    expect(usePreviewStore.getState().outputHue).toBe(0)
+    expect(usePatternStore.getState().userPatterns[0].settings).toEqual({})
+  })
+
+  it('Speed is the one time factor (0–4×)', () => {
+    render(<OutputPanel mode="pattern" />)
+    const speed = screen.getByRole('slider', { name: 'Ausgabe Speed' })
+    expect(speed).toHaveAttribute('max', '4')

@@ -0,0 +1,268 @@
+// Pattern output adjustment ("Ausgabe", local fork): five per-Pattern controls
+// that act on what the router (and the preview) receive, for Pixelblaze and
+// FastLED Patterns alike. Engine-pure: no React, no store.
+//
+//   Speed       time factor on the frame delta (renderLoop: Pixelblaze delta and
+//               the FastLED virtual clock alike; it is the deck's one speed).
+//   Scale       zoom about the map centre: the Pattern samples (p - c) / scale.
+//   Rotate      rotation about the map centre in the map plane: the Pattern
+//               samples R(-angle) · (p - c), so the image turns by +angle (from
+//               +x towards +y of the map coordinates). 3D maps: the plane of
+//               the two axes with the largest extent (largestExtentAxes, the
+//               plane a FastLED surface projection uses).
+//   Hue         rotation of the final RGB frame's hue (HSV; keeps value and
+//               saturation).
+//   Helligkeit  scales the final RGB frame.
+//
+// Order: render (Speed/Scale/Rotate at the time/coordinate/projection input) →
+// frame → Hue → Helligkeit → active mask black → renderer + router. At the
+// neutral values nothing is touched, so the frame is byte-identical to a
+// Pattern without output adjustment (FastLED L1/L2 bytes stay FastLED's).
+
+export interface OutputAdjust {
+  /** 0..1, scales the final RGB frame. */
+  brightness: number
+  /** Degrees, −180..180. */
+  hue: number
+  /** Zoom factor, 0.25..4 (2 = the image appears twice as large). */
+  scale: number
+  /** Degrees, −180..180. */
+  rotate: number
+}
+
+export const NEUTRAL_OUTPUT: OutputAdjust = { brightness: 1, hue: 0, scale: 1, rotate: 0 }
+
+export const OUTPUT_LIMITS = {
+  brightness: { min: 0, max: 1 },
+  speed: { min: 0, max: 4 },
+  hue: { min: -180, max: 180 },
+  scale: { min: 0.25, max: 4 },
+  rotate: { min: -180, max: 180 },
+} as const
+
+function clampTo(value: unknown, min: number, max: number, fallback: number): number {
+  if (typeof value !== 'number' || !Number.isFinite(value)) return fallback
+  return Math.min(max, Math.max(min, value))
+}
+
+export function clampOutputBrightness(v: unknown): number {
+  return clampTo(v, OUTPUT_LIMITS.brightness.min, OUTPUT_LIMITS.brightness.max, 1)
+}
+export function clampOutputSpeed(v: unknown): number {
+  return clampTo(v, OUTPUT_LIMITS.speed.min, OUTPUT_LIMITS.speed.max, 1)
+}
+export function clampOutputHue(v: unknown): number {
+  return clampTo(v, OUTPUT_LIMITS.hue.min, OUTPUT_LIMITS.hue.max, 0)
+}
+export function clampOutputScale(v: unknown): number {
+  return clampTo(v, OUTPUT_LIMITS.scale.min, OUTPUT_LIMITS.scale.max, 1)
+}
+export function clampOutputRotate(v: unknown): number {
+  return clampTo(v, OUTPUT_LIMITS.rotate.min, OUTPUT_LIMITS.rotate.max, 0)
+}
+
+export function isNeutralColor(o: Pick<OutputAdjust, 'brightness' | 'hue'>): boolean {
+  return o.brightness === 1 && o.hue === 0
+}
+
+export function isNeutralGeometry(o: Pick<OutputAdjust, 'scale' | 'rotate'>): boolean {
+  return o.scale === 1 && o.rotate === 0
+}
+
+/** Whether any of the five controls (with speed) differs from neutral. */
+export function isOutputModified(o: OutputAdjust & { speed: number }): boolean {
+  return !isNeutralColor(o) || !isNeutralGeometry(o) || o.speed !== 1
+}
+
+// ------------------------------------------------------------------ colour
+
+/**
+ * Rotates the hue of one RGB triple (0..1 floats) by `turn` (fraction of a full
+ * turn) in place. Grey (r = g = b) is unchanged; max and min channel are kept.
+ */
+export function rotateHueInto(frame: Float64Array | number[], o: number, turn: number): void {
+  const r = Math.min(1, Math.max(0, frame[o]))
+  const g = Math.min(1, Math.max(0, frame[o + 1]))
+  const b = Math.min(1, Math.max(0, frame[o + 2]))
+  const max = Math.max(r, g, b)
+  const min = Math.min(r, g, b)
+  const d = max - min
+  if (d <= 0) return
+  let h: number
+  if (max === r) h = ((g - b) / d) / 6
+  else if (max === g) h = ((b - r) / d + 2) / 6
+  else h = ((r - g) / d + 4) / 6
+  h += turn
+  h -= Math.floor(h)
+  const h6 = h * 6
+  const sector = Math.floor(h6) % 6
+  const f = h6 - Math.floor(h6)
+  const rising = min + d * f
+  const falling = max - d * f
+  let nr: number, ng: number, nb: number
+  switch (sector) {
+    case 0: nr = max; ng = rising; nb = min; break
+    case 1: nr = falling; ng = max; nb = min; break
+    case 2: nr = min; ng = max; nb = rising; break
+    case 3: nr = min; ng = falling; nb = max; break
+    case 4: nr = rising; ng = min; nb = max; break
+    default: nr = max; ng = min; nb = falling; break
+  }
+  frame[o] = nr
+  frame[o + 1] = ng
+  frame[o + 2] = nb
+}
+
+/**
+ * Hue then Helligkeit over a packed RGB frame (3 floats per pixel), skipping
+ * masked pixels (they stay black: the active mask is the last step). A no-op
+ * at the neutral values.
+ */
+export function applyOutputColor(
+  frame: Float64Array,
+  pixelCount: number,
+  o: Pick<OutputAdjust, 'brightness' | 'hue'>,
+  activeMask?: ArrayLike<number> | null,
+): void {
+  if (isNeutralColor(o)) return
+  const turn = o.hue / 360
+  const b = o.brightness
+  for (let i = 0; i < pixelCount; i++) {
+    if (activeMask && i < activeMask.length && activeMask[i] === 0) continue
+    const k = i * 3
+    if (turn !== 0) rotateHueInto(frame, k, turn)
+    if (b !== 1) {
+      frame[k] *= b
+      frame[k + 1] *= b
+      frame[k + 2] *= b
+    }
+  }
+}
+
+/** The same for one unpacked pixel (the non-packed paint path). */
+export function adjustOutputPixel(
+  pixel: [number, number, number],
+  o: Pick<OutputAdjust, 'brightness' | 'hue'>,
+): [number, number, number] {
+  if (isNeutralColor(o)) return pixel
+  const out: [number, number, number] = [pixel[0], pixel[1], pixel[2]]
+  if (o.hue !== 0) rotateHueInto(out, 0, o.hue / 360)
+  if (o.brightness !== 1) {
+    out[0] *= o.brightness
+    out[1] *= o.brightness
+    out[2] *= o.brightness
+  }
+  return out
+}
+
+// ------------------------------------------------------------------ geometry
+
+
+export interface MapFrame {
+  /** Map dimension (1..3): the axes that carry coordinates. */
+  dims: number
+  /** Bounding-box centre of the active points. */
+  centre: [number, number, number]
+  /** The rotation plane (axis indices). */
+  plane: [number, number]
+}
+
+/**
+ * Centre and rotation plane of map sample points (masked points ignored).
+ * 2D maps rotate in xy; 3D maps in the plane of their two largest extents.
+ */
+export function mapFrameOf(
+  points: readonly (readonly number[])[],
+  activeMask?: ArrayLike<number> | null,
+): MapFrame {
+  let dims = 0
+  const min = [Infinity, Infinity, Infinity]
+  const max = [-Infinity, -Infinity, -Infinity]
+  for (let i = 0; i < points.length; i++) {
+    const p = points[i]
+    if (p.length > dims) dims = Math.min(3, p.length)
+    if (activeMask && i < activeMask.length && activeMask[i] === 0) continue
+    for (let a = 0; a < 3 && a < p.length; a++) {
+      if (p[a] < min[a]) min[a] = p[a]
+      if (p[a] > max[a]) max[a] = p[a]
+    }
+  }
+  const centre: [number, number, number] = [0.5, 0.5, 0.5]
+  const ext = [0, 0, 0]
+  for (let a = 0; a < 3; a++) {
+    if (max[a] >= min[a]) {
+      centre[a] = (min[a] + max[a]) / 2
+      ext[a] = max[a] - min[a]
+    }
+  }
+  // Drop the axis with the smallest extent (ties drop z before y before x),
+  // exactly like largestExtentAxes in the FastLED projection.
+  let plane: [number, number] = [0, 1]
+  if (dims >= 3) {
+    const smallest = ext[2] <= ext[1] && ext[2] <= ext[0] ? 2 : ext[1] <= ext[0] ? 1 : 0
+    plane = smallest === 2 ? [0, 1] : smallest === 1 ? [0, 2] : [1, 2]
+  }
+  return { dims, centre, plane }
+}
+
+/**
+ * The coordinates a Pattern samples under Scale/Rotate: `base` holds x,y,z per
+ * pixel; only the map's own axes (< frame.dims) move. Returns `base` itself at
+ * the neutral values (no copy, so the neutral path is bit-identical).
+ */
+export function transformMapCoordinates(
+  base: Float64Array,
+  frame: MapFrame,
+  o: Pick<OutputAdjust, 'scale' | 'rotate'>,
+  target?: Float64Array,
+): Float64Array {
+  if (isNeutralGeometry(o) || frame.dims === 0) return base
+  const out = target && target.length === base.length ? target : new Float64Array(base.length)
+  const inv = 1 / o.scale
+  const rotate = frame.dims >= 2 && o.rotate !== 0
+  const rad = (o.rotate * Math.PI) / 180
+  const cos = Math.cos(rad)
+  const sin = Math.sin(rad)
+  const [pa, pb] = frame.plane
+  const c = frame.centre
+  for (let k = 0; k < base.length; k += 3) {
+    for (let a = 0; a < 3; a++) {
+      out[k + a] = a < frame.dims ? c[a] + (base[k + a] - c[a]) * inv : base[k + a]
+    }
+    if (rotate) {
+      const u = out[k + pa] - c[pa]
+      const v = out[k + pb] - c[pb]
+      // R(-angle): the sampled point turns backwards so the image turns forwards.
+      out[k + pa] = c[pa] + cos * u + sin * v
+      out[k + pb] = c[pb] - sin * u + cos * v
+    }
+  }
+  return out
+}
+
+/**
+ * The same map-plane zoom/rotation on 2D offsets from a centre, used by the
+ * FastLED surface projection (map → sketch fit). Returns [u, v] relative to the
+ * same origin as the inputs.
+ */
+export function zoomRotateOffset(
+  u: number,
+  v: number,
+  cu: number,
+  cv: number,
+  scale: number,
+  rotateDeg: number,
+): [number, number] {
+  let du = (u - cu) / scale
+  let dv = (v - cv) / scale
+  if (rotateDeg !== 0) {
+    const rad = (rotateDeg * Math.PI) / 180
+    const cos = Math.cos(rad)
+    const sin = Math.sin(rad)
+    const ru = cos * du + sin * dv
+    const rv = -sin * du + cos * dv
+    du = ru
+    dv = rv
+  }
+  return [cu + du, cv + dv]
+}

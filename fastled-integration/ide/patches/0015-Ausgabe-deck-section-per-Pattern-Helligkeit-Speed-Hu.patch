+// Ausgabe persistence: per-Pattern layer-1 overrides (PatternRecord.settings
+// for a personal Pattern, demoOverrides for a read-only demo/example), seeded
+// before the first router frame, reset to neutral, and held back for a demo
+// until its persisted bag has loaded.
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { usePatternStore, patternInitialState, type PatternRecord } from './patternStore'
+import { usePreviewStore, previewInitialState } from './previewStore'
+import { useMapStore, mapInitialState } from './mapStore'
+import {
+  ensureOutputSettingsSeeded,
+  hasActiveOverrides,
+  liveOutputAdjust,
+  liveOutputModified,
+  outputSettingsReady,
+  resetOutputSettings,
+  seedActiveSettings,
+  writeCascadedOverride,
+} from './settingsCascade'
+import {
+  getPersonalContentProvider,
+  resetPersonalContentProvider,
+  setPersonalContentProvider,
+} from '@/engine/personalContentProvider'
+import type { Settings } from '@/engine/settings'
+import { bundle } from '@/engine/bundle'
+import { loadPattern } from '@/engine/loadPattern'
+import { createRenderLoop } from '@/engine/renderLoop'
+import { createShim } from '@/engine/shim'
+import { createVirtualClock } from '@/engine/virtualClock'
+import { createPlaneMap } from '@/engine/maps'
+import { selectRenderCompatibility } from '@/engine/renderCompatibility'
+import { LIBRARIES } from '@/pixelblaze/libs'
+
+// A tiny durable backend standing in for D1 (patterns) and the settings KV
+// (demoOverrides): what is written survives a fresh store load.
+function installBackend(initial: PatternRecord[] = []) {
+  const rows = new Map(initial.map((r) => [r.id, structuredClone(r)]))
+  let demoBag: Record<string, Partial<Settings>> | undefined
+  setPersonalContentProvider({
+    ...getPersonalContentProvider(),
+    listPatterns: async () => [...rows.values()].map((r) => structuredClone(r)),
+    updatePattern: async (id, changes) => {
+      const row = rows.get(id)
+      if (row) rows.set(id, JSON.parse(JSON.stringify({ ...row, ...changes })))
+    },
+    getDemoOverrides: async () => (demoBag ? structuredClone(demoBag) : undefined),
+    setDemoOverrides: async (next) => { demoBag = JSON.parse(JSON.stringify(next)) },
+  })
+  return { rows }
+}
+
+const record = (settings?: Partial<Settings>): PatternRecord => ({ id: 'p1', name: 'P1', src: '', controls: {}, updatedAt: 1, settings })
+
+beforeEach(() => {
+  usePatternStore.setState(patternInitialState)
+  usePreviewStore.setState(previewInitialState)
+  useMapStore.setState(mapInitialState)
+})
+afterEach(() => resetPersonalContentProvider())
+
+describe('Ausgabe persistence round-trip', () => {
+  it('personal Pattern: values written by the deck survive a reload and seed on open', async () => {
+    const backend = installBackend([record()])
+    await usePatternStore.getState().loadPatterns()
+    usePatternStore.setState({ activePatternId: 'p1' })
+    writeCascadedOverride('outputBrightness', 0.4)
+    writeCascadedOverride('speed', 2.5)
+    writeCascadedOverride('outputHue', -90)
+    writeCascadedOverride('outputScale', 1.5)
+    writeCascadedOverride('outputRotate', 30)
+    await Promise.resolve()
+    expect(backend.rows.get('p1')?.settings).toMatchObject({ outputBrightness: 0.4, speed: 2.5, outputHue: -90, outputScale: 1.5, outputRotate: 30 })
+
+    // "Reload": fresh stores, records from the backend, open the Pattern.
+    usePatternStore.setState(patternInitialState)
+    usePreviewStore.setState(previewInitialState)
+    await usePatternStore.getState().loadPatterns()
+    usePatternStore.setState({ activePatternId: 'p1' })
+    seedActiveSettings()
+    expect(liveOutputAdjust()).toEqual({ brightness: 0.4, hue: -90, scale: 1.5, rotate: 30 })
+    expect(usePreviewStore.getState().speed).toBe(2.5)
+    expect(liveOutputModified()).toBe(true)
+  })
+
+  it('read-only demo: values persist in demoOverrides', async () => {
+    installBackend()
+    usePatternStore.setState({ activeDemoName: 'fastled:Blink' })
+    writeCascadedOverride('outputBrightness', 0.25)
+    await Promise.resolve()
+    usePatternStore.setState(patternInitialState)
+    await usePatternStore.getState().loadDemoOverrides()
+    usePatternStore.setState({ activeDemoName: 'fastled:Blink' })
+    seedActiveSettings()
+    expect(usePreviewStore.getState().outputBrightness).toBe(0.25)
+  })
+})
+
+describe('Ausgabe before the first router frame', () => {
+  it('ensureOutputSettingsSeeded applies the opened Pattern\'s values even before the open-time seed ran', () => {
+    // The previous Pattern (p0) left full brightness live …
+    usePatternStore.setState({ activePatternId: 'p0', userPatterns: [{ ...record(), id: 'p0' }, record({ outputBrightness: 0.5 })] })
+    seedActiveSettings()
+    expect(usePreviewStore.getState().outputBrightness).toBe(1)
+    // … p1 opens; its open-time seed effect has not run yet.
+    usePatternStore.setState({ activePatternId: 'p1' })
+    ensureOutputSettingsSeeded()
+
+    const mapPoints = createPlaneMap({ rows: 2, cols: 2 }).resolve(4)
+    const { code, metadata } = bundle('export function render2D(index, x, y) { rgb(1, 1, 1) }', LIBRARIES)
+    const shim = createShim({ mapPoints, pixelCount: 4, dimensions: 2, getVirtualTime: () => 0 })
+    const sent: number[][] = []
+    const loop = createRenderLoop({
+      handle: loadPattern(code, metadata, shim.builtins), shim, clock: createVirtualClock(), mapPoints, pixelCount: 4,
+      renderCompatibility: selectRenderCompatibility(2, metadata.renderFns),
+      getSpeed: () => usePreviewStore.getState().speed, getBrightness: () => 1, isDimmed: () => false,
+      getOutput: liveOutputAdjust,
+      paint: () => undefined,
+      paintPacked: (frame) => { sent.push(Array.from(frame, (v) => Math.round(v * 255))) },
+    })
+    loop.renderPreviewFrame()
+    expect(sent[0]).toEqual(new Array(12).fill(128))
+  })
+
+  it('does not reseed (and clobber live edits) for the same Pattern', () => {
+    usePatternStore.setState({ activePatternId: 'p1', userPatterns: [record()] })
+    seedActiveSettings()
+    usePreviewStore.getState().setOutputHue(45) // a live drag without a record home
+    ensureOutputSettingsSeeded()
+    expect(usePreviewStore.getState().outputHue).toBe(45)
+  })
+
+  it('holds a demo\'s router frames until demoOverrides loaded', async () => {
+    installBackend()
+    usePatternStore.setState({ activeDemoName: 'Rainbow' })
+    expect(outputSettingsReady()).toBe(false)
+    await usePatternStore.getState().loadDemoOverrides()
+    expect(outputSettingsReady()).toBe(true)
+    usePatternStore.setState({ activeDemoName: null, activePatternId: 'p1', demoOverridesLoaded: false })
+    expect(outputSettingsReady()).toBe(true) // personal Patterns open from loaded records
+  })
+
+  it('clamps a stored Speed above 4× (the old 10× preset)', () => {
+    usePatternStore.setState({ activePatternId: 'p1', userPatterns: [record({ speed: 10 })] })
+    seedActiveSettings()
+    expect(usePreviewStore.getState().speed).toBe(4)
+  })
+})
+
+describe('Ausgabe Zurücksetzen', () => {
+  it('drops only the five Ausgabe fields and goes neutral', async () => {
+    const backend = installBackend([record({ mapId: 'cube', outputBrightness: 0.3, speed: 3, outputHue: 10, outputScale: 2, outputRotate: -45 })])
+    await usePatternStore.getState().loadPatterns()
+    usePatternStore.setState({ activePatternId: 'p1' })
+    seedActiveSettings()
+    expect(liveOutputModified()).toBe(true)
+    await resetOutputSettings()
+    expect(liveOutputModified()).toBe(false)
+    expect(liveOutputAdjust()).toEqual({ brightness: 1, hue: 0, scale: 1, rotate: 0 })
+    expect(usePreviewStore.getState().speed).toBe(1)
+    expect(backend.rows.get('p1')?.settings).toEqual({ mapId: 'cube' })
+    expect(hasActiveOverrides()).toBe(true) // the map override stays
+  })
+
+  it('a demo bag with only Ausgabe fields disappears entirely', async () => {
+    installBackend()
+    usePatternStore.setState({ activeDemoName: 'Rainbow', demoOverrides: { Rainbow: { outputHue: 90 } } })
+    seedActiveSettings()
+    await resetOutputSettings()
+    expect(usePatternStore.getState().demoOverrides).toEqual({})
+    expect(hasActiveOverrides()).toBe(false)
+  })
+})

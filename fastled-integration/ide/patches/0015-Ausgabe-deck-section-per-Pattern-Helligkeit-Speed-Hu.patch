+      renderCompatibility: selectRenderCompatibility(2, metadata.renderFns),
+      activeMask: Uint8Array.from([1, 0, 1, 1]),
+      getSpeed: () => 1, getBrightness: () => 1, isDimmed: () => false,
+      getOutput: () => ({ brightness: 0.8, hue: 90, scale: 1, rotate: 0 }),
+      paint: () => undefined,
+      paintPacked: (f) => { frames.push(Float64Array.from(f)) },
+    })
+    loop.renderPreviewFrame()

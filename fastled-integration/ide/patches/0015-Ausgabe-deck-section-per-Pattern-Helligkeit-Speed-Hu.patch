+    expect(frames[0][0] + frames[0][1] + frames[0][2]).toBeGreaterThan(0)
+  })
+
+  it('the unpacked paint path gets the same adjustment', () => {
+    const { code, metadata } = bundle(`export function render2D(index, x, y) { rgb(1, 0, 0) }`, LIBRARIES)
+    const mapPoints = plane(2)
+    const shim = createShim({ mapPoints, pixelCount: 4, dimensions: 2, getVirtualTime: () => 0 })
+    const painted: [number, number, number][][] = []
+    const loop = createRenderLoop({
+      handle: loadPattern(code, metadata, shim.builtins), shim, clock: createVirtualClock(), mapPoints, pixelCount: 4,
+      renderCompatibility: selectRenderCompatibility(2, metadata.renderFns),
+      getSpeed: () => 1, getBrightness: () => 1, isDimmed: () => false,
+      getOutput: () => ({ brightness: 0.5, hue: 0, scale: 1, rotate: 0 }),
+      paint: (px) => { painted.push(px) },
+    })
+    loop.renderPreviewFrame()
+    expect(painted[0][0]).toEqual([0.5, 0, 0])
+  })
+})
+
+describe('Ausgabe Scale / Rotate move the sampled map coordinates', () => {
+  const coords = (output: OutputAdjust) => {
+    const frame = run(COORDS_2D, 'fast', plane(3), 2, output, 1)[0]
+    return Array.from({ length: 9 }, (_, i) => [frame[i * 3], frame[i * 3 + 1]])
+  }
+
+  it('Scale 2 zooms about the map centre', () => {
+    const got = coords({ ...NEUTRAL_OUTPUT, scale: 2 })
+    expect(got[0]).toEqual([0.25, 0.25])
+    expect(got[4]).toEqual([0.5, 0.5])
+    expect(got[8]).toEqual([0.75, 0.75])
+  })
+
+  it('Rotate 90° turns the sampled points by −90° about the centre', () => {
+    const got = coords({ ...NEUTRAL_OUTPUT, rotate: 90 })
+    // pixel 0 sits at (0,0) and now samples (0,1); pixel 2 at (1,0) samples (0,0).
+    expect(got[0][0]).toBeCloseTo(0, 12)
+    expect(got[0][1]).toBeCloseTo(1, 12)
+    expect(got[2][0]).toBeCloseTo(0, 12)
+    expect(got[2][1]).toBeCloseTo(0, 12)
+  })
+
+  it('1D maps: Scale zooms render(index, x)', () => {
+    const src = `export function render(index, x) { rgb(x, 0, 0) }`
+    const frame = run(src, 'fast', line(5), 1, { ...NEUTRAL_OUTPUT, scale: 2, rotate: 45 }, 1)[0]
+    expect([0, 1, 2, 3, 4].map((i) => frame[i * 3])).toEqual([0.25, 0.375, 0.5, 0.625, 0.75])
+  })
+
+  it('coordinateOutput: false leaves coordinates alone (FastLED handles them in the projection)', () => {
+    const { code, metadata } = bundle(COORDS_2D, LIBRARIES)
+    const mapPoints = plane(3)
+    const shim = createShim({ mapPoints, pixelCount: 9, dimensions: 2, getVirtualTime: () => 0 })
+    const frames: Float64Array[] = []
+    const loop = createRenderLoop({
+      handle: loadPattern(code, metadata, shim.builtins), shim, clock: createVirtualClock(), mapPoints, pixelCount: 9,
+      renderCompatibility: selectRenderCompatibility(2, metadata.renderFns),
+      getSpeed: () => 1, getBrightness: () => 1, isDimmed: () => false,
+      getOutput: () => ({ ...NEUTRAL_OUTPUT, scale: 2 }), coordinateOutput: false,
+      paint: () => undefined, paintPacked: (f) => { frames.push(Float64Array.from(f)) },
+    })
+    loop.renderPreviewFrame()
+    expect([frames[0][0], frames[0][1]]).toEqual([0, 0])
+  })
+})
+
+describe('Speed reaches the FastLED virtual clock', () => {
+  it('the loop hands the FastLED host speed × real dt', () => {
+    const leds = new Uint8Array(3 * 4)
+    const host: FastLedHostLike = {
+      frame: vi.fn(() => ({ status: 0 })),
+      getLeds: () => leds, getWire: () => leds, ledCount: () => 4, getUi: () => [], setUi: () => true,
+      millis: () => 0, showCount: () => 0,
+    }
+    const mapPoints = line(4)
+    const clock = createVirtualClock()
+    const shim = createShim({ mapPoints, pixelCount: 4, dimensions: 1, getVirtualTime: () => clock.getTime() })
+    const { handle, metadata } = createFastLedPatternHandle({ host, rgb: shim.builtins.rgb as (r: number, g: number, b: number) => void, output: 'wire', controls: [] })
+    let speed = 2
+    const loop = createRenderLoop({
+      handle, shim, clock, mapPoints, pixelCount: 4,
+      renderCompatibility: selectRenderCompatibility(1, metadata.renderFns),
+      getSpeed: () => speed, getBrightness: () => 1, isDimmed: () => false,
+      getOutput: () => NEUTRAL_OUTPUT, coordinateOutput: false,
+      paint: () => undefined, paintPacked: () => undefined,
+    })
+    loop.renderPreviewFrame()
+    loop.tickFrame(16)
+    speed = 0.5
+    loop.tickFrame(16)
+    speed = 0
+    loop.tickFrame(16) // paused: no loop() call
+    expect((host.frame as ReturnType<typeof vi.fn>).mock.calls.map((c) => c[0])).toEqual([0, 32, 8])
+    expect(clock.getTime()).toBe(40)
+  })
+})

diff --git a/src/components/OutputPanel.tsx b/src/components/OutputPanel.tsx
new file mode 100644
index 00000000..08fd473a
--- /dev/null
+++ b/src/components/OutputPanel.tsx
@@ -0,0 +1,171 @@
+// Deck section "Ausgabe" (local fork): per-Pattern output adjustment for every
+// Pattern (Pixelblaze and FastLED). Unlike the Preview section these values
+// reach the LED router: Helligkeit/Hue adjust the final frame, Speed the time,
+// Scale/Rotate the map coordinates (Pixelblaze) or the surface projection
+// (FastLED). Persisted per Pattern through the settings cascade
+// (settingsCascade.ts); the engine side is engine/outputAdjust.ts.
+import { DeckGrid, DeckSection, DeckSectionHint } from '@/components/Deck'
+import { DeckSlider } from '@/components/DeckSlider'
+import { usePanelSection } from '@/store/panelPreferencesStore'
+import { usePreviewStore } from '@/store/previewStore'
+import { useEditorStore } from '@/store/editorStore'
+import { useFastLedProjectionStore } from '@/store/fastledProjectionStore'
+import { resetOutputSettings, writeCascadedOverride } from '@/store/settingsCascade'
+import { isFastLedSource } from '@/engine/patternLanguage'
+import { isOutputModified, OUTPUT_LIMITS } from '@/engine/outputAdjust'
+
+const HINT = (
+  <DeckSectionHint
+    heading="Ausgabe (Vorschau und LEDs)"
+    intro="Wirkt auf das Bild, das der Router bekommt, und auf die Vorschau. Wird pro Pattern gespeichert; nie an einen Controller gesendet."
+    items={[
+      ['Helligkeit', 'skaliert das fertige RGB-Bild (der Sonnen-Regler oben ist nur Monitor-Helligkeit)'],
+      ['Speed', 'Zeitfaktor des Patterns (Pixelblaze delta, FastLED-Uhr)'],
+      ['Hue', 'dreht den Farbton des fertigen Bildes'],
+      ['Scale', 'Zoom um die Map-Mitte'],
+      ['Rotate', 'Drehung um die Map-Mitte in der Map-Ebene (3D: Ebene der zwei größten Achsen)'],
+    ]}
+  />
+)
+
+const times = (v: number) => `${v.toFixed(2)}×`
+const degrees = (v: number) => `${Math.round(v)}°`
+
+export function OutputPanel({ mode }: { mode?: string }) {
+  const brightness = usePreviewStore((s) => s.outputBrightness)
+  const speed = usePreviewStore((s) => s.speed)
+  const hue = usePreviewStore((s) => s.outputHue)
+  const scale = usePreviewStore((s) => s.outputScale)
+  const rotate = usePreviewStore((s) => s.outputRotate)
+  const togglePlayback = usePreviewStore((s) => s.toggle)
+  const mapDim = useEditorStore((s) => s.mapDim)
+  const fastLed = useEditorStore((s) => isFastLedSource(s.previewSource))
+  const projectionMode = useFastLedProjectionStore((s) => s.status?.mode ?? null)
+  const [expanded, setExpanded] = usePanelSection(mode ?? 'pattern', 'Ausgabe')
+  const modified = isOutputModified({ brightness, hue, scale, rotate, speed })
+
+  // FastLED index projection: leds[i] → map pixel i has no geometry to zoom.
+  const geometryOff = fastLed && projectionMode !== 'surface'
+  const geometryReason = geometryOff
+    ? 'Bei FastLED-Projektion „Index“ ohne Wirkung (Map-Pixel i = leds[i]). Projektion „Fläche“ wählen.'
+    : undefined
+  const rotateOff = geometryOff || mapDim === 1
+  const rotateReason = geometryReason ?? (mapDim === 1 ? '1D-Map: keine Ebene zum Drehen.' : undefined)
+
+  const badge = modified ? (
+    <span
+      data-testid="output-modified"
+      className="shrink-0 rounded border border-amber-500/40 px-1 text-[10px] leading-4 text-amber-300"
+      title={fastLed ? 'Ausgabe verändert: der Router bekommt nicht mehr die bit-exakten FastLED-Bytes.' : 'Ausgabe verändert: der Router bekommt das angepasste Bild.'}
+    >
+      Ausgabe verändert
+    </span>
+  ) : null
+
+  return (
+    <DeckSection
+      label="Ausgabe"
+      hint={HINT}
+      collapsible
+      summaryRow={Boolean(mode)}
+      expanded={mode ? expanded : undefined}
+      onExpandedChange={mode ? setExpanded : undefined}
+      summary={mode ? (badge ?? <span className="text-zinc-500" data-testid="output-neutral">neutral</span>) : undefined}
+    >
+      <div data-testid="output-panel" data-modified={modified ? 'true' : 'false'}>
+        <DeckGrid className="mb-1">
+          <DeckSlider
+            label="Helligkeit"
+            ariaLabel="Ausgabe Helligkeit"
+            value={brightness}
+            min={OUTPUT_LIMITS.brightness.min}
+            max={OUTPUT_LIMITS.brightness.max}
+            step={0.01}
+            presentation="percentage"
+            onSpace={togglePlayback}
+            onChange={(v) => {
+              usePreviewStore.getState().setOutputBrightness(v)
+              writeCascadedOverride('outputBrightness', v)
+            }}
+          />
+          <DeckSlider
+            label="Speed"
+            ariaLabel="Ausgabe Speed"
+            value={speed}
+            min={OUTPUT_LIMITS.speed.min}
+            max={OUTPUT_LIMITS.speed.max}
+            step={0.05}
+            format={times}
+            onSpace={togglePlayback}
+            onChange={(v) => {
+              usePreviewStore.getState().setSpeed(v)
+              writeCascadedOverride('speed', v)
+            }}
+          />
+          <DeckSlider
+            label="Hue"
+            ariaLabel="Ausgabe Hue"
+            value={hue}
+            min={OUTPUT_LIMITS.hue.min}
+            max={OUTPUT_LIMITS.hue.max}
+            step={1}
+            format={degrees}
+            onSpace={togglePlayback}
+            onChange={(v) => {
+              usePreviewStore.getState().setOutputHue(v)
+              writeCascadedOverride('outputHue', v)
+            }}
+          />
+          <DeckSlider
+            label="Scale"
+            ariaLabel="Ausgabe Scale"
+            value={scale}
+            min={OUTPUT_LIMITS.scale.min}
+            max={OUTPUT_LIMITS.scale.max}
+            step={0.05}
+            format={times}
+            disabled={geometryOff}
+            title={geometryReason}
+            onSpace={togglePlayback}
+            onChange={(v) => {
+              usePreviewStore.getState().setOutputScale(v)
+              writeCascadedOverride('outputScale', v)
+            }}
+          />
+          <DeckSlider
+            label="Rotate"
+            ariaLabel="Ausgabe Rotate"
+            value={rotate}
+            min={OUTPUT_LIMITS.rotate.min}
+            max={OUTPUT_LIMITS.rotate.max}
+            step={1}
+            format={degrees}
+            disabled={rotateOff}
+            title={rotateReason}
+            onSpace={togglePlayback}
+            onChange={(v) => {
+              usePreviewStore.getState().setOutputRotate(v)
+              writeCascadedOverride('outputRotate', v)
+            }}
+          />
+        </DeckGrid>
+        <div className="mb-[5px] flex items-center gap-2">
+          <button
+            type="button"
+            data-testid="output-reset"
+            disabled={!modified}
+            title="Alle Ausgabe-Werte auf neutral (100 %, 1×, 0°, 1×, 0°)"
+            onClick={() => void resetOutputSettings()}
+            className="rounded border border-zinc-700 px-1.5 py-0.5 text-[10px] leading-4 text-zinc-300 hover:border-zinc-500 hover:text-zinc-100 disabled:cursor-default disabled:opacity-40 disabled:hover:border-zinc-700 disabled:hover:text-zinc-300"
+          >
+            Zurücksetzen
+          </button>
+          {badge}
+          {modified && fastLed && (
+            <span className="truncate text-[10px] text-zinc-500" data-testid="output-fastled-note">nicht mehr bit-exakt FastLED</span>
+          )}
+        </div>
+      </div>
+    </DeckSection>
+  )
+}

+// Ausgabe (outputAdjust.ts) through the real render loop: neutral values are
+// bit-identical in Fast and Precise, Hue/Helligkeit reach the packed (router)
+// frame, Scale/Rotate move the coordinates a Pixelblaze Pattern samples, and
+// Speed scales the FastLED frame dt.
+import { describe, expect, it, vi } from 'vitest'
+import { bundle } from '@/engine/bundle'
+import { loadPattern } from '@/engine/loadPattern'
+import { createRenderLoop } from '@/engine/renderLoop'
+import { createFxShim, createShim } from '@/engine/shim'
+import { createVirtualClock } from '@/engine/virtualClock'
+import { createPlaneMap } from '@/engine/maps'
+import { selectRenderCompatibility } from '@/engine/renderCompatibility'
+import type { MapPoint } from '@/engine/maps/types'
+import { LIBRARIES } from '@/pixelblaze/libs'
+import { NEUTRAL_OUTPUT, type OutputAdjust } from './outputAdjust'
+import { createFastLedPatternHandle, type FastLedHostLike } from './fastled/fastledPatternHandle'
+
+const PATTERN_2D = `
+export function beforeRender(delta) { t1 = time(.05) }
+export function render2D(index, x, y) { hsv(x * .7 + y * .3 + t1, 1, .5 + x / 2) }
+`
+const PATTERN_1D = `
+export function beforeRender(delta) { t1 = time(.03) }
+export function render(index, x) { hsv(x + t1, 1 - x / 3, 1) }
+`
+const COORDS_2D = `export function render2D(index, x, y) { rgb(x, y, 0) }`
+
+type Mode = 'fast' | 'fidelity'
+
+function run(src: string, mode: Mode, mapPoints: MapPoint[], dims: 1 | 2 | 3, output?: OutputAdjust, frames = 6) {
+  const { code, fxCode, metadata } = bundle(src, LIBRARIES)
+  const clock = createVirtualClock()
+  const config = { mapPoints, pixelCount: mapPoints.length, dimensions: dims, getVirtualTime: () => clock.getTime(), randomSeed: 1 }
+  const shim = mode === 'fast' ? createShim(config) : createFxShim(config)
+  const handle = loadPattern(mode === 'fast' ? code : fxCode, metadata, shim.builtins)
+  const out: Float64Array[] = []
+  const loop = createRenderLoop({
+    handle, shim, clock, mapPoints, pixelCount: mapPoints.length,
+    renderCompatibility: selectRenderCompatibility(dims, metadata.renderFns),
+    getSpeed: () => 1, getBrightness: () => 1, isDimmed: () => false,
+    getOutput: output ? () => output : undefined,
+    paint: () => { throw new Error('packed path expected') },
+    paintPacked: (frame) => { out.push(Float64Array.from(frame)) },
+  })
+  loop.renderPreviewFrame()
+  for (let f = 1; f < frames; f++) loop.tickFrame(33)
+  return out
+}
+
+function sameBits(a: Float64Array[], b: Float64Array[]): boolean {
+  if (a.length !== b.length) return false
+  for (let f = 0; f < a.length; f++) {
+    if (a[f].length !== b[f].length) return false
+    for (let k = 0; k < a[f].length; k++) if (!Object.is(a[f][k], b[f][k])) return false
+  }
+  return true
+}
+
+const plane = (n: number) => createPlaneMap({ rows: n, cols: n }).resolve(n * n)
+const line = (n: number): MapPoint[] => Array.from({ length: n }, (_, i) => ({ sample: [i / (n - 1)] }))
+
+describe('Ausgabe neutral = identity', () => {
+  for (const mode of ['fast', 'fidelity'] as const) {
+    it(`2D ${mode === 'fast' ? 'Fast' : 'Precise'}: neutral Ausgabe frames are bit-identical to no Ausgabe`, () => {
+      const plain = run(PATTERN_2D, mode, plane(8), 2)
+      const neutral = run(PATTERN_2D, mode, plane(8), 2, { ...NEUTRAL_OUTPUT })
+      expect(plain.some((f) => f.some((v) => v > 0))).toBe(true)
+      expect(sameBits(plain, neutral)).toBe(true)
+    })
+    it(`1D ${mode === 'fast' ? 'Fast' : 'Precise'}: neutral Ausgabe frames are bit-identical to no Ausgabe`, () => {
+      expect(sameBits(run(PATTERN_1D, mode, line(40), 1), run(PATTERN_1D, mode, line(40), 1, { ...NEUTRAL_OUTPUT }))).toBe(true)
+    })
+  }
+})
+
+describe('Ausgabe colour reaches the router frame', () => {
+  it('Helligkeit 50 % halves the packed frame; Hue 120° turns red into green', () => {
+    const red = `export function render2D(index, x, y) { rgb(1, 0, 0) }`
+    const half = run(red, 'fast', plane(2), 2, { ...NEUTRAL_OUTPUT, brightness: 0.5 }, 1)[0]
+    expect(Array.from(half)).toEqual([0.5, 0, 0, 0.5, 0, 0, 0.5, 0, 0, 0.5, 0, 0])
+    const green = run(red, 'fast', plane(2), 2, { ...NEUTRAL_OUTPUT, hue: 120 }, 1)[0]
+    expect(Array.from(green, (v) => Math.round(v * 255))).toEqual([0, 255, 0, 0, 255, 0, 0, 255, 0, 0, 255, 0])
+  })
+
+  it('masked pixels stay black after Hue and Helligkeit (mask is last)', () => {
+    const { code, metadata } = bundle(`export function render2D(index, x, y) { rgb(1, .5, 0) }`, LIBRARIES)
+    const mapPoints = plane(2)
+    const clock = createVirtualClock()
+    const shim = createShim({ mapPoints, pixelCount: 4, dimensions: 2, getVirtualTime: () => 0 })
+    const frames: Float64Array[] = []
+    const loop = createRenderLoop({

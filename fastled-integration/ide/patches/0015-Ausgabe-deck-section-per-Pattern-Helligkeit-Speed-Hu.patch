+}
+
+describe('Ausgabe colour (Hue → Helligkeit)', () => {
+  it('leaves the frame untouched at the neutral values (same bits)', () => {
+    const frame = Float64Array.from([0.1, 0.2, 0.30000000000000004, 1, 0, 0.5])
+    const before = Float64Array.from(frame)
+    applyOutputColor(frame, 2, NEUTRAL_OUTPUT)
+    expect(Array.from(frame)).toEqual(Array.from(before))
+    const px: [number, number, number] = [0.25, 0.5, 0.75]
+    expect(adjustOutputPixel(px, NEUTRAL_OUTPUT)).toBe(px)
+  })
+
+  it('scales every channel by Helligkeit', () => {
+    const frame = Float64Array.from([1, 0.5, 0.2])
+    applyOutputColor(frame, 1, { brightness: 0.5, hue: 0 })
+    close(frame, [0.5, 0.25, 0.1])
+    expect(Array.from(frame, (v) => Math.round(v * 255))).toEqual([128, 64, 26])
+  })
+
+  it('rotates the hue: red +120° is green, +240° is blue, −120° is blue', () => {
+    const red = () => Float64Array.from([1, 0, 0])
+    const a = red(); rotateHueInto(a, 0, 120 / 360); close(a, [0, 1, 0])
+    const b = red(); rotateHueInto(b, 0, 240 / 360); close(b, [0, 0, 1])
+    const c = red(); rotateHueInto(c, 0, -120 / 360); close(c, [0, 0, 1])
+    const d = Float64Array.from([1, 0.5, 0]) // orange, 30°
+    rotateHueInto(d, 0, 180 / 360) // → azure, 210°
+    close(d, [0, 0.5, 1])
+  })
+
+  it('keeps grey and keeps value/saturation (max and min channel)', () => {
+    const grey = Float64Array.from([0.4, 0.4, 0.4])

+import { describe, expect, it } from 'vitest'
+import { fastLedShowMemberError } from './showFastLedGuard'
+import { compileShowForPreview } from './showPreviewArtifact'
+import { createDefaultShow, updateShowCellPattern } from './showModel'
+import type { PatternRecord } from './personalContentRecords'
+
+const FASTLED: PatternRecord = {
+  id: 'fl-1',
+  name: 'Rainbow FastLED',
+  src: '// @pxlblz-language fastled\n#include <FastLED.h>\nvoid loop() {}\n',
+  controls: {},
+  updatedAt: 1,
+}
+
+describe('Show FastLED guard', () => {
+  it('names the FastLED member and accepts Pixelblaze-only sources', () => {
+    expect(fastLedShowMemberError(['export function render(i) {}'], [FASTLED])).toBeNull()
+    expect(fastLedShowMemberError([FASTLED.src], [FASTLED])).toContain('"Rainbow FastLED" is a FastLED Pattern')
+  })
+
+  it('refuses to compile a Show that references a FastLED Pattern', () => {
+    const show = createDefaultShow('show-fastled', 'With FastLED', 1)
+    const cell = show.cells[0]
+    const withFastLed = updateShowCellPattern(show, cell.id, { pattern: { kind: 'user', id: FASTLED.id }, patternName: FASTLED.name })
+    const compiled = compileShowForPreview(withFastLed, [FASTLED], undefined, {})
+    expect(compiled.artifact).toBeNull()
+    expect(compiled.error).toContain('Shows can only contain Pixelblaze Patterns')
+  })
+})
diff --git a/src/engine/showFastLedGuard.ts b/src/engine/showFastLedGuard.ts
new file mode 100644
index 00000000..a9bd27c6
--- /dev/null
+++ b/src/engine/showFastLedGuard.ts
@@ -0,0 +1,12 @@
+// A Show compiles into one portable Pixelblaze Pattern, so a FastLED Pattern
+// (C++) can never be one of its members. Every Show compile path refuses it with
+// this explicit message instead of failing inside the Pixelblaze parser.
+import type { PatternRecord } from './personalContentRecords'
+import { isFastLedSource } from './patternLanguage'
+
+export function fastLedShowMemberError(sources: readonly string[], userPatterns: readonly PatternRecord[]): string | null {
+  const source = sources.find((candidate) => isFastLedSource(candidate))
+  if (source === undefined) return null
+  const name = userPatterns.find((pattern) => pattern.src === source)?.name ?? 'A Pattern'
+  return `"${name}" is a FastLED Pattern; Shows can only contain Pixelblaze Patterns. FastLED Patterns run in the Patterns preview (a Playlist will sequence them later).`
+}
